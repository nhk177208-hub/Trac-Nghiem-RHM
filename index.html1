<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <!-- Chống cache: yêu cầu trình duyệt/CDN không lưu cache trang này -->
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <meta http-equiv="Pragma" content="no-cache">
    <meta http-equiv="Expires" content="0">
    <script>
        (function () {
            var url = new URL(window.location.href);
            if (!url.searchParams.has('_cb')) {
                url.searchParams.set('_cb', Date.now().toString());
                window.location.replace(url.toString());
            }
        })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trắc Nghiệm RHM</title>
    <meta property="og:title" content="Trắc Nghiệm RHM">
    <meta property="og:description" content="Ôn tập, soạn đề và thi thử trắc nghiệm dễ dàng.">
    <meta property="og:type" content="website">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="Trắc Nghiệm RHM">
    <meta name="twitter:description" content="Ôn tập, soạn đề và thi thử trắc nghiệm dễ dàng.">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.4.21/mammoth.browser.min.js"></script>
    <style>
        html { font-size: 100%; scroll-behavior: smooth; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
        @media (min-width: 768px) { html { font-size: 75%; } }
        .option-btn { transition: all 0.2s ease-in-out; }
        .option-btn:hover:not(:disabled) { transform: scale(1.01); }
        .correct { background-color: #22c55e !important; color: white !important; border-color: #22c55e !important; }
        .incorrect { background-color: #ef4444 !important; color: white !important; border-color: #ef4444 !important; }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        .eq-btn { height: 44px !important; min-height: 44px !important; max-height: 44px !important; box-sizing: border-box !important; }
        #edit-screen, #result-screen { zoom: 1.2; }
        body.dev-mode-off .dev-only { display: none !important; }
        @media (min-width: 1024px) {
            .quiz-fit-panel { height: var(--quiz-panel-h, calc(100vh - 175px)) !important; }
            #quiz-screen { margin-bottom: 0 !important; padding-bottom: 0.9rem !important; }
        }
        @media (max-width: 1023px) {
            #question-panel-wrapper { height: auto !important; min-height: fit-content !important; max-height: none !important; }
            #answers-panel-wrapper { height: auto !important; }
        }
        .input-empty-warning {
            border-color: #ef4444 !important;
            box-shadow: 0 0 0 2px rgba(239, 68, 68, 0.25) !important;
        }
        @keyframes emptyJumpPulse {
            0%, 100% { outline: 3px solid rgba(245, 158, 11, 0); outline-offset: 2px; }
            50% { outline: 3px solid rgba(245, 158, 11, 0.95); outline-offset: 4px; }
        }
        .empty-jump-pulse { animation: emptyJumpPulse 0.7s ease-in-out 3; }
    </style>
</head>
<body class="bg-gray-100 min-h-screen font-sans text-gray-800" onload="initApp()">

    <div id="custom-toast" class="fixed bottom-5 right-5 bg-gray-900 text-white px-4 py-3 rounded-xl shadow-2xl z-50 transition-all transform translate-y-20 opacity-0 text-sm font-semibold pointer-events-none"></div>

    <!-- LIGHTBOX XEM & VẼ TRÊN ẢNH -->
    <div id="image-lightbox-modal" class="fixed inset-0 bg-black bg-opacity-90 hidden flex flex-col items-center justify-center p-4 z-50" onmouseup="stopLightboxPan(); stopDrawing(event)">
        <div class="fixed top-4 right-4 sm:right-8 flex items-center space-x-3 z-50" onclick="event.stopPropagation()">
            <div class="flex items-center space-x-1.5 bg-gray-800 bg-opacity-90 rounded-xl px-3 py-1.5 text-white text-xs font-semibold shadow-lg border border-gray-700">
                <button onclick="zoomOutImage(event)" class="px-2.5 py-1.5 hover:bg-gray-700 rounded-lg transition-colors text-sm" title="Zoom Out">➖</button>
                <span id="zoom-level-text" class="w-12 text-center font-bold inline-block select-none">100%</span>
                <button onclick="zoomInImage(event)" class="px-2.5 py-1.5 hover:bg-gray-700 rounded-lg transition-colors text-sm" title="Zoom In">➕</button>
                <button onclick="resetZoomImage(event)" class="px-2.5 py-1.5 hover:bg-gray-700 rounded-lg transition-colors text-xs ml-1 border-l border-gray-600">Reset</button>
                <button id="draw-mode-btn" onclick="toggleDrawMode(event)" class="w-24 py-1.5 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors text-xs font-bold flex items-center justify-center shadow">✏️ Vẽ</button>
                <button onclick="clearDrawings(event)" class="w-24 py-1.5 bg-rose-600 hover:bg-rose-700 rounded-lg transition-colors text-xs font-bold flex items-center justify-center shadow" title="Xóa nét vẽ">🗑️ Xóa vẽ</button>
            </div>
            <button onclick="closeLightbox()" class="text-white font-bold text-sm hover:text-gray-300 bg-gray-800 bg-opacity-90 px-4 py-2 rounded-xl shadow-lg border border-gray-700 flex items-center">✕ Đóng</button>
        </div>
        
        <div id="lightbox-scroll-container" class="w-full h-full max-w-full max-h-[85vh] overflow-auto flex items-center justify-center p-4 mt-12 relative cursor-grab active:cursor-grabbing select-none" onmousedown="startLightboxPan(event)" onmousemove="panLightbox(event)" onmouseleave="stopLightboxPan()">
            <div class="relative inline-block origin-center my-auto mx-auto" id="lightbox-img-wrapper">
                <img id="lightbox-img" src="" class="block pointer-events-none shadow-2xl rounded-lg">
                <canvas id="lightbox-canvas" class="absolute inset-0 z-20 pointer-events-none" onmousedown="startDrawing(event)" onmousemove="drawOnCanvas(event)" onmouseup="stopDrawing(event)"></canvas>
            </div>
        </div>
    </div>

    <div class="w-full max-w-[99%] mx-auto pt-3 md:pt-2 px-2 sm:px-3 pb-16 md:pb-2">
        
        <!-- HOME SCREEN -->
        <div id="home-screen" class="bg-white rounded-2xl shadow-md p-6 sm:p-8 mb-8 md:mb-2">
            <h1 class="text-3xl font-bold text-center text-blue-600 mb-4">📝 Ứng Dụng Trắc Nghiệm RHM</h1>
            
            <div class="mb-6 w-full">
                <div id="app-cover-container" class="w-full aspect-[1600/550] rounded-2xl overflow-hidden shadow-md relative bg-gray-50 flex items-center justify-center">
                    <img id="app-cover-img" src="" onclick="handleCoverImageClick()" class="w-full h-full object-contain cursor-pointer select-none">
                </div>
            </div>

            <div class="flex items-stretch gap-3 mb-6">
                <button onclick="openMockExamModal()" class="flex-1 bg-gradient-to-r from-yellow-400 to-amber-500 hover:from-yellow-500 hover:to-amber-600 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-sm text-base flex items-center justify-center">
                    ⚡ Ôn Tập Nhanh
                </button>
                <button onclick="openDeepModal()" class="flex-1 bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-600 hover:to-emerald-700 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-sm text-base flex items-center justify-center">
                    🧠 Ôn Tập Chuyên Sâu
                </button>
                <button onclick="openExamModal()" class="flex-1 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-sm text-base flex items-center justify-center">
                    🎯 Thi Thử (Mock Exam)
                </button>
            </div>

            <div class="mb-8">
                <div class="flex justify-between items-center mb-4 flex-wrap gap-3">
                    <h2 class="text-xl font-bold text-gray-800 flex items-center">
                        <span class="mr-2">📂</span> Chủ đề ôn tập
                    </h2>
                    <div class="flex items-center space-x-2 flex-wrap gap-y-2">
                        <button onclick="openSuggestQuestionModal()" class="text-sm bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold py-1.5 px-3 rounded-xl border border-blue-300 transition-colors flex items-center shadow-sm">
                            💡 Đề xuất câu hỏi
                        </button>
                        <button onclick="openBookmarkedModal()" class="text-sm bg-amber-50 hover:bg-amber-100 text-amber-700 font-semibold py-1.5 px-3 rounded-xl border border-amber-300 transition-colors flex items-center">
                            ⭐ Đã lưu (<span id="total-bookmarked-count">0</span>)
                        </button>
                        <button onclick="openBlockedModal()" class="text-sm bg-rose-50 hover:bg-rose-100 text-rose-700 font-semibold py-1.5 px-3 rounded-xl border border-rose-300 transition-colors flex items-center">
                            🚫 Đã chặn (<span id="total-blocked-count">0</span>)
                        </button>
                        <button onclick="openAppFeedbackModal()" class="text-sm bg-teal-50 hover:bg-teal-100 text-teal-800 font-semibold py-1.5 px-3 rounded-xl border border-teal-300 transition-colors flex items-center shadow-sm">
                            📩 Góp ý / Liên hệ
                        </button>
                        <button onclick="openStorageModal()" class="dev-only text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-1.5 px-3 rounded-xl border border-gray-300 transition-colors flex items-center">
                            💾 Quản lý JSON
                        </button>
                    </div>
                </div>

                <div id="topic-grid" class="grid grid-cols-6 gap-1.5 sm:gap-3"></div>
                <div id="topic-uncat" class="hidden mt-4"></div>
            </div>

            <div class="dev-only">
                <hr class="my-6 border-gray-200">
                <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center">
                    <span class="mr-2">➕</span> Thêm bộ đề mới từ File Word hoặc Văn bản
                </h2>
                <div class="mb-5 bg-blue-50 p-4 rounded-xl border border-blue-200">
                    <h3 class="font-bold text-blue-800 mb-1.5 text-sm">Quy tắc soạn đề:</h3>
                    <p class="text-sm text-gray-600">Câu hỏi bắt đầu bằng "Câu [số]:", các đáp án A, B, C, D, đáp án đúng ghi "Đáp án: [A/B/C/D]" và giải thích ghi "Giải thích: [...]". Hỗ trợ dấu chấm hỏi (?) hoặc dấu hai chấm (:).</p>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                    <div>
                        <label class="block text-gray-700 font-bold mb-1.5 text-sm">Tên bộ đề</label>
                        <input type="text" id="quiz-name" class="w-full p-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="VD: Đề thi Nha Khoa Lâm Sàng...">
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-1.5 text-sm">Phân chủ đề (VD: Chủ đề 1 hoặc Thi Thử)</label>
                        <input type="text" id="quiz-folder" list="folder-suggestions" class="w-full p-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="VD: Chủ đề 1 hoặc Thi Thử">
                        <datalist id="folder-suggestions"></datalist>
                    </div>
                </div>
                <div class="mb-5">
                    <label class="block text-gray-700 font-bold mb-1.5 text-sm">1. Tải lên file Word (.docx), Text (.txt) hoặc Markdown (.md)</label>
                    <input type="file" id="file-input" accept=".docx, .txt, .md, .markdown" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 mb-3"/>
                    <div class="flex items-center justify-center my-2 text-sm text-gray-400 font-medium">HOẶC DÁN VĂN BẢN TRỰC TIẾP (NHẤN CTRL+V)</div>
                    <textarea id="manual-input" rows="5" class="w-full p-3.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none" placeholder="Nhấn Ctrl+V để dán nội dung câu hỏi vào đây..."></textarea>
                </div>
                <button onclick="processAndStart()" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3.5 px-4 rounded-xl transition-colors text-base shadow-sm">
                    🚀 Lưu Đề & Gắn Ảnh/Giải Thích
                </button>
                <p id="error-msg" class="text-red-500 text-center mt-2.5 hidden font-medium text-sm"></p>
            </div>
        </div>

        <!-- EDIT SCREEN -->
        <div id="edit-screen" class="bg-white rounded-2xl shadow-md p-6 sm:p-8 hidden mb-8 md:mb-2 relative">
            <div class="flex justify-between items-center mb-5 pb-3 border-b flex-wrap gap-3">
                <div class="flex items-center space-x-3 flex-1 min-w-[320px]">
                    <span class="text-sm font-bold text-gray-700 uppercase whitespace-nowrap">Tên bộ đề:</span>
                    <input type="text" id="edit-quiz-name-input" oninput="updateCurrentEditName(this.value)" class="flex-1 p-2.5 border-2 border-indigo-400 rounded-xl text-base font-bold text-blue-700 focus:ring-2 focus:ring-blue-500 outline-none bg-indigo-50/40" placeholder="Tên bộ đề...">
                </div>
                <div class="flex space-x-2 flex-wrap gap-y-2 items-center">
                    <select id="edit-sort-select" onchange="renderEditQuestions()" class="text-sm bg-gray-50 hover:bg-gray-100 text-gray-700 font-semibold py-2 px-3 rounded-xl border border-gray-300 outline-none cursor-pointer shadow-sm">
                        <option value="original">📌 Thứ tự gốc</option>
                        <option value="newest">🕒 Mới nhất</option>
                        <option value="oldest">⏳ Cũ nhất</option>
                        <option value="name_az">🔤 Tên (A-Z)</option>
                        <option value="name_za">🔤 Tên (Z-A)</option>
                    </select>

                    <select id="edit-filter-select" onchange="renderEditQuestions()" class="text-sm bg-gray-50 hover:bg-gray-100 text-gray-700 font-semibold py-2 px-3 rounded-xl border border-gray-300 outline-none cursor-pointer shadow-sm">
                        <option value="all">🔍 Tất cả câu hỏi</option>
                        <option value="starred">⭐ Đánh dấu sao</option>
                        <option value="hidden">👁️‍🗨️ Câu hỏi bị ẩn</option>
                        <option value="visible">👁️ Câu hỏi không ẩn</option>
                    </select>

                    <select id="edit-layout-select" onchange="renderEditQuestions()" class="text-sm bg-gray-50 hover:bg-gray-100 text-gray-700 font-semibold py-2 px-3 rounded-xl border border-gray-300 outline-none cursor-pointer shadow-sm">
                        <option value="list">📜 Dạng danh sách</option>
                        <option value="grid-3">🔲 Dạng lưới 3 cột</option>
                    </select>

                    <button id="cancel-import-btn" onclick="cancelImportAndBack()" class="hidden bg-rose-600 hover:bg-rose-700 text-white font-bold py-2.5 px-4 rounded-xl text-sm shadow-sm transition-colors whitespace-nowrap">↩️ Huỷ nhập</button>
                    <input type="file" id="edit-import-file" accept=".docx, .txt, .md, .markdown" multiple class="hidden" onchange="importFileIntoEdit(event)">
                    <button onclick="triggerEditImportFile()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2.5 px-4 rounded-xl text-sm shadow-sm transition-colors flex items-center whitespace-nowrap" title="Nhập câu hỏi từ file .docx / .txt / .md vào bộ đề này">
                        📥 Nhập File
                    </button>
                    <button onclick="openAddQuestionModal(null)" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-4 rounded-xl text-sm shadow-sm transition-colors flex items-center whitespace-nowrap">
                        ➕ Thêm Câu Hỏi
                    </button>
                    <button onclick="exportQuizToJson(editingQuizId)" class="bg-amber-600 hover:bg-amber-700 text-white font-bold py-2.5 px-4 rounded-xl text-sm shadow-sm transition-colors whitespace-nowrap flex items-center" title="Xuất JSON của bộ đề đang chỉnh sửa">
                        📤 Xuất JSON
                    </button>
                    <button onclick="closeEditScreen()" class="bg-green-600 hover:bg-green-700 text-white font-bold py-2.5 px-5 rounded-xl text-sm shadow-sm transition-colors whitespace-nowrap">
                        💾 Hoàn tất & Về trang chủ
                    </button>
                </div>
            </div>

            <div class="mb-5 bg-gray-50 p-3.5 rounded-xl border border-gray-200">
                <label class="block text-xs font-bold text-gray-600 uppercase mb-1.5">📁 Phân chủ đề:</label>
                <div class="flex flex-col sm:flex-row gap-2.5">
                    <select id="edit-quiz-topic-select" onchange="onEditTopicSelectChange(this.value)" class="p-2.5 border-2 border-indigo-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white font-bold text-indigo-900 cursor-pointer max-w-full sm:max-w-xs"></select>
                    <input type="text" id="edit-quiz-folder-input" list="folder-suggestions" oninput="updateCurrentEditFolder(this.value)" onchange="updateCurrentEditFolder(this.value)" class="flex-1 p-2.5 border border-gray-300 rounded-xl text-xs sm:text-sm focus:ring-2 focus:ring-blue-500 outline-none bg-white font-medium" placeholder="Tên chủ đề hoặc phân nhánh (VD: Chủ đề 1, Thi Thử)...">
                </div>
            </div>

            <p class="text-xs text-gray-500 mb-5">Bạn có thể sửa văn bản câu hỏi, đáp án, đánh dấu sao, ẩn/hiện câu hỏi, gắn tối đa <b>5 ảnh minh họa câu hỏi</b> & <b>5 ảnh giải thích</b>, viết giải thích kèm <b>Hyperlink (URL)</b>!</p>
            <div id="edit-questions-container"></div>

            <button id="return-to-quiz-btn" onclick="returnToQuizFromEdit()" title="Quay lại tiếp tục làm bài" class="hidden fixed bottom-40 right-8 z-40 bg-emerald-600 hover:bg-emerald-700 text-white p-3.5 rounded-full shadow-2xl transition-all items-center justify-center text-lg border-2 border-white hover:scale-110">
                ⬅️
            </button>
            <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" title="Về đầu trang" class="fixed bottom-24 right-8 z-40 bg-indigo-600 hover:bg-indigo-700 text-white p-3.5 rounded-full shadow-2xl transition-all flex items-center justify-center text-lg border-2 border-white hover:scale-110">
                ⬆️
            </button>
            <button id="jump-empty-btn" onclick="jumpToNextEmptyQuestion()" title="Xuống câu bị bỏ trống tiếp theo" class="fixed bottom-8 right-8 z-40 bg-amber-500 hover:bg-amber-600 text-white p-3.5 rounded-full shadow-2xl transition-all flex items-center justify-center text-lg border-2 border-white hover:scale-110">
                ⬇️
            </button>
        </div>

        <!-- QUIZ SCREEN -->
        <div id="quiz-screen" class="bg-white rounded-2xl shadow-md p-6 sm:p-8 hidden mb-8 md:mb-2">
            <div class="flex justify-between items-center mb-3 pb-2 border-b flex-wrap gap-2">
                <div class="flex items-center space-x-2">
                    <button onclick="confirmBackToHome()" class="text-gray-600 hover:text-blue-600 font-bold flex items-center bg-gray-100 hover:bg-blue-50 py-1.5 px-3 rounded-xl transition-colors text-sm border border-gray-300">
                        ⬅️ Quay lại
                    </button>
                    <button onclick="restartCurrentQuiz()" class="text-orange-600 hover:text-orange-800 font-bold flex items-center bg-orange-50 hover:bg-orange-100 py-1.5 px-3 rounded-xl transition-colors text-sm border border-orange-200" title="Làm lại từ đầu">
                        🔄 Làm lại
                    </button>
                    <button onclick="editCurrentQuiz()" class="dev-only text-purple-600 hover:text-purple-800 font-bold flex items-center bg-purple-50 hover:bg-purple-100 py-1.5 px-3 rounded-xl transition-colors text-sm border border-purple-200">
                        ✏️ Edit đề
                    </button>
                </div>
                <h2 id="current-quiz-title" class="text-base font-bold text-blue-600 uppercase flex-1 text-right ml-4 leading-snug break-words"></h2>
            </div>

            <div class="flex justify-between items-center mb-3 flex-wrap gap-3">
                <div class="flex items-center space-x-2.5 flex-wrap gap-y-2">
                    <div class="text-gray-600 font-bold bg-gray-100 py-1.5 px-3 rounded-full text-sm border border-gray-300">
                        Câu <span id="current-q-num">1</span> / <span id="total-q-num">10</span>
                    </div>
                    <button onclick="highlightSelectedText()" class="text-yellow-800 bg-yellow-50 hover:bg-yellow-100 py-1.5 px-3 rounded-full font-bold text-sm transition-colors border border-yellow-300 flex items-center shadow-sm" title="Highlight vùng văn bản đang bôi đen">
                        🖍️ Highlight
                    </button>
                    <button onclick="clearHighlightCurrent()" class="text-gray-700 bg-gray-50 hover:bg-gray-100 py-1.5 px-3 rounded-full font-bold text-sm transition-colors border border-gray-300 flex items-center shadow-sm" title="Xóa highlight câu này">
                        🧹 Xóa Highlight
                    </button>
                </div>
                
                <div class="flex items-center space-x-2 flex-wrap gap-y-2">
                    <button id="report-error-btn" onclick="openReportErrorModal()" class="text-red-800 bg-red-50 hover:bg-red-100 py-1.5 px-3 rounded-full font-bold text-sm transition-colors border border-red-300 flex items-center shadow-sm">
                        ⚠️ Cập nhật TLTK / Góp ý / Báo lỗi
                    </button>
                    <button id="bookmark-quiz-btn" onclick="toggleBookmarkCurrent()" class="text-amber-700 bg-amber-50 hover:bg-amber-100 py-1.5 px-3 rounded-full font-bold text-sm transition-colors border border-amber-300 flex items-center shadow-sm">
                        <span id="bookmark-icon" class="mr-1.5">🔖</span> <span id="bookmark-text">Lưu câu</span>
                    </button>
                    <button id="block-quiz-btn" onclick="toggleBlockCurrent()" class="text-rose-700 bg-rose-50 hover:bg-rose-100 py-1.5 px-3 rounded-full font-bold text-sm transition-colors border border-rose-300 flex items-center shadow-sm">
                        <span id="block-icon" class="mr-1.5">🚫</span> <span id="block-text">Chặn câu</span>
                    </button>
                    <button onclick="openQuestionNavigatorModal()" class="text-blue-700 bg-blue-50 hover:bg-blue-100 py-1.5 px-3 rounded-full font-bold text-sm transition-colors border border-blue-200 flex items-center shadow-sm">
                        📋 Danh sách câu
                    </button>
                    <div class="text-blue-600 font-bold flex items-center bg-blue-50 py-1.5 px-3 rounded-full border border-blue-200 text-sm">
                        ⏱️ <span id="timer" class="ml-1.5 w-12 text-right">00:00</span>
                    </div>
                </div>
            </div>

            <div class="w-full bg-gray-200 rounded-full h-2 mb-4">
                <div id="progress-bar" class="bg-blue-600 h-2 rounded-full transition-all duration-300" style="width: 0%"></div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
                <div id="question-panel-wrapper" class="quiz-fit-panel lg:col-span-7 bg-gray-50 p-4 sm:p-5 rounded-2xl border border-gray-200 h-auto lg:h-[calc(100vh-175px)] overflow-y-auto pr-2 flex flex-col justify-start lg:justify-between transition-colors">
                    <div>
                        <h2 id="question-text" class="text-base sm:text-lg font-bold text-gray-800 leading-relaxed break-words text-justify">Nội dung câu hỏi...</h2>
                        <div id="question-image-container" class="hidden text-center bg-white p-3 rounded-xl border border-gray-200 shadow-sm mt-3"></div>
                    </div>
                </div>

                <div id="answers-panel-wrapper" class="quiz-fit-panel lg:col-span-5 flex flex-col justify-between h-auto lg:h-[calc(100vh-175px)]">
                    <div class="space-y-2.5 overflow-y-auto pr-1 flex-1 pb-2">
                        <div id="options-container" class="space-y-2"></div>
                        <div id="feedback-box" class="hidden p-3 rounded-xl border-l-4 overflow-hidden break-words text-sm space-y-1.5">
                            <h4 id="feedback-title" class="font-bold text-base mb-1"></h4>
                            <p id="feedback-correct-ans" class="font-medium mb-1"></p>
                            <p id="feedback-explanation" class="italic break-words"></p>
                            <div id="feedback-explanation-images" class="hidden flex flex-wrap gap-2 pt-1.5"></div>
                        </div>
                    </div>

                    <div class="mt-1 pt-2 border-t border-gray-200 flex-shrink-0 h-[52px]">
                        <div id="unanswered-actions" class="grid grid-cols-3 gap-2 h-full items-center">
                            <button onclick="prevQuestion()" class="eq-btn bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-bold px-1 rounded-xl transition-colors text-xs sm:text-sm shadow-sm flex items-center justify-center truncate">
                                ⬅️ Câu trước
                            </button>
                            <button id="flag-btn" onclick="toggleFlagCurrent()" class="eq-btn bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 font-bold px-1 rounded-xl transition-colors text-xs sm:text-sm shadow-sm flex items-center justify-center truncate">
                                <span id="flag-icon" class="mr-1">🚩</span> <span id="flag-text">Đánh cờ</span>
                            </button>
                            <button onclick="skipQuestion()" class="eq-btn bg-gray-200 hover:bg-gray-300 text-gray-700 border border-gray-300 font-bold px-1 rounded-xl transition-colors text-xs sm:text-sm shadow-sm flex items-center justify-center truncate">
                                ⏭️ Bỏ qua
                            </button>
                        </div>

                        <div id="answered-actions" class="hidden grid grid-cols-[1fr_1.5fr_1.25fr] gap-2 h-full items-center">
                            <button onclick="prevQuestion()" class="eq-btn bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200 font-bold px-1 rounded-xl transition-colors text-xs sm:text-sm shadow-sm flex items-center justify-center truncate">
                                ⬅️ Câu trước
                            </button>
                            <div id="difficulty-group" class="flex items-stretch gap-1" title="Gắn thẻ độ khó cho câu này">
                                <button type="button" data-level="easy" onclick="setCurrentDifficulty('easy')" class="eq-btn flex-1 rounded-xl border font-bold text-xs sm:text-sm transition-colors flex items-center justify-center"><span class="hidden sm:inline mr-0.5">🟢</span>Dễ</button>
                                <button type="button" data-level="medium" onclick="setCurrentDifficulty('medium')" class="eq-btn flex-1 rounded-xl border font-bold text-xs sm:text-sm transition-colors flex items-center justify-center"><span class="hidden sm:inline mr-0.5">🟡</span>Vừa</button>
                                <button type="button" data-level="hard" onclick="setCurrentDifficulty('hard')" class="eq-btn flex-1 rounded-xl border font-bold text-xs sm:text-sm transition-colors flex items-center justify-center"><span class="hidden sm:inline mr-0.5">🔴</span>Khó</button>
                            </div>
                            <button id="next-btn" onclick="nextQuestion()" class="eq-btn bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-1 rounded-xl transition-colors shadow-sm text-sm sm:text-base flex items-center justify-center truncate">
                                Câu tiếp theo ➡️
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- RESULT SCREEN -->
        <div id="result-screen" class="bg-white rounded-2xl shadow-md p-8 hidden text-center mb-8 md:mb-2">
            <h1 class="text-3xl font-bold mb-2">🎉 Hoàn Thành!</h1>
            <p class="text-gray-500 mb-6 text-sm">Bạn đã làm bài trong <span id="final-time" class="font-bold text-gray-800">00:00</span></p>
            <div class="bg-blue-50 rounded-2xl p-6 mb-6 inline-block shadow-inner border border-blue-100">
                <div class="text-5xl font-black text-blue-600" id="score-display">0/0</div>
                <div class="text-gray-600 mt-1 font-medium text-sm">Điểm số của bạn</div>
            </div>
            <div>
                <button onclick="returnToHome()" class="w-full sm:w-auto bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-8 rounded-full transition-colors mb-8 shadow-sm text-sm">
                    🔄 Về màn hình chính
                </button>
            </div>
            <div class="text-left border-t pt-6">
                <h3 class="text-lg font-bold mb-3 text-gray-800">📋 Xem lại bài làm:</h3>
                <div id="review-container" class="space-y-3"></div>
            </div>
        </div>

    </div>

    <!-- MODAL: ĐỀ XUẤT CÂU HỎI MỚI -->
    <div id="suggest-question-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-2xl w-[95vw] p-6 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-blue-700 flex items-center">💡 Đề Xuất Câu Hỏi / Bộ Đề Mới</h3>
                <button onclick="closeSuggestQuestionModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="overflow-y-auto flex-1 pr-1 text-sm space-y-4">
                <div class="bg-blue-50 p-3 rounded-xl border border-blue-200 text-xs text-blue-800">
                    Cảm ơn bạn đã đóng góp câu hỏi cho cộng đồng! Không bắt buộc điền đầy đủ mọi ô bên dưới, bạn có thể chỉ gửi 1 câu lẻ hoặc dán link gửi nguyên cả bộ đề/tài liệu.
                </div>
                <div class="bg-indigo-50/80 p-3.5 rounded-xl border border-indigo-200">
                    <label class="block text-indigo-900 font-bold mb-1">🔗 Gửi link bộ câu hỏi / File tài liệu (Tùy chọn):</label>
                    <input type="text" id="suggest-q-bundle-link" placeholder="Dán link Google Drive, Docs, OneDrive, Dropbox..." class="w-full p-2.5 border border-indigo-300 rounded-xl text-sm outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                    <p class="text-[11px] text-indigo-600 mt-1 italic">Dành cho trường hợp bạn có sẵn file Word, PDF hoặc link thư mục chứa nhiều câu hỏi muốn chia sẻ cùng lúc.</p>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">1. Phân chủ đề (Tùy chọn):</label>
                        <select id="suggest-q-topic-select" class="w-full p-2.5 border rounded-xl bg-white font-medium text-sm outline-none focus:ring-2 focus:ring-blue-500"></select>
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">2. Người đề xuất (Tùy chọn):</label>
                        <input type="text" id="suggest-q-author" placeholder="Họ tên hoặc Biệt danh..." class="w-full p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1">3. Nội dung câu hỏi (Tùy chọn):</label>
                    <textarea id="suggest-q-text" rows="3" placeholder="Nhập nội dung câu hỏi trắc nghiệm (nếu có)..." class="w-full p-3 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1.5">4. Các phương án trả lời (Tùy chọn):</label>
                    <div class="space-y-2">
                        <div class="flex items-center space-x-2"><span class="w-6 font-bold text-gray-600 text-center">A.</span><input type="text" id="suggest-q-opt-a" placeholder="Nội dung phương án A..." class="flex-1 p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500"></div>
                        <div class="flex items-center space-x-2"><span class="w-6 font-bold text-gray-600 text-center">B.</span><input type="text" id="suggest-q-opt-b" placeholder="Nội dung phương án B..." class="flex-1 p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500"></div>
                        <div class="flex items-center space-x-2"><span class="w-6 font-bold text-gray-600 text-center">C.</span><input type="text" id="suggest-q-opt-c" placeholder="Nội dung phương án C..." class="flex-1 p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500"></div>
                        <div class="flex items-center space-x-2"><span class="w-6 font-bold text-gray-600 text-center">D.</span><input type="text" id="suggest-q-opt-d" placeholder="Nội dung phương án D..." class="flex-1 p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500"></div>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">5. Đáp án đúng (Tùy chọn):</label>
                        <select id="suggest-q-correct" class="w-full p-2.5 border rounded-xl bg-green-50 font-bold text-green-700 text-sm outline-none focus:ring-2 focus:ring-green-500">
                            <option value="">-- Chưa rõ đáp án --</option>
                            <option value="A">Phương án A</option>
                            <option value="B">Phương án B</option>
                            <option value="C">Phương án C</option>
                            <option value="D">Phương án D</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">6. Ghi chú / Nguồn sách (Tùy chọn):</label>
                        <input type="text" id="suggest-q-notes" placeholder="VD: Giáo trình Phẫu thuật Hàm mặt..." class="w-full p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1">7. Lời giải / Giải thích chi tiết (Tùy chọn):</label>
                    <textarea id="suggest-q-explanation" rows="2" placeholder="Giải thích vì sao đáp án đúng..." class="w-full p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-blue-500 resize-none"></textarea>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">8. Link ảnh câu hỏi (mỗi dòng 1 link - Tùy chọn):</label>
                        <textarea id="suggest-q-img-urls" rows="2" placeholder="https://...&#10;https://..." class="w-full p-2 border rounded-xl text-xs font-mono outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">9. Link ảnh giải thích (mỗi dòng 1 link - Tùy chọn):</label>
                        <textarea id="suggest-q-exp-img-urls" rows="2" placeholder="https://...&#10;https://..." class="w-full p-2 border rounded-xl text-xs font-mono outline-none focus:ring-2 focus:ring-blue-500"></textarea>
                    </div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-end space-x-2">
                <button onclick="closeSuggestQuestionModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                <button id="btn-submit-suggest-q" onclick="submitSuggestQuestion()" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">🚀 Gửi đề xuất</button>
            </div>
        </div>
    </div>

    <!-- MODAL: GÓP Ý / LIÊN HỆ TÁC GIẢ -->
    <div id="app-feedback-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-lg w-[95vw] p-6 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-teal-700 flex items-center">📩 Góp Ý/ Liên Hệ</h3>
                <button onclick="closeAppFeedbackModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="overflow-y-auto flex-1 pr-1 text-sm space-y-4">
                <div class="bg-gradient-to-r from-teal-50 to-emerald-50 p-3.5 rounded-xl border border-teal-200 shadow-sm">
                    <p class="font-bold text-teal-900 text-sm mb-1.5 flex items-center"><span class="mr-1.5">📞</span> Thông tin liên hệ trực tiếp:</p>
                    <div class="text-xs sm:text-sm text-gray-700 space-y-1">
                        <p>💬 <b>Zalo:</b> <a href="https://zalo.me/0792177208" target="_blank" class="text-teal-700 font-bold hover:underline">0792177208</a></p>
                        <p>📧 <b>Email:</b> <a href="mailto:nhk9201@gmail.com" class="text-teal-700 font-bold hover:underline">nhk9201@gmail.com</a></p>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">1. Phân loại (Tùy chọn):</label>
                        <select id="app-fb-type" class="w-full p-2.5 border rounded-xl bg-white font-medium text-sm outline-none focus:ring-2 focus:ring-teal-500">
                            <option value="Góp ý chung">💬 Góp ý chung</option>
                            <option value="Liên hệ tác giả">🤝 Liên hệ tác giả</option>
                            <option value="Báo lỗi tính năng">🐞 Báo lỗi tính năng</option>
                            <option value="Lỗi giao diện">🎨 Lỗi hiển thị / Giao diện</option>
                            <option value="Đề xuất tính năng mới">💡 Đề xuất tính năng mới</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-1">2. Người gửi (Tùy chọn):</label>
                        <input type="text" id="app-fb-sender" placeholder="Họ tên hoặc Biệt danh..." class="w-full p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-teal-500">
                    </div>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1">3. Tiêu đề phản hồi (Tùy chọn):</label>
                    <input type="text" id="app-fb-title" placeholder="VD: Góp ý về giao diện / Trao đổi tài liệu..." class="w-full p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-teal-500">
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1">4. Chi tiết nội dung góp ý / mô tả lỗi (Tùy chọn):</label>
                    <textarea id="app-fb-content" rows="4" placeholder="Nhập nội dung bạn muốn gửi tới tác giả... (Bạn có thể dán kèm link ảnh minh họa lỗi nếu có)" class="w-full p-3 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-teal-500 resize-none"></textarea>
                    <p class="text-[11px] text-teal-600 mt-1 italic">💡 Gợi ý: Nếu gặp lỗi hiển thị, bạn có thể tải ảnh lên Google Drive, Imgur, Postimages... rồi dán kèm link ảnh vào đây để tác giả dễ hỗ trợ.</p>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1">5. Thông tin liên hệ lại của bạn (Email / SĐT / Zalo - Tùy chọn):</label>
                    <input type="text" id="app-fb-contact" placeholder="Để tác giả có thể phản hồi lại khi cần..." class="w-full p-2.5 border rounded-xl text-sm outline-none focus:ring-2 focus:ring-teal-500">
                </div>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-end space-x-2">
                <button onclick="closeAppFeedbackModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                <button id="btn-submit-app-fb" onclick="submitAppFeedback()" class="bg-gradient-to-r from-teal-600 to-emerald-600 hover:from-teal-700 hover:to-emerald-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">📧 Gửi phản hồi</button>
            </div>
        </div>
    </div>

    <!-- MODAL THÊM CÂU HỎI MỚI (QUICK PASTE) -->
    <div id="add-question-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-blue-700 flex items-center">➕ Thêm Câu Hỏi Mới</h3>
                <button onclick="closeAddQuestionModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="space-y-4 overflow-y-auto flex-1 pr-1 text-sm">
                <div class="bg-blue-50 p-3.5 rounded-xl border border-blue-100">
                    <p class="font-bold text-blue-800 mb-1">💡 Mẹo dán nhanh toàn bộ câu hỏi:</p>
                    <p class="text-xs text-gray-600">Dán nguyên đoạn văn bản gồm Câu hỏi, các đáp án A, B, C, D, Đáp án và Giải thích vào ô bên dưới, hệ thống sẽ tự động tách cho bạn!</p>
                </div>
                <div>
                    <div class="flex justify-between items-center mb-1.5">
                        <label class="font-bold text-gray-700">Dán nội dung câu hỏi (Nhấn Ctrl+V):</label>
                        <button type="button" onclick="autoPasteQuickModal()" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold py-1.5 px-3 rounded-lg border border-blue-200 transition-colors shadow-sm flex items-center">📋 Dán từ Clipboard</button>
                    </div>
                    <textarea id="quick-paste-textarea" rows="6" class="w-full p-3.5 border-2 border-blue-400 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none shadow-sm" placeholder="Nhấn Ctrl+V để dán nội dung câu hỏi vào đây..."></textarea>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-between items-center">
                <button onclick="addBlankQuestionAction()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">➕ Thêm câu hỏi trống</button>
                <div class="space-x-2">
                    <button onclick="closeAddQuestionModal()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                    <button onclick="submitQuickPasteQuestion()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">🚀 Thêm câu hỏi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL ÔN TẬP NHANH (HỖ TRỢ RESUME + BỎ CHỦ ĐỀ 37 THI THỬ) -->
    <div id="mock-exam-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-lg w-[95vw] p-5 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-amber-600 flex items-center">⚡ Cấu Hình Ôn Tập Nhanh</h3>
                <button onclick="closeMockExamModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="overflow-y-auto flex-1 pr-1 text-sm space-y-4">
                <div id="mock-resume-banner" class="hidden"></div>
                <div>
                    <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
                        <label class="block text-gray-700 font-bold">1. Chọn chủ đề ôn tập (1 - 36):</label>
                        <div class="flex gap-2">
                            <button type="button" onclick="mockTopicSelectAll(true)" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-1 px-2.5 rounded border">Chọn tất cả</button>
                            <button type="button" onclick="mockTopicSelectAll(false)" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-1 px-2.5 rounded border">Bỏ chọn tất cả</button>
                        </div>
                    </div>
                    <div id="mock-topic-grid" class="grid grid-cols-6 gap-1.5 sm:gap-2 border p-2.5 rounded-xl bg-gray-50"></div>
                    <p id="mock-total-available-text" class="text-xs text-gray-500 mt-2">Tổng số câu có sẵn: <b>0</b> câu</p>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1.5">2. Số lượng câu hỏi ôn tập:</label>
                    <div class="flex flex-wrap gap-2 mb-2">
                        <button type="button" onclick="setMockNumQuestions(10)" class="text-xs bg-gray-100 hover:bg-amber-100 text-gray-700 font-semibold py-1.5 px-3 rounded-lg border">10</button>
                        <button type="button" onclick="setMockNumQuestions(15)" class="text-xs bg-gray-100 hover:bg-amber-100 text-gray-700 font-semibold py-1.5 px-3 rounded-lg border">15</button>
                        <button type="button" onclick="setMockNumQuestions(20)" class="text-xs bg-gray-100 hover:bg-amber-100 text-gray-700 font-semibold py-1.5 px-3 rounded-lg border">20</button>
                        <button type="button" onclick="setMockNumQuestions(25)" class="text-xs bg-gray-100 hover:bg-amber-100 text-gray-700 font-semibold py-1.5 px-3 rounded-lg border">25</button>
                        <button type="button" onclick="setMockNumQuestions(30)" class="text-xs bg-gray-100 hover:bg-amber-100 text-gray-700 font-semibold py-1.5 px-3 rounded-lg border">30</button>
                        <button type="button" onclick="setMockNumQuestions(40)" class="text-xs bg-gray-100 hover:bg-amber-100 text-gray-700 font-semibold py-1.5 px-3 rounded-lg border">40</button>
                        <button type="button" onclick="setMockNumQuestions(50)" class="text-xs bg-gray-100 hover:bg-amber-100 text-gray-700 font-semibold py-1.5 px-3 rounded-lg border">50</button>
                    </div>
                    <input type="number" id="mock-num-questions" min="1" value="10" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-amber-500 outline-none font-semibold text-sm">
                </div>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-end items-center space-x-2">
                <button onclick="closeMockExamModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                <button onclick="mockQuickPick()" class="bg-amber-100 hover:bg-amber-200 text-amber-700 font-semibold py-2 px-4 rounded-xl text-sm border border-amber-300 transition-colors">⚡ Chọn nhanh</button>
                <button onclick="startMockExam()" class="bg-gradient-to-r from-yellow-400 to-amber-500 hover:from-yellow-500 hover:to-amber-600 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">🚀 Bắt đầu bài mới</button>
            </div>
        </div>
    </div>

    <!-- MODAL THI THỬ (HIỂN THỊ KỶ LỤC BEST RECORD & RESUME) -->
    <div id="exam-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-lg w-[95vw] p-5 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-indigo-600 flex items-center">🎯 Thi Thử (Mock Exam)</h3>
                <button onclick="closeExamModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="dev-only flex items-center gap-2 flex-wrap mb-3 pb-3 border-b">
                <button onclick="openExamCreateModal()" class="text-xs bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-3 rounded-xl shadow-sm transition-colors">➕ Tạo đề mới</button>
                <button onclick="triggerExamJsonImport()" class="text-xs bg-violet-600 hover:bg-violet-700 text-white font-semibold py-2 px-3 rounded-xl shadow-sm transition-colors">📂 Nhập JSON</button>
                <input type="file" id="exam-json-input" accept=".json" multiple class="hidden" onchange="importExamJsonFiles(event)">
            </div>
            <div class="overflow-y-auto flex-1 pr-1 text-sm space-y-3">
                <p class="text-gray-600 text-xs">Chọn một đề thi bên dưới để bắt đầu làm bài hoặc tiếp tục làm dở.</p>
                <div id="exam-list" class="space-y-2"></div>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-between items-center space-x-2">
                <button onclick="autoImportFromFolder(true)" title="Nạp lại dữ liệu mới nhất từ import-manifest" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-3 rounded-xl border transition-colors">🔄 Nạp lại</button>
                <div class="flex space-x-2">
                    <button onclick="closeExamModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                    <button id="btn-start-exam-main" onclick="startExam(false)" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">🚀 Bắt đầu thi</button>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL TẠO ĐỀ THI MỚI (DEV) -->
    <div id="exam-create-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-lg w-[95vw] p-5 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-purple-700 flex items-center">➕ Tạo Đề Thi Mới</h3>
                <button onclick="closeExamCreateModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="overflow-y-auto flex-1 pr-1 text-sm space-y-4">
                <div class="bg-blue-50 p-3 rounded-xl border border-blue-200 text-xs text-gray-600">
                    Câu hỏi bắt đầu bằng "Câu [số]:", các đáp án A, B, C, D, đáp án đúng ghi "Đáp án: [A/B/C/D]" và giải thích ghi "Giải thích: [...]".
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1.5">Tên đề thi</label>
                    <input type="text" id="exam-create-name" class="w-full p-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-purple-500 outline-none" placeholder="VD: Đề thi thử số 1...">
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1.5">Tải lên file Word (.docx), Text (.txt) hoặc Markdown (.md)</label>
                    <input type="file" id="exam-create-file" accept=".docx, .txt, .md, .markdown" class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-sm file:font-semibold file:bg-purple-50 file:text-purple-700 hover:file:bg-purple-100 mb-2"/>
                    <div class="flex items-center justify-center my-2 text-xs text-gray-400 font-medium">HOẶC DÁN VĂN BẢN TRỰC TIẾP (NHẤN CTRL+V)</div>
                    <textarea id="exam-create-manual" rows="6" class="w-full p-3.5 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-purple-500 outline-none" placeholder="Nhấn Ctrl+V để dán nội dung đề thi vào đây..."></textarea>
                </div>
                <p id="exam-create-error" class="text-red-500 text-center mt-1 hidden font-medium text-sm"></p>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-end space-x-2">
                <button onclick="closeExamCreateModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                <button onclick="processExamAndSave()" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">🚀 Lưu Đề Thi</button>
            </div>
        </div>
    </div>

    <!-- MODAL BÁO LỖI CÂU HỎI TRONG KHI LÀM BÀI -->
    <div id="report-error-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-xl w-[95vw] p-6 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-red-600 flex items-center">⚠️ Cập Nhật TLTK / Góp Ý/ Báo Lỗi</h3>
                <button onclick="closeReportErrorModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="overflow-y-auto flex-1 pr-1 text-sm space-y-5">
                <div>
                    <label class="block text-gray-700 font-bold mb-1.5">📎 Cập Nhật Tài Liệu Tham Khảo (tuỳ chọn):</label>
                    <input id="report-reflink" type="text" placeholder="Dán link tài liệu tham khảo (Google Drive, PDF, bài viết...)" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-400 outline-none text-sm">
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1.5">💡 Góp Ý Câu Hỏi (tuỳ chọn):</label>
                    <textarea id="report-suggestion" rows="2" placeholder="Góp ý của bạn về câu hỏi này..." class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-400 outline-none text-sm resize-none"></textarea>
                </div>
                <div class="pt-3 border-t">
                    <label class="block text-gray-700 font-bold mb-2">⚠️ Báo lỗi (tuỳ chọn) — Vị trí lỗi:</label>
                    <div id="report-position-group" class="flex flex-wrap gap-2"></div>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-2">Chọn nhanh loại lỗi (tuỳ chọn):</label>
                    <div id="report-tag-group" class="flex flex-wrap gap-2"></div>
                </div>
                <div>
                    <label class="block text-gray-700 font-bold mb-1.5">Mô tả chi tiết (tuỳ chọn):</label>
                    <textarea id="report-description" rows="3" placeholder="Mô tả thêm về lỗi bạn gặp phải hoặc dán kèm link ảnh minh họa..." class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-red-400 outline-none text-sm resize-none"></textarea>
                    <p class="text-[11px] text-gray-500 mt-1 italic">💡 Gợi ý: Bạn có thể dán kèm link ảnh chụp màn hình (Google Drive, Imgur...) để người duyệt dễ kiểm tra hơn.</p>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-end space-x-2">
                <button onclick="closeReportErrorModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                <button onclick="submitReportError()" class="bg-gradient-to-r from-red-500 to-rose-600 hover:from-red-600 hover:to-rose-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">📧 Gửi</button>
            </div>
        </div>
    </div>

    <!-- MODAL ÔN TẬP CHUYÊN SÂU (HỖ TRỢ RESUME) -->
    <div id="deep-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-5xl w-[95vw] p-6 shadow-2xl flex flex-col max-h-[88vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-teal-700 flex items-center">🧠 Cấu Hình Ôn Tập Chuyên Sâu</h3>
                <button onclick="closeDeepModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div id="deep-resume-banner" class="hidden mb-3"></div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 overflow-y-auto flex-1 pr-1 text-sm">
                <div>
                    <label class="block text-gray-700 font-bold mb-2">1. Chọn chủ đề &amp; bộ đề:</label>
                    <div class="flex flex-wrap gap-2 mb-2">
                        <button type="button" onclick="deepSelectAll(true)" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-1 px-2.5 rounded border">Chọn tất cả</button>
                        <button type="button" onclick="deepSelectAll(false)" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-1 px-2.5 rounded border">Bỏ chọn tất cả</button>
                        <button type="button" onclick="deepSelectRandom()" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-1 px-2.5 rounded border">🎲 Chọn ngẫu nhiên</button>
                    </div>
                    <div id="deep-tree" class="space-y-2 border p-3 rounded-xl bg-gray-50 max-h-[50vh] overflow-y-auto"></div>
                </div>
                <div class="space-y-4">
                    <div>
                        <label class="block text-gray-700 font-bold mb-1.5">2. Tỉ lệ phân bố độ khó (%):</label>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="bg-green-50 border border-green-300 rounded-xl p-2 text-center">
                                <div class="font-bold text-green-700 mb-1">🟢 Dễ</div>
                                <input type="number" id="deep-pct-easy" min="0" max="100" value="30" oninput="updateDeepSummary()" class="w-full p-1.5 border border-green-300 rounded-lg text-center font-semibold outline-none focus:ring-2 focus:ring-green-400">
                            </div>
                            <div class="bg-amber-50 border border-amber-300 rounded-xl p-2 text-center">
                                <div class="font-bold text-amber-700 mb-1">🟡 Vừa</div>
                                <input type="number" id="deep-pct-medium" min="0" max="100" value="50" oninput="updateDeepSummary()" class="w-full p-1.5 border border-amber-300 rounded-lg text-center font-semibold outline-none focus:ring-2 focus:ring-amber-400">
                            </div>
                            <div class="bg-red-50 border border-red-300 rounded-xl p-2 text-center">
                                <div class="font-bold text-red-700 mb-1">🔴 Khó</div>
                                <input type="number" id="deep-pct-hard" min="0" max="100" value="20" oninput="updateDeepSummary()" class="w-full p-1.5 border border-red-300 rounded-lg text-center font-semibold outline-none focus:ring-2 focus:ring-red-400">
                            </div>
                        </div>
                        <p id="deep-pct-sum" class="text-xs mt-1.5 font-semibold"></p>
                        <p id="deep-avail" class="text-xs text-gray-600 mt-1"></p>
                    </div>
                    <div>
                        <label class="block text-gray-700 font-bold mb-1.5">3. Số lượng câu hỏi:</label>
                        <input type="number" id="deep-num-questions" min="1" value="20" oninput="updateDeepSummary()" class="w-full p-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-teal-500 outline-none font-semibold text-sm">
                        <p id="deep-plan" class="text-xs text-teal-700 font-semibold mt-1.5"></p>
                        <p class="text-xs text-gray-400 mt-1">Chỉ tính các câu đã gắn thẻ độ khó. Hệ thống tự bù nếu thiếu ở một mức.</p>
                    </div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-t flex justify-end space-x-2">
                <button onclick="closeDeepModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Hủy</button>
                <button onclick="startDeepReview()" class="bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-600 hover:to-emerald-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">🚀 Bắt đầu bài mới</button>
            </div>
        </div>
    </div>

    <!-- MODAL CHỦ ĐỀ -->
    <div id="topic-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-3 z-40" onclick="if(event.target===this)closeTopicModal()">
        <div class="bg-white rounded-2xl w-full max-w-4xl p-4 sm:p-6 shadow-2xl flex flex-col max-h-[90vh]">
            <div class="flex justify-between items-start gap-3 mb-3 pb-3 border-b">
                <div class="min-w-0">
                    <h3 id="topic-modal-title" class="text-sm sm:text-lg font-bold text-blue-700 leading-snug break-words"></h3>
                    <p id="topic-modal-sub" class="text-sm text-gray-500"></p>
                </div>
                <div class="flex items-center gap-2 flex-wrap justify-end">
                    <button id="topic-add-json-btn" onclick="triggerTopicJsonImport()" class="dev-only text-sm bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-1.5 px-3 rounded-xl shadow-sm transition-colors">➕ Thêm đề JSON</button>
                    <select id="topic-sort-select" onchange="renderTopicModal()" class="text-sm bg-gray-50 hover:bg-gray-100 text-gray-700 font-semibold py-1.5 px-2 rounded-xl border border-gray-300 outline-none cursor-pointer">
                        <option value="newest">🕒 Mới nhất</option>
                        <option value="oldest">⏳ Cũ nhất</option>
                        <option value="name_az">🔤 Tên (A-Z)</option>
                        <option value="name_za">🔤 Tên (Z-A)</option>
                        <option value="questions_desc">📊 Nhiều câu nhất</option>
                    </select>
                    <button onclick="closeTopicModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg px-2">✕</button>
                </div>
            </div>

            <div id="topic-review-panel" class="hidden mb-3 bg-amber-50 border border-amber-200 rounded-xl p-3">
                <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
                    <span class="font-bold text-amber-800 text-sm">⚡ Ôn tập chủ đề</span>
                    <div class="flex items-center gap-2 flex-wrap">
                        <button onclick="topicSelectAll(true)" class="text-xs bg-white hover:bg-amber-100 border border-amber-300 text-amber-800 font-semibold py-1.5 px-3 rounded-lg">☑️ Chọn tất cả</button>
                        <button onclick="topicSelectAll(false)" class="text-xs bg-white hover:bg-amber-100 border border-amber-300 text-amber-800 font-semibold py-1.5 px-3 rounded-lg">☐ Bỏ chọn</button>
                        <button onclick="topicSelectRandom()" class="text-xs bg-white hover:bg-amber-100 border border-amber-300 text-amber-800 font-semibold py-1.5 px-3 rounded-lg">🎲 Chọn ngẫu nhiên</button>
                    </div>
                </div>
                <div class="flex items-center justify-between flex-wrap gap-2">
                    <span id="topic-review-summary" class="text-sm text-gray-700"></span>
                    <div class="flex items-center gap-2">
                        <label class="text-sm font-semibold text-gray-700">Số câu:</label>
                        <input type="number" id="topic-num-questions" min="1" oninput="topicNumTouched=true" class="w-20 p-1.5 border border-gray-300 rounded-lg text-sm text-center outline-none focus:ring-2 focus:ring-amber-400">
                        <button onclick="startTopicReview()" class="bg-gradient-to-r from-yellow-400 to-amber-500 hover:from-yellow-500 hover:to-amber-600 text-white font-bold py-1.5 px-4 rounded-xl text-sm shadow-sm">▶️ Bắt đầu ôn tập</button>
                    </div>
                </div>
            </div>

            <div id="topic-quiz-list" class="overflow-y-auto space-y-2 flex-1 pr-1"></div>
        </div>
    </div>
    <input type="file" id="import-topic-json-input" accept=".json" multiple class="hidden" onchange="importTopicJsonFiles(event)">

    <!-- FOLDER MODAL: PHÂN CHỦ ĐỀ CHO BỘ ĐỀ -->
    <div id="folder-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-5xl w-[95vw] p-6 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-blue-700 flex items-center">🗂️ Phân Chủ Đề Cho Bộ Đề</h3>
                <button onclick="closeFolderModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="overflow-y-auto space-y-3 flex-1 pr-1 text-sm" id="folder-modal-body"></div>
            <div class="mt-4 pt-3 border-t flex justify-end space-x-2">
                <button onclick="closeFolderModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors flex items-center">💾 Lưu</button>
                <button onclick="closeFolderModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm transition-colors">Đóng</button>
            </div>
        </div>
    </div>

    <!-- MODAL DANH SÁCH CÂU HỎI -->
    <div id="navigator-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-5xl w-[95vw] p-6 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-blue-700 flex items-center">📋 Danh Sách Câu Hỏi</h3>
                <button onclick="closeQuestionNavigatorModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div class="flex flex-wrap gap-2.5 mb-4 text-xs font-medium text-gray-600 bg-gray-50 p-3 rounded-xl border">
                <div class="flex items-center"><span class="w-3 h-3 bg-green-500 rounded-full inline-block mr-1"></span> Đã đúng</div>
                <div class="flex items-center"><span class="w-3 h-3 bg-red-500 rounded-full inline-block mr-1"></span> Đã sai</div>
                <div class="flex items-center"><span class="w-3 h-3 bg-amber-200 rounded-full inline-block mr-1"></span> Bỏ qua</div>
                <div class="flex items-center"><span class="w-3 h-3 bg-gray-200 rounded-full inline-block mr-1"></span> Chưa làm</div>
                <div class="flex items-center"><span class="text-xs mr-1">🚩</span> Đánh cờ</div>
            </div>
            <div id="navigator-grid" class="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 lg:grid-cols-12 gap-2.5 overflow-y-auto flex-1 p-1"></div>
            <div class="mt-4 pt-3 border-t text-right">
                <button onclick="closeQuestionNavigatorModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm">Đóng</button>
            </div>
        </div>
    </div>

    <!-- MODAL XEM TRƯỚC BỘ ĐỀ -->
    <div id="view-quiz-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-5xl w-[95vw] p-6 shadow-2xl max-h-[85vh] flex flex-col">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <div id="view-modal-title" class="text-lg font-bold text-blue-700 flex items-center justify-between flex-1 pr-4"></div>
                <button onclick="closeViewQuizModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div id="view-quiz-list-container" class="overflow-y-auto space-y-4 flex-1 pr-2 text-sm"></div>
            <div class="mt-4 pt-3 border-t text-right">
                <button onclick="closeViewQuizModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm">Đóng</button>
            </div>
        </div>
    </div>

    <!-- MODAL ĐÃ LƯU -->
    <div id="bookmarked-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-5xl w-[95vw] p-6 shadow-2xl max-h-[85vh] flex flex-col">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-amber-700 flex items-center">⭐ Danh Sách Câu Hỏi Đã Lưu (<span id="modal-bm-count">0</span>)</h3>
                <button onclick="closeBookmarkedModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div id="bookmarked-list-container" class="overflow-y-auto space-y-4 flex-1 pr-2 text-sm"></div>
            <div class="mt-4 pt-3 border-t flex justify-between items-center">
                <button onclick="startBookmarkedQuiz()" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold py-2 px-4 rounded-xl text-sm shadow-sm transition-colors flex items-center">⭐ Ôn tập câu đã lưu</button>
                <button onclick="closeBookmarkedModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">Đóng</button>
            </div>
        </div>
    </div>

    <!-- MODAL ĐÃ CHẶN -->
    <div id="blocked-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-5xl w-[95vw] p-6 shadow-2xl max-h-[85vh] flex flex-col">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-rose-700 flex items-center">🚫 Danh Sách Câu Hỏi Đã Chặn (<span id="modal-bl-count">0</span>)</h3>
                <button onclick="closeBlockedModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            <div id="blocked-list-container" class="overflow-y-auto space-y-4 flex-1 pr-2 text-sm"></div>
            <div class="mt-4 pt-3 border-t flex justify-end">
                <button onclick="closeBlockedModal()" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-2 px-5 rounded-xl text-sm shadow-sm transition-colors">Đóng</button>
            </div>
        </div>
    </div>

    <!-- MODAL MẬT KHẨU DEV -->
    <div id="dev-password-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-[60]">
        <div class="bg-white rounded-2xl max-w-xs w-full p-6 shadow-2xl">
            <h3 class="text-lg font-bold text-gray-800 mb-1 flex items-center">🔒 Chế độ Nhà phát triển</h3>
            <p class="text-xs text-gray-500 mb-4">Nhập mật khẩu để kích hoạt.</p>
            <input type="password" id="dev-password-input" autocomplete="off" class="w-full p-3 border border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none mb-2" placeholder="Mật khẩu..." onkeydown="if(event.key==='Enter') submitDevPassword()">
            <p id="dev-password-error" class="text-red-500 text-xs mb-3 hidden">Sai mật khẩu!</p>
            <div class="flex justify-end space-x-2">
                <button onclick="closeDevPasswordModal()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-xl text-sm">Hủy</button>
                <button onclick="submitDevPassword()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-xl text-sm">Xác nhận</button>
            </div>
        </div>
    </div>

    <!-- MODAL QUẢN LÝ DỮ LIỆU JSON -->
    <div id="storage-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden flex items-center justify-center p-4 z-50">
        <div class="bg-white rounded-2xl max-w-5xl w-[95vw] p-6 shadow-2xl flex flex-col max-h-[85vh]">
            <div class="flex justify-between items-center mb-4 pb-2 border-b">
                <h3 class="text-lg font-bold text-gray-800 flex items-center">💾 Quản Lý Dữ Liệu & Sao Lưu</h3>
                <button onclick="closeStorageModal()" class="text-gray-500 hover:text-gray-700 font-bold text-lg">✕</button>
            </div>
            
            <div class="overflow-y-auto space-y-4 flex-1 pr-1 text-sm">
                <div class="bg-blue-50 p-4 rounded-xl border border-blue-200">
                    <h4 class="font-bold text-blue-800 mb-1">📤 Sao lưu dự phòng toàn bộ:</h4>
                    <p class="text-gray-600 mb-3 text-xs">Xuất toàn bộ bộ đề + ảnh bìa ra file <code>import-manifest.json</code>.</p>
                    <div class="flex space-x-2.5 flex-wrap gap-2">
                        <button onclick="exportJsonFile()" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold py-2 px-3.5 rounded-xl transition-colors shadow-sm text-sm">📤 Xuất toàn bộ (.json)</button>
                        <button onclick="triggerImportMultipleJson()" class="bg-violet-600 hover:bg-violet-700 text-white font-semibold py-2 px-3.5 rounded-xl transition-colors shadow-sm text-sm">📂 Tải lên nhiều file JSON</button>
                    </div>
                </div>

                <div>
                    <h4 class="font-bold text-gray-800 mb-2">📂 Xuất JSON & Xóa từng bộ đề riêng lẻ:</h4>
                    <div id="storage-quiz-export-list" class="space-y-2 max-h-48 overflow-y-auto border p-3 rounded-xl bg-gray-50"></div>
                </div>

                <div>
                    <h4 class="font-bold text-gray-800 mb-2">🎯 Đề thi thử (Thi Thử) — xuất JSON hoặc xóa:</h4>
                    <div id="storage-exam-export-list" class="space-y-2 max-h-48 overflow-y-auto border p-3 rounded-xl bg-gray-50"></div>
                </div>

                <div>
                    <h4 class="font-bold text-gray-800 mb-1.5">📋 Dữ liệu JSON thô (Raw Data):</h4>
                    <textarea id="storage-textarea" rows="3" class="w-full p-3 font-mono text-xs border border-gray-300 rounded-xl bg-gray-50 mb-2 outline-none focus:ring-2 focus:ring-blue-500" readonly></textarea>
                    <button onclick="copyStorageData()" class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-3 rounded-xl transition-colors shadow-sm text-xs">📋 Sao chép dữ liệu thô</button>
                </div>
            </div>

            <input type="file" id="import-json-input" accept=".json" class="hidden" onchange="importJsonFile(event)">
            <input type="file" id="import-multiple-json-input" accept=".json" multiple class="hidden" onchange="importMultipleJsonFiles(event)">

            <div class="mt-4 pt-3 border-t text-right">
                <button onclick="closeStorageModal()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-5 rounded-xl text-sm shadow-sm">Đóng</button>
            </div>
        </div>
    </div>

    <!-- BẮT ĐẦU JAVASCRIPT: STORAGE & LIGHTBOX -->
    <script>
        const kv = (() => {
            const DB_NAME = 'quizAppDB';
            const STORE = 'kv';
            const META_KEY = '__migrated_from_localstorage_v1';
            const cache = new Map();
            let db = null;
            let lastErrorToast = 0;

            function reportError(err) {
                console.error('[Storage] Lỗi ghi dữ liệu:', err);
                const now = Date.now();
                if (now - lastErrorToast > 5000 && typeof showToast === 'function') {
                    lastErrorToast = now;
                    showToast('Không lưu được dữ liệu vào bộ nhớ trình duyệt!');
                }
            }

            function openDb() {
                return new Promise((resolve, reject) => {
                    if (!window.indexedDB) return reject(new Error('IndexedDB không khả dụng'));
                    const req = indexedDB.open(DB_NAME, 1);
                    req.onupgradeneeded = () => {
                        if (!req.result.objectStoreNames.contains(STORE)) req.result.createObjectStore(STORE);
                    };
                    req.onsuccess = () => resolve(req.result);
                    req.onerror = () => reject(req.error);
                    req.onblocked = () => reject(new Error('IndexedDB bị chặn'));
                });
            }

            function loadAll() {
                return new Promise((resolve, reject) => {
                    const tx = db.transaction(STORE, 'readonly');
                    const req = tx.objectStore(STORE).openCursor();
                    req.onsuccess = () => {
                        const cur = req.result;
                        if (cur) { cache.set(cur.key, cur.value); cur.continue(); }
                    };
                    tx.oncomplete = () => resolve();
                    tx.onerror = tx.onabort = () => reject(tx.error);
                });
            }

            function migrateFromLocalStorage() {
                return new Promise((resolve) => {
                    if (cache.get(META_KEY)) return resolve();
                    let lsKeys = [];
                    try { lsKeys = Object.keys(localStorage).filter(k => k.startsWith('quizApp')); } catch (e) {}

                    let tx;
                    try { tx = db.transaction(STORE, 'readwrite', { durability: 'strict' }); }
                    catch (e) { tx = db.transaction(STORE, 'readwrite'); }
                    const store = tx.objectStore(STORE);
                    const moved = [];
                    lsKeys.forEach(k => {
                        let v = null;
                        try { v = localStorage.getItem(k); } catch (e) {}
                        if (v === null) return;
                        if (!cache.has(k)) { store.put(v, k); cache.set(k, v); }
                        moved.push(k);
                    });
                    store.put('1', META_KEY);

                    tx.oncomplete = () => {
                        cache.set(META_KEY, '1');
                        moved.forEach(k => { try { localStorage.removeItem(k); } catch (e) {} });
                        resolve();
                    };
                    tx.onerror = tx.onabort = () => resolve();
                });
            }

            return {
                async init() {
                    try {
                        db = await openDb();
                        await loadAll();
                        await migrateFromLocalStorage();
                    } catch (err) {
                        db = null;
                        cache.clear();
                    }
                    try { if (navigator.storage && navigator.storage.persist) navigator.storage.persist(); } catch (e) {}
                    return !!db;
                },
                getItem(key) {
                    if (db) return cache.has(key) ? cache.get(key) : null;
                    try { return localStorage.getItem(key); } catch (e) { return null; }
                },
                setItem(key, value) {
                    value = String(value);
                    if (db) {
                        cache.set(key, value);
                        try {
                            const tx = db.transaction(STORE, 'readwrite');
                            tx.objectStore(STORE).put(value, key);
                            tx.onerror = tx.onabort = () => reportError(tx.error);
                        } catch (e) { reportError(e); }
                        return;
                    }
                    try { localStorage.setItem(key, value); } catch (e) { reportError(e); }
                },
                removeItem(key) {
                    if (db) {
                        cache.delete(key);
                        try {
                            const tx = db.transaction(STORE, 'readwrite');
                            tx.objectStore(STORE).delete(key);
                            tx.onerror = tx.onabort = () => reportError(tx.error);
                        } catch (e) { reportError(e); }
                        return;
                    }
                    try { localStorage.removeItem(key); } catch (e) {}
                },
                keys() {
                    if (db) return Array.from(cache.keys()).filter(k => k !== META_KEY);
                    try { return Object.keys(localStorage); } catch (e) { return []; }
                }
            };
        })();

        let questions = [];
        let questionStates = [];
        let currentIndex = 0;
        let timerInterval;
        let timeElapsed = 0;
        let currentQuizName = "";
        let currentQuizId = null;
        let editingQuizId = null;
        let currentFolderFilter = "ALL";
        let folderTreeExpanded = {};
        let activeAddQuestionIndex = null;
        let currentImageZoom = 1;
        let baseImgWidth = 0;
        let baseImgHeight = 0;

        let isEditingFromQuiz = false;
        let returnQuizIndex = 0;
        let returnOrigIndex = null;

        let isLightboxPanning = false;
        let startPanX = 0, startPanY = 0;
        let scrollLeftPos = 0, scrollTopPos = 0;
        let isDrawMode = false;
        let isDrawing = false;
        let lastDrawX = 0, lastDrawY = 0;
        let lightboxDrawingsMap = {}; 

        function showToast(message) {
            let toast = document.getElementById('custom-toast');
            if (!toast) {
                toast = document.createElement('div');
                toast.id = 'custom-toast';
                toast.className = 'fixed bottom-5 right-5 bg-gray-900 text-white px-4 py-3 rounded-xl shadow-2xl z-50 transition-all transform translate-y-20 opacity-0 text-sm font-semibold pointer-events-none';
                document.body.appendChild(toast);
            }
            toast.textContent = message;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => { toast.classList.add('translate-y-20', 'opacity-0'); }, 3000);
        }

        // Dựng chuỗi HTML các thẻ <img> thumbnail (dùng chung cho câu hỏi/giải thích, mở lightbox khi click)
        function buildImageThumbsHtml(images, maxHeightPx, hoverClass = 'hover:opacity-90') {
            return images.map(img => `<img src="${img}" onclick="openLightbox('${img}')" class="cursor-pointer ${hoverClass}" style="max-height: ${maxHeightPx}px; border-radius: 6px; border: 1px solid #ddd; object-fit: contain;" />`).join('');
        }

        function openLightbox(imgSrc) {
            currentImageZoom = 1;
            isDrawMode = false;
            updateDrawModeButton();

            const modal = document.getElementById('image-lightbox-modal');
            const img = document.getElementById('lightbox-img');
            const canvas = document.getElementById('lightbox-canvas');
            img.src = imgSrc;
            
            img.onload = () => {
                canvas.width = img.naturalWidth;
                canvas.height = img.naturalHeight;
                const maxH = window.innerHeight * 0.75;
                const maxW = window.innerWidth * 0.8;
                let h = img.naturalHeight, w = img.naturalWidth;
                if (h > maxH) { w = (maxH / h) * w; h = maxH; }
                if (w > maxW) { h = (maxW / w) * h; w = maxW; }
                baseImgWidth = w;
                baseImgHeight = h;
                img.style.width = w + 'px';
                img.style.height = h + 'px';
                canvas.style.width = w + 'px';
                canvas.style.height = h + 'px';

                const ctx = canvas.getContext('2d');
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                if (lightboxDrawingsMap[imgSrc]) {
                    const savedImg = new Image();
                    savedImg.onload = () => { ctx.drawImage(savedImg, 0, 0); };
                    savedImg.src = lightboxDrawingsMap[imgSrc];
                }
            };
            document.getElementById('zoom-level-text').textContent = '100%';
            modal.classList.remove('hidden');
        }

        function closeLightbox() {
            document.getElementById('image-lightbox-modal').classList.add('hidden');
        }

        function zoomInImage(event) {
            event.stopPropagation();
            if (currentImageZoom < 4) { currentImageZoom = Math.round((currentImageZoom + 0.25) * 100) / 100; applyZoom(); }
        }

        function zoomOutImage(event) {
            event.stopPropagation();
            if (currentImageZoom > 0.4) { currentImageZoom = Math.round((currentImageZoom - 0.25) * 100) / 100; applyZoom(); }
        }

        function resetZoomImage(event) {
            event.stopPropagation();
            currentImageZoom = 1;
            applyZoom();
        }

        function applyZoom() {
            const img = document.getElementById('lightbox-img');
            const canvas = document.getElementById('lightbox-canvas');
            if (img && baseImgWidth > 0) {
                const w = baseImgWidth * currentImageZoom;
                const h = baseImgHeight * currentImageZoom;
                img.style.width = w + 'px';
                img.style.height = h + 'px';
                canvas.style.width = w + 'px';
                canvas.style.height = h + 'px';
                document.getElementById('zoom-level-text').textContent = `${Math.round(currentImageZoom * 100)}%`;
            }
        }

        function toggleDrawMode(event) {
            event.stopPropagation();
            isDrawMode = !isDrawMode;
            updateDrawModeButton();
        }

        function updateDrawModeButton() {
            const btn = document.getElementById('draw-mode-btn');
            const canvas = document.getElementById('lightbox-canvas');
            const container = document.getElementById('lightbox-scroll-container');
            if (isDrawMode) {
                btn.className = "w-24 py-1.5 bg-emerald-600 hover:bg-emerald-700 rounded-lg transition-colors text-xs font-bold flex items-center justify-center shadow";
                btn.textContent = "✏️ Đang vẽ";
                canvas.classList.remove('pointer-events-none');
                canvas.classList.add('pointer-events-auto');
                container.classList.remove('cursor-grab', 'active:cursor-grabbing');
                container.classList.add('cursor-crosshair');
            } else {
                btn.className = "w-24 py-1.5 bg-blue-600 hover:bg-blue-700 rounded-lg transition-colors text-xs font-bold flex items-center justify-center shadow";
                btn.textContent = "✏️ Vẽ";
                canvas.classList.add('pointer-events-none');
                canvas.classList.remove('pointer-events-auto');
                container.classList.add('cursor-grab', 'active:cursor-grabbing');
                container.classList.remove('cursor-crosshair');
            }
        }

        function clearDrawings(event) {
            event.stopPropagation();
            const canvas = document.getElementById('lightbox-canvas');
            const ctx = canvas.getContext('2d');
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            const img = document.getElementById('lightbox-img');
            if (img && img.src) delete lightboxDrawingsMap[img.src];
            showToast("Đã xóa toàn bộ nét vẽ tạm thời!");
        }

        function startLightboxPan(event) {
            if (isDrawMode) return;
            isLightboxPanning = true;
            const container = document.getElementById('lightbox-scroll-container');
            container.classList.add('cursor-grabbing');
            startPanX = event.clientX; startPanY = event.clientY;
            scrollLeftPos = container.scrollLeft; scrollTopPos = container.scrollTop;
        }

        function panLightbox(event) {
            if (!isLightboxPanning || isDrawMode) return;
            const container = document.getElementById('lightbox-scroll-container');
            const dx = event.clientX - startPanX;
            const dy = event.clientY - startPanY;
            container.scrollLeft = scrollLeftPos - dx; container.scrollTop = scrollTopPos - dy;
        }

        function stopLightboxPan() {
            isLightboxPanning = false;
            const container = document.getElementById('lightbox-scroll-container');
            if (container) container.classList.remove('cursor-grabbing');
        }

        function startDrawing(event) {
            if (!isDrawMode) return;
            isDrawing = true;
            const canvas = document.getElementById('lightbox-canvas');
            const rect = canvas.getBoundingClientRect();
            lastDrawX = (event.clientX - rect.left) * (canvas.width / rect.width);
            lastDrawY = (event.clientY - rect.top) * (canvas.height / rect.height);
        }

        function drawOnCanvas(event) {
            if (!isDrawing || !isDrawMode) return;
            const canvas = document.getElementById('lightbox-canvas');
            const img = document.getElementById('lightbox-img');
            const rect = canvas.getBoundingClientRect();
            const currentX = (event.clientX - rect.left) * (canvas.width / rect.width);
            const currentY = (event.clientY - rect.top) * (canvas.height / rect.height);

            const ctx = canvas.getContext('2d');
            ctx.beginPath();
            ctx.moveTo(lastDrawX, lastDrawY);
            ctx.lineTo(currentX, currentY);
            ctx.strokeStyle = '#ef4444';
            ctx.lineWidth = Math.max(3, 4 * (canvas.width / (img.naturalWidth || 1000)));
            ctx.lineCap = 'round'; ctx.lineJoin = 'round';
            ctx.stroke();

            lastDrawX = currentX; lastDrawY = currentY;
            if (img && img.src) lightboxDrawingsMap[img.src] = canvas.toDataURL();
        }

        function stopDrawing(event) {
            if (!isDrawing) return;
            isDrawing = false;
            const canvas = document.getElementById('lightbox-canvas');
            const img = document.getElementById('lightbox-img');
            if (img && img.src) lightboxDrawingsMap[img.src] = canvas.toDataURL();
        }

        const DEFAULT_COVER_IMAGE = "images/img_001.jpg";

        async function initApp() {
            await kv.init();
            migrateOldQuizzesFolder();
            try { const _q = getSavedQuizzes(); if (stripImportMarks(_q)) kv.setItem('quizAppSavedQuizzes', JSON.stringify(_q)); } catch (e) {}
            renderSavedQuizzes();
            loadCoverImage();
            applyDevModeUI();
            try { await autoImportFromFolder(); } catch (e) { console.error(e); }
            try { await autoImportJsonFolder(); } catch (e) { console.error(e); }
        }

        const DEV_MODE_PASSWORD = "923564";
        const DEV_ACTIVATE_CLICKS = 7;
        const DEV_CLICK_RESET_MS = 2500;
        let coverClickCount = 0;
        let coverClickTimer = null;

        function getDevMode() {
            return kv.getItem('quizAppDevMode') === 'true';
        }

        function applyDevModeUI() {
            const isDev = getDevMode();
            document.body.classList.toggle('dev-mode-off', !isDev);
        }

        function handleCoverImageClick() {
            coverClickCount++;
            clearTimeout(coverClickTimer);
            coverClickTimer = setTimeout(() => { coverClickCount = 0; }, DEV_CLICK_RESET_MS);

            if (coverClickCount >= DEV_ACTIVATE_CLICKS) {
                coverClickCount = 0;
                clearTimeout(coverClickTimer);
                if (getDevMode()) {
                    kv.setItem('quizAppDevMode', 'false');
                    applyDevModeUI();
                    showToast("Đã chuyển về phiên bản Người dùng!");
                } else {
                    openDevPasswordModal();
                }
            }
        }

        function openDevPasswordModal() {
            document.getElementById('dev-password-error').classList.add('hidden');
            const input = document.getElementById('dev-password-input');
            input.value = '';
            document.getElementById('dev-password-modal').classList.remove('hidden');
            setTimeout(() => input.focus(), 50);
        }

        function closeDevPasswordModal() {
            document.getElementById('dev-password-modal').classList.add('hidden');
        }

        function submitDevPassword() {
            const pass = document.getElementById('dev-password-input').value;
            if (pass === DEV_MODE_PASSWORD) {
                kv.setItem('quizAppDevMode', 'true');
                applyDevModeUI();
                closeDevPasswordModal();
                showToast("Đã bật Chế độ Nhà phát triển!");
            } else {
                document.getElementById('dev-password-error').classList.remove('hidden');
                document.getElementById('dev-password-input').value = '';
                document.getElementById('dev-password-input').focus();
            }
        }

        function loadManifestViaScript() {
            return new Promise(resolve => {
                try { delete window.QUIZ_IMPORT_DATA; } catch (e) { window.QUIZ_IMPORT_DATA = undefined; }
                document.querySelectorAll('script[data-quiz-manifest]').forEach(el => el.remove());

                const load = (src, onFail) => {
                    const s = document.createElement('script');
                    s.setAttribute('data-quiz-manifest', '1');
                    s.src = src;
                    s.onload = () => resolve(window.QUIZ_IMPORT_DATA || null);
                    s.onerror = () => { s.remove(); onFail(); };
                    document.head.appendChild(s);
                };
                load('import-manifest.js?_=' + Date.now(), () => load('import-manifest.js', () => resolve(null)));
            });
        }

        async function readManifestData() {
            const isFileProtocol = location.protocol === 'file:';
            if (!isFileProtocol) {
                try {
                    const res = await fetch('import-manifest.json?_=' + Date.now(), { cache: 'no-store' });
                    if (res.ok) return { data: await res.json(), via: 'import-manifest.json' };
                } catch (err) {}
            }
            const scriptData = await loadManifestViaScript();
            if (scriptData) return { data: scriptData, via: 'import-manifest.js' };
            return null;
        }

        function mergeImportedItems(combinedArray) {
            let quizzes = getSavedQuizzes();
            const localIndex = new Map(quizzes.map((q, i) => [q.id, i]));
            const seenIds = new Set();
            const newOnes = [];
            let addedCount = 0, updatedCount = 0;

            combinedArray.forEach(item => {
                if (!(item && item.name && item.questions)) return;
                if (item.id !== undefined) {
                    if (seenIds.has(item.id)) return;
                    seenIds.add(item.id);
                }
                if (!item.folder) item.folder = item.isExam ? "Thi Thử" : "Chung";
                item.folder = String(item.folder).trim().replace(/\s*\/\s*/g, '/');

                if (item.id !== undefined && localIndex.has(item.id)) {
                    const idx = localIndex.get(item.id);
                    const old = quizzes[idx];
                    const merged = Object.assign({}, item);
                    if (old && old.bestResult) merged.bestResult = old.bestResult;
                    if (JSON.stringify(merged) !== JSON.stringify(old)) {
                        quizzes[idx] = merged;
                        updatedCount++;
                    }
                } else {
                    if (item.id === undefined) item.id = Date.now() + Math.floor(Math.random() * 10000);
                    newOnes.unshift(item);
                    addedCount++;
                }
            });

            if (addedCount > 0 || updatedCount > 0) {
                quizzes = newOnes.concat(quizzes);
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                loadCoverImage();
                renderSavedQuizzes();
            }
            return { addedCount, updatedCount };
        }

        async function autoImportFromFolder(manual = false) {
            const result = await readManifestData();
            if (!result) {
                if (manual) showToast(location.protocol === 'file:' ? "Chạy offline cần file import-manifest.js!" : "Không tìm thấy import-manifest.json!");
                return;
            }
            const parsed = result.data;
            if (!parsed) return;

            if (parsed.coverImage) kv.setItem('quizAppCoverImage', parsed.coverImage);
            let qArray = parsed.quizzes ? parsed.quizzes : (Array.isArray(parsed) ? parsed : null);
            if (!Array.isArray(qArray)) qArray = [];
            const examArray = Array.isArray(parsed.exams) ? parsed.exams : [];
            const combinedArray = qArray.concat(examArray.map(item => Object.assign({}, item, { isExam: true })));

            const r = mergeImportedItems(combinedArray);
            if (r.addedCount > 0 || r.updatedCount > 0) showToast(`Đã cập nhật dữ liệu tự động từ thư mục!`);
        }

        /* ===== TỰ NẠP BỘ ĐỀ TỪ THƯ MỤC "JSON" (cùng cấp với index.html) =====
           Lấy danh sách file bằng: (1) JSON/index.json = ["a.json","b.json"] hoặc {"files":[...]},
           (2) trang liệt kê thư mục của server (python -m http.server, nginx/apache autoindex...).
           Cần chạy qua http/https; mở trực tiếp file:// trình duyệt sẽ chặn đọc file. */
        const JSON_FOLDER = 'JSON';
        const GITHUB_REPO = ''; // tuỳ chọn: 'tenuser/tenrepo' nếu dùng tên miền riêng

        function stableIdFromText(str) {
            let h = 5381;
            for (let i = 0; i < str.length; i++) h = ((h << 5) + h + str.charCodeAt(i)) | 0;
            return 9000000000000 + (Math.abs(h) % 900000000000);
        }

        async function listJsonFolderFiles() {
            const names = new Set();
            try {
                const r = await fetch(JSON_FOLDER + '/index.json?_=' + Date.now(), { cache: 'no-store' });
                if (r.ok) {
                    const j = await r.json();
                    (Array.isArray(j) ? j : (j && j.files) || []).forEach(n => { if (typeof n === 'string') names.add(n); });
                }
            } catch (e) {}
            try {
                const r = await fetch(JSON_FOLDER + '/', { cache: 'no-store' });
                if (r.ok && /html/i.test(r.headers.get('content-type') || '')) {
                    const doc = new DOMParser().parseFromString(await r.text(), 'text/html');
                    doc.querySelectorAll('a[href]').forEach(a => {
                        let h = (a.getAttribute('href') || '').split('#')[0].split('?')[0];
                        if (!/\.json$/i.test(h)) return;
                        try { h = decodeURIComponent(h); } catch (e) {}
                        names.add(h.replace(/^.*\//, ''));
                    });
                }
            } catch (e) {}
            // GitHub Pages không liệt kê thư mục -> hỏi GitHub API (repo công khai, không cần token)
            try {
                const cands = [];
                if (typeof GITHUB_REPO === 'string' && GITHUB_REPO) cands.push(GITHUB_REPO);
                else if (/\.github\.io$/i.test(location.hostname)) {
                    const owner = location.hostname.split('.')[0];
                    const seg = location.pathname.split('/').filter(Boolean)[0];
                    if (seg && !/\./.test(seg)) cands.push(owner + '/' + decodeURIComponent(seg));
                    cands.push(owner + '/' + location.hostname);
                }
                for (const repo of cands) {
                    const r = await fetch('https://api.github.com/repos/' + repo + '/contents/' + JSON_FOLDER, { headers: { 'Accept': 'application/vnd.github+json' } });
                    if (!r.ok) { console.warn('[JSON] GitHub API', repo, r.status); continue; }
                    const arr = await r.json();
                    if (Array.isArray(arr)) arr.forEach(f => { if (f && f.type === 'file' && /\.json$/i.test(f.name)) names.add(f.name); });
                    break;
                }
            } catch (e) { console.warn('[JSON] GitHub API lỗi', e); }
            names.delete('index.json');
            return Array.from(names).filter(n => /\.json$/i.test(n)).sort((x, y) => x.localeCompare(y, 'vi', { numeric: true }));
        }

        function normalizeJsonFolderData(parsed, fileName) {
            const base = fileName.replace(/\.json$/i, '');
            const out = [];
            const push = (o, isExam) => {
                if (!o || typeof o !== 'object' || !Array.isArray(o.questions)) return;
                const it = Object.assign({}, o);
                if (!it.name) it.name = base;
                if (isExam) it.isExam = true;
                if (it.id === undefined) it.id = stableIdFromText(String(it.folder || '') + '|' + it.name + '|' + fileName);
                out.push(it);
            };
            if (Array.isArray(parsed)) {
                if (parsed.length && parsed[0] && parsed[0].question !== undefined && parsed[0].options) push({ name: base, questions: parsed });
                else parsed.forEach(o => push(o));
            } else if (parsed && typeof parsed === 'object') {
                if (parsed.coverImage) kv.setItem('quizAppCoverImage', parsed.coverImage);
                if (Array.isArray(parsed.quizzes)) parsed.quizzes.forEach(o => push(o));
                if (Array.isArray(parsed.exams)) parsed.exams.forEach(o => push(o, true));
                if (Array.isArray(parsed.questions)) push(parsed);
            }
            return out;
        }

        async function autoImportJsonFolder() {
            const names = await listJsonFolderFiles();
            if (!names.length) return;
            const perFile = await Promise.all(names.map(async name => {
                try {
                    const r = await fetch(JSON_FOLDER + '/' + encodeURIComponent(name) + '?_=' + Date.now(), { cache: 'no-store' });
                    if (!r.ok) return [];
                    const text = (await r.text()).replace(/^\uFEFF/, '');
                    return normalizeJsonFolderData(JSON.parse(text), name);
                } catch (err) {
                    console.error('Lỗi nạp file JSON:', name, err);
                    return [];
                }
            }));
            const r = mergeImportedItems([].concat(...perFile));
            if (r.addedCount > 0 || r.updatedCount > 0) {
                showToast(`Thư mục JSON: thêm ${r.addedCount}, cập nhật ${r.updatedCount} bộ đề!`);
            }
        }

        function loadCoverImage() {
            const imgEl = document.getElementById('app-cover-img');
            if (imgEl) {
                imgEl.onerror = function() { this.onerror = null; };
                imgEl.src = DEFAULT_COVER_IMAGE;
            }
        }

        function migrateOldQuizzesFolder() {
            const quizzes = getSavedQuizzes();
            let updated = false;
            quizzes.forEach(q => {
                if (!q.folder) { q.folder = "Chung"; updated = true; }
                else q.folder = q.folder.trim().replace(/\s*\/\s*/g, '/');
            });
            if (updated) kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
        }

        function getCustomFolders() {
            const saved = kv.getItem('quizAppCustomFolders');
            return saved ? JSON.parse(saved) : [];
        }

        function saveCustomFolders(folders) {
            kv.setItem('quizAppCustomFolders', JSON.stringify(folders));
        }

        function getAllFolders() {
            const quizzes = getRegularQuizzes();
            const custom = getCustomFolders();
            const set = new Set(["Chung", ...custom]);
            quizzes.forEach(q => {
                if (q.folder) {
                    const parts = q.folder.split('/');
                    let currentPath = '';
                    parts.forEach(p => {
                        currentPath = currentPath ? currentPath + '/' + p : p;
                        set.add(currentPath);
                    });
                }
            });
            return Array.from(set).sort();
        }

        function getCleanQuestionText(qText) {
            if (!qText) return '';
            return qText.replace(/^(Câu|Bài)\s*\d+[:\.\-\s]?\s*/i, '').replace(/^[1-9]\d*[\.\)]\s*/, '').trim();
        }

        function formatExplanationWithLinks(text) {
            if (!text) return '';
            return String(text).split(/(https?:\/\/[^\s]+)/g).map((part, i) => i % 2
                ? `<a href="${part}" target="_blank" class="text-blue-600 underline font-semibold hover:text-blue-800" onclick="event.stopPropagation()">${part}</a>`
                : mathFmt(part, false)).join('');
        }

        /* ===== KÝ TỰ TOÁN HỌC CƠ BẢN =====
           Hỗ trợ: \alpha \leq \times \pi \to ..., \frac{a}{b}, \sqrt{x}, x^2, x^{n+1}, x_1, H_{2}O,
           $...$, và dạng gõ nhanh: <=  >=  !=  +-  +/-  ->  <-  =>  <=>  sqrt(x) */
        const MATH_SYMBOLS = {
            alpha:'α',beta:'β',gamma:'γ',delta:'δ',epsilon:'ε',varepsilon:'ε',zeta:'ζ',eta:'η',theta:'θ',kappa:'κ',lambda:'λ',mu:'μ',nu:'ν',xi:'ξ',pi:'π',rho:'ρ',sigma:'σ',tau:'τ',phi:'φ',varphi:'φ',chi:'χ',psi:'ψ',omega:'ω',
            Gamma:'Γ',Delta:'Δ',Theta:'Θ',Lambda:'Λ',Xi:'Ξ',Pi:'Π',Sigma:'Σ',Phi:'Φ',Psi:'Ψ',Omega:'Ω',
            times:'×',div:'÷',pm:'±',mp:'∓',cdot:'·',ast:'∗',
            leq:'≤',le:'≤',geq:'≥',ge:'≥',neq:'≠',ne:'≠',approx:'≈',equiv:'≡',sim:'∼',propto:'∝',ll:'≪',gg:'≫',
            infty:'∞',partial:'∂',nabla:'∇',sum:'∑',prod:'∏',int:'∫',
            to:'→',rightarrow:'→',leftarrow:'←',leftrightarrow:'↔',uparrow:'↑',downarrow:'↓',Rightarrow:'⇒',Leftarrow:'⇐',Leftrightarrow:'⇔',implies:'⇒',iff:'⇔',
            in:'∈',notin:'∉',subset:'⊂',subseteq:'⊆',supset:'⊃',cup:'∪',cap:'∩',emptyset:'∅',varnothing:'∅',
            forall:'∀',exists:'∃',neg:'¬',land:'∧',lor:'∨',angle:'∠',perp:'⊥',parallel:'∥',triangle:'△',
            therefore:'∴',because:'∵',ldots:'…',dots:'…',cdots:'⋯',prime:'′',degree:'°',circ:'°',
            micro:'µ',permil:'‰',hbar:'ℏ'
        };
        function mathFmt(text, escape = true) {
            let t = String(text == null ? '' : text);
            if (escape) t = t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
            const LT = '(?:&lt;|<)', GT = '(?:&gt;|>)';
            // bỏ dấu bao công thức: $...$, \(...\), \[...\]
            t = t.replace(/(^|[^\w$\\])\$([^$\n]+?)\$(?![\w$])/g, (m, pre, inner) => pre + inner.trim());
            t = t.replace(/\\[()\[\]]/g, '');
            // phân số, căn, text
            t = t.replace(/\\[dt]?frac\s*\{([^{}]*)\}\s*\{([^{}]*)\}/g, (m, a, b) => {
                const w = x => /^[\w.,]+$/.test(x) ? x : '(' + x + ')';
                return w(a) + '/' + w(b);
            });
            t = t.replace(/\\sqrt\s*\[(\d+)\]\s*\{([^{}]*)\}/g, (m, n, x) => `<sup>${n}</sup>√(${x})`);
            t = t.replace(/\\sqrt\s*\{([^{}]*)\}/g, (m, x) => /^[\w.]+$/.test(x) ? '√' + x : '√(' + x + ')');
            t = t.replace(/\bsqrt\(/g, '√(');
            // độ: ^\circ, ^{\circ}
            t = t.replace(/\^\s*\{?\s*\\circ\s*\}?/g, '°');
            // lệnh ký hiệu \alpha, \leq ...
            t = t.replace(/\\([A-Za-z]+)/g, (m, name) => MATH_SYMBOLS[name] !== undefined ? MATH_SYMBOLS[name] : (/^(left|right|quad|qquad|displaystyle|limits)$/.test(name) ? '' : m));
            t = t.replace(/\\(?:text|mathrm|mathbf|textbf|operatorname)\s*\{([^{}]*)\}/g, '$1');
            t = t.replace(/\\[,;:! ]/g, ' ').replace(/\\%/g, '%');
            // số mũ / chỉ số dưới
            t = t.replace(/\^\{([^{}]*)\}/g, '<sup>$1</sup>');
            t = t.replace(/\^\(([^()]*)\)/g, '<sup>$1</sup>');
            t = t.replace(/\^([+\-−]?\d+|[A-Za-z])/g, '<sup>$1</sup>');
            t = t.replace(/_\{([^{}]*)\}/g, '<sub>$1</sub>');
            t = t.replace(/([A-Za-z0-9)\]])_(\d+)/g, '$1<sub>$2</sub>');
            // gõ nhanh ký hiệu
            t = t.replace(new RegExp(LT + '=' + GT, 'g'), '⇔')
                 .replace(new RegExp(LT + '-' + GT, 'g'), '↔')
                 .replace(new RegExp(LT + '=', 'g'), '≤')
                 .replace(new RegExp(GT + '=', 'g'), '≥')
                 .replace(new RegExp('=' + GT, 'g'), '⇒')
                 .replace(new RegExp('-' + GT, 'g'), '→')
                 .replace(new RegExp(LT + '-(?=\\s|$)', 'g'), '←')
                 .replace(/!=/g, '≠')
                 .replace(/\+\/-|\+-/g, '±');
            return t.replace(/\r?\n/g, '<br>');
        }

        /* ===== NHẬP TỪ FILE .md =====
           Chuyển Markdown về văn bản thường để parseTextToQuestions đọc được:
           bỏ #, >, bullet (-, *, +), **đậm**, *nghiêng*, `code`, khung ```, đường kẻ --- */
        function mdToQuizText(md) {
            const out = [];
            String(md || '').replace(/^\uFEFF/, '').replace(/\r\n?/g, '\n').split('\n').forEach(raw => {
                let l = raw;
                if (/^\s*(```|~~~)/.test(l)) return;
                if (/^\s{0,3}([-*_])(\s*\1){2,}\s*$/.test(l)) return;
                l = l.replace(/^\s{0,3}#{1,6}\s*/, '').replace(/^\s*>+\s?/, '');
                l = l.replace(/^\s*[-*+]\s+(?:\[[ xX]\]\s+)?/, '• ');
                l = l.replace(/\*\*|__|~~|`/g, '');
                l = l.replace(/(^|\s)\*([^\s*](?:[^*\n]*?[^\s*])?)\*(?=\s|$|[.,;:!?)])/g, '$1$2');
                l = l.replace(/\\([*_#])/g, '$1');
                l = l.replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '$1 ($2)');
                out.push(l.trimEnd());
            });
            return out.join('\n').replace(/\n{3,}/g, '\n\n');
        }
        const SUP_MAP = {'0':'⁰','1':'¹','2':'²','3':'³','4':'⁴','5':'⁵','6':'⁶','7':'⁷','8':'⁸','9':'⁹','+':'⁺','-':'⁻','−':'⁻','=':'⁼','(':'⁽',')':'⁾','n':'ⁿ','i':'ⁱ'};
        const SUB_MAP = {'0':'₀','1':'₁','2':'₂','3':'₃','4':'₄','5':'₅','6':'₆','7':'₇','8':'₈','9':'₉','+':'₊','-':'₋','−':'₋','=':'₌','(':'₍',')':'₎','a':'ₐ','e':'ₑ','o':'ₒ','x':'ₓ','h':'ₕ','k':'ₖ','l':'ₗ','m':'ₘ','n':'ₙ','p':'ₚ','s':'ₛ','t':'ₜ'};
        function toScript(str, map) {
            let o = '';
            for (const ch of String(str).replace(/\s+/g, '')) { if (!(ch in map)) return null; o += map[ch]; }
            return o;
        }
        // Đổi công thức LaTeX (bên trong $...$) thành chữ Unicode thuần: Ca(OH)_2 -> Ca(OH)₂, 45^\circ -> 45°, \text{ mm} -> mm
        function latexToPlain(t) {
            t = t.replace(/\\[dt]?frac\s*\{([^{}]*)\}\s*\{([^{}]*)\}/g, (m, a, b) => {
                const w = x => /^[\w.,]+$/.test(x) ? x : '(' + x + ')';
                return w(a) + '/' + w(b);
            });
            t = t.replace(/\\sqrt\s*\[(\d+)\]\s*\{([^{}]*)\}/g, (m, n, x) => (toScript(n, SUP_MAP) || n) + '√(' + x + ')');
            t = t.replace(/\\sqrt\s*\{([^{}]*)\}/g, (m, x) => /^[\w.]+$/.test(x) ? '√' + x : '√(' + x + ')');
            t = t.replace(/\^\s*\{?\s*\\circ\s*\}?/g, '°');
            t = t.replace(/\\([A-Za-z]+)/g, (m, n) => MATH_SYMBOLS[n] !== undefined ? MATH_SYMBOLS[n] : (/^(left|right|quad|qquad|displaystyle|limits)$/.test(n) ? '' : m));
            t = t.replace(/\\(?:text|mathrm|mathbf|textbf|operatorname)\s*\{([^{}]*)\}/g, '$1');
            t = t.replace(/\\[,;:! ]/g, ' ').replace(/\\%/g, '%');
            t = t.replace(/\^\{([^{}]*)\}/g, (m, x) => toScript(x, SUP_MAP) || m);
            t = t.replace(/\^([+\-−]?\d+|[A-Za-z])/g, (m, x) => toScript(x, SUP_MAP) || m);
            t = t.replace(/_\{([^{}]*)\}/g, (m, x) => toScript(x, SUB_MAP) || m);
            t = t.replace(/([A-Za-z0-9)\]])_(\d+)/g, (m, a, x) => a + toScript(x, SUB_MAP));
            return t.replace(/[ \t]{2,}/g, ' ');
        }
        function mathToPlain(text) {
            let t = String(text == null ? '' : text);
            if (t.indexOf('\\') < 0 && t.indexOf('$') < 0) return t;
            t = t.replace(/(^|[^\w$\\])\$([^$\n]+?)\$(?![\w$])/g, (m, pre, inner) => pre + latexToPlain(inner.trim()));
            t = t.replace(/\\\(([^\n]*?)\\\)/g, (m, inner) => latexToPlain(inner.trim()));
            t = t.replace(/\\([A-Za-z]+)/g, (m, n) => MATH_SYMBOLS[n] !== undefined ? MATH_SYMBOLS[n] : m);
            return t;
        }
        function quizFileText(fileName, text) {
            return /\.(md|markdown)$/i.test(fileName) ? mdToQuizText(text) : text;
        }

        function getBlockedQuestions() {
            const saved = kv.getItem('quizAppBlockedQuestions');
            return saved ? JSON.parse(saved) : [];
        }

        function updateBlockedBadgeCount() {
            const list = getBlockedQuestions();
            const badge = document.getElementById('total-blocked-count');
            if (badge) badge.textContent = list.length;
        }

        function filterBlockedQuestions(qList) {
            const blocked = getBlockedQuestions();
            return (qList || []).filter(q => !q.isHidden && !blocked.some(b => getCleanQuestionText(b.question) === getCleanQuestionText(q.question)));
        }

        function toggleBlockCurrent() {
            const q = questions[currentIndex];
            let blocked = getBlockedQuestions();
            const existingIndex = blocked.findIndex(item => getCleanQuestionText(item.question) === getCleanQuestionText(q.question));
            
            if (existingIndex > -1) {
                blocked.splice(existingIndex, 1);
                showToast("Đã bỏ chặn câu hỏi này!");
            } else {
                blocked.push({
                    question: getCleanQuestionText(q.question),
                    options: q.options,
                    answerStr: q.answerStr,
                    explanation: q.explanation,
                    images: q.images || [],
                    explanationImages: q.explanationImages || [],
                    quizName: currentQuizName
                });
                showToast("Đã chặn câu hỏi này!");
            }
            
            kv.setItem('quizAppBlockedQuestions', JSON.stringify(blocked));
            updateBlockedBadgeCount();
            updateBlockButtonState();

            questions.splice(currentIndex, 1);
            questionStates.splice(currentIndex, 1);
            if (questions.length === 0) {
                showToast("Tất cả câu hỏi trong bài đã bị chặn!");
                returnToHome();
            } else {
                if (currentIndex >= questions.length) currentIndex = questions.length - 1;
                loadQuestion();
            }
        }

        function updateBlockButtonState() {
            if (!questions[currentIndex]) return;
            const q = questions[currentIndex];
            const blocked = getBlockedQuestions();
            const isBlocked = blocked.some(item => getCleanQuestionText(item.question) === getCleanQuestionText(q.question));
            const icon = document.getElementById('block-icon');
            const text = document.getElementById('block-text');
            const btn = document.getElementById('block-quiz-btn');

            if (isBlocked) {
                icon.textContent = "🔓";
                text.textContent = "Bỏ chặn";
                btn.className = "text-rose-700 bg-rose-100 hover:bg-rose-200 py-1.5 px-3.5 rounded-full font-bold text-sm transition-colors border border-rose-400 flex items-center shadow-sm";
            } else {
                icon.textContent = "🚫";
                text.textContent = "Chặn câu";
                btn.className = "text-rose-700 bg-rose-50 hover:bg-rose-100 py-1.5 px-3.5 rounded-full font-bold text-sm transition-colors border border-rose-300 flex items-center shadow-sm";
            }
        }

        // ===== BÁO LỖI / GÓP Ý CÂU HỎI TRONG KHI LÀM BÀI =====
        const REPORT_ERROR_EMAIL = 'nhk9201@gmail.com';
        const REPORT_POSITIONS = ['Phần Câu Hỏi', 'Phần Trả Lời', 'Phần Giải Thích'];
        const REPORT_TAGS = [
            'Sai chính tả', 'Sai thuật ngữ', 'Sai kiến thức', 'Sai đáp án',
            'Gây nhầm lẫn', 'Manh mối quá cụ thể', 'Đáp án dễ đoán', 'Đáp án chưa gây nhiễu',
            'Thiếu giải thích', 'Giải thích chưa rõ', 'Câu hỏi mơ hồ', 'Lỗi hình ảnh', 'Trùng câu khác'
        ];
        let reportSelectedPositions = new Set();
        let reportSelectedTags = new Set();

        function openReportErrorModal() {
            if (!questions[currentIndex]) return;
            reportSelectedPositions = new Set();
            reportSelectedTags = new Set();
            document.getElementById('report-description').value = '';
            document.getElementById('report-reflink').value = '';
            document.getElementById('report-suggestion').value = '';
            renderReportChoiceGroup('report-position-group', REPORT_POSITIONS, reportSelectedPositions, toggleReportPosition);
            renderReportChoiceGroup('report-tag-group', REPORT_TAGS, reportSelectedTags, toggleReportTag);
            document.getElementById('report-error-modal').classList.remove('hidden');
        }

        function closeReportErrorModal() {
            document.getElementById('report-error-modal').classList.add('hidden');
        }

        function renderReportChoiceGroup(containerId, options, selectedSet, toggleFn) {
            const container = document.getElementById(containerId);
            container.innerHTML = '';
            options.forEach(opt => {
                const selected = selectedSet.has(opt);
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = opt;
                btn.onclick = () => toggleFn(opt);
                btn.className = 'text-xs sm:text-sm font-semibold py-1.5 px-3 rounded-full border transition-colors ' +
                    (selected ? 'bg-red-500 border-red-600 text-white shadow-sm' : 'bg-gray-50 border-gray-300 text-gray-700 hover:bg-red-50');
                container.appendChild(btn);
            });
        }

        function toggleReportPosition(opt) {
            if (reportSelectedPositions.has(opt)) reportSelectedPositions.delete(opt);
            else reportSelectedPositions.add(opt);
            renderReportChoiceGroup('report-position-group', REPORT_POSITIONS, reportSelectedPositions, toggleReportPosition);
        }

        function toggleReportTag(opt) {
            if (reportSelectedTags.has(opt)) reportSelectedTags.delete(opt);
            else reportSelectedTags.add(opt);
            renderReportChoiceGroup('report-tag-group', REPORT_TAGS, reportSelectedTags, toggleReportTag);
        }

        const REPORT_ERROR_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbwznIzSKLXXO5jTued4JigwC1nxBk_L9u5ZPhRxgfbDI267S97capQE3sdq4TpTeDzllQ/exec';

        function submitReportError() {
            const q = questions[currentIndex];
            if (!q) return;

            const referenceLink = document.getElementById('report-reflink').value.trim();
            const questionSuggestion = document.getElementById('report-suggestion').value.trim();
            const description = document.getElementById('report-description').value.trim();

            if (!referenceLink && !questionSuggestion && reportSelectedPositions.size === 0 && reportSelectedTags.size === 0 && !description) {
                showToast("Vui lòng nhập ít nhất một nội dung trước khi gửi!");
                return;
            }
            const topicNum = (typeof getQuizTopic === 'function' && currentQuizId != null)
                ? (() => { const quiz = getSavedQuizzes().find(qq => qq.id === currentQuizId); return quiz ? getQuizTopic(quiz) : 0; })() : 0;
            const fallbackTopicLabel = topicNum > 0 ? topicFullName(topicNum) : (currentQuizName || 'Không rõ');

            const srcQuizName = q.__srcQuizName || currentQuizName || 'Không rõ';
            const srcTopicLabel = q.__srcTopicLabel || fallbackTopicLabel;
            const displayQuizName = (srcQuizName && srcQuizName !== currentQuizName) ? `${srcQuizName} (phiên ôn tập: ${currentQuizName})` : srcQuizName;

            const payload = {
                quizName: displayQuizName,
                topicLabel: srcTopicLabel,
                questionIndex: currentIndex + 1,
                totalQuestions: questions.length,
                referenceLink: referenceLink,
                questionSuggestion: questionSuggestion,
                positions: Array.from(reportSelectedPositions).join(', '),
                tags: reportSelectedTags.size > 0 ? Array.from(reportSelectedTags).join(', ') : '',
                description: description,
                questionText: getCleanQuestionText(q.question),
                options: q.options || [],
                answerStr: q.answerStr || '',
                explanation: q.explanation || ''
            };

            const sendBtn = document.querySelector('#report-error-modal button[onclick="submitReportError()"]');
            if (sendBtn) { sendBtn.disabled = true; sendBtn.textContent = '⏳ Đang gửi...'; }

            fetch(REPORT_ERROR_WEBAPP_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(payload)
            }).then(() => {
                closeReportErrorModal();
                showToast("✅ Đã gửi báo lỗi, cảm ơn bạn đã đóng góp!");
            }).catch(() => {
                closeReportErrorModal();
                showToast("⚠️ Gửi báo lỗi thất bại, vui lòng kiểm tra kết nối mạng!");
            }).finally(() => {
                if (sendBtn) { sendBtn.disabled = false; sendBtn.textContent = '📧 Gửi'; }
            });
        }

        // ===== ĐỀ XUẤT CÂU HỎI MỚI =====
        const SUGGEST_QUESTION_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbyxvjPh0wIEyDQMlBf8CtHt5umcU3ezeq8x3elvU2iDAGTU3NVePi0kGIA0H8m7zjRmKw/exec';

        function openSuggestQuestionModal() {
            const sel = document.getElementById('suggest-q-topic-select');
            if (sel) {
                sel.innerHTML = '<option value="">-- Chọn phân chủ đề (Tùy chọn) --</option>';
                for (let n = 1; n <= TOPIC_COUNT; n++) {
                    const opt = document.createElement('option');
                    opt.value = (n === 37) ? "Thi Thử" : topicFullName(n);
                    opt.textContent = (n === 37) ? "🎯 Thi Thử" : `📁 ${topicFullName(n)}`;
                    sel.appendChild(opt);
                }
            }
            document.getElementById('suggest-question-modal').classList.remove('hidden');
        }

        function closeSuggestQuestionModal() {
            document.getElementById('suggest-question-modal').classList.add('hidden');
        }

        function submitSuggestQuestion() {
            const bundleLink = document.getElementById('suggest-q-bundle-link') ? document.getElementById('suggest-q-bundle-link').value.trim() : '';
            const topic = document.getElementById('suggest-q-topic-select').value;
            const questionText = document.getElementById('suggest-q-text').value.trim();
            const optA = document.getElementById('suggest-q-opt-a').value.trim();
            const optB = document.getElementById('suggest-q-opt-b').value.trim();
            const optC = document.getElementById('suggest-q-opt-c').value.trim();
            const optD = document.getElementById('suggest-q-opt-d').value.trim();
            const correct = document.getElementById('suggest-q-correct').value;
            const author = document.getElementById('suggest-q-author').value.trim() || 'Người dùng ẩn danh';
            const notes = document.getElementById('suggest-q-notes').value.trim();
            const explanation = document.getElementById('suggest-q-explanation').value.trim();
            const qImgs = document.getElementById('suggest-q-img-urls').value.split('\n').map(s => s.trim()).filter(Boolean);
            const expImgs = document.getElementById('suggest-q-exp-img-urls').value.split('\n').map(s => s.trim()).filter(Boolean);

            if (!bundleLink && !questionText && !optA && !optB && !optC && !optD && !notes && !explanation && qImgs.length === 0 && expImgs.length === 0) {
                showToast("Vui lòng nhập nội dung câu hỏi hoặc dán link bộ câu hỏi / tài liệu!");
                return;
            }

            const options = [];
            if (optA) options.push(`A. ${optA}`);
            if (optB) options.push(`B. ${optB}`);
            if (optC) options.push(`C. ${optC}`);
            if (optD) options.push(`D. ${optD}`);

            const payload = {
                topic: topic || 'Chưa phân chủ đề',
                bundleLink: bundleLink,
                contributorName: author,
                questionText: questionText,
                options: options,
                answerStr: correct,
                notes: notes,
                explanation: explanation,
                questionImageUrls: qImgs,
                explanationImageUrls: expImgs
            };

            const btn = document.getElementById('btn-submit-suggest-q');
            if (btn) { btn.disabled = true; btn.textContent = '⏳ Đang gửi...'; }

            fetch(SUGGEST_QUESTION_WEBAPP_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(payload)
            }).then(() => {
                closeSuggestQuestionModal();
                showToast("✅ Đã gửi đề xuất câu hỏi thành công, cảm ơn bạn!");
                if (document.getElementById('suggest-q-bundle-link')) document.getElementById('suggest-q-bundle-link').value = '';
                document.getElementById('suggest-q-text').value = '';
                document.getElementById('suggest-q-opt-a').value = '';
                document.getElementById('suggest-q-opt-b').value = '';
                document.getElementById('suggest-q-opt-c').value = '';
                document.getElementById('suggest-q-opt-d').value = '';
                document.getElementById('suggest-q-notes').value = '';
                document.getElementById('suggest-q-explanation').value = '';
                document.getElementById('suggest-q-img-urls').value = '';
                document.getElementById('suggest-q-exp-img-urls').value = '';
            }).catch(() => {
                closeSuggestQuestionModal();
                showToast("⚠️ Gửi đề xuất thất bại, vui lòng kiểm tra kết nối mạng!");
            }).finally(() => {
                if (btn) { btn.disabled = false; btn.textContent = '🚀 Gửi đề xuất'; }
            });
        }

        // ===== GÓP Ý / LIÊN HỆ TÁC GIẢ =====
        const APP_FEEDBACK_WEBAPP_URL = 'https://script.google.com/macros/s/AKfycbxLcbHQS_VviMXAbk01MiQTgISWGBGkOsvFmVbHnuIBx8Q8AwH9gCmEWQP1Jy4psF-PUQ/exec';

        function openAppFeedbackModal() {
            document.getElementById('app-feedback-modal').classList.remove('hidden');
        }

        function closeAppFeedbackModal() {
            document.getElementById('app-feedback-modal').classList.add('hidden');
        }

        function submitAppFeedback() {
            const type = document.getElementById('app-fb-type').value;
            const title = document.getElementById('app-fb-title').value.trim();
            const content = document.getElementById('app-fb-content').value.trim();
            const sender = document.getElementById('app-fb-sender').value.trim() || 'Người dùng ẩn danh';
            const contact = document.getElementById('app-fb-contact').value.trim();

            if (!title && !content && !contact) {
                showToast("Vui lòng nhập nội dung góp ý hoặc thông tin liên hệ!");
                return;
            }

            const payload = {
                type: type || 'Góp ý chung',
                title: title || '(Không có tiêu đề)',
                content: content || '(Không có nội dung mô tả)',
                sender: sender,
                contact: contact || 'Không để lại thông tin liên hệ',
                userAgent: navigator.userAgent || 'Không rõ',
                screenRes: `${window.innerWidth}x${window.innerHeight} (Màn hình: ${window.screen.width}x${window.screen.height})`
            };

            const btn = document.getElementById('btn-submit-app-fb');
            if (btn) { btn.disabled = true; btn.textContent = '⏳ Đang gửi...'; }

            fetch(APP_FEEDBACK_WEBAPP_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                body: JSON.stringify(payload)
            }).then(() => {
                closeAppFeedbackModal();
                showToast("✅ Đã gửi phản hồi thành công, cảm ơn bạn đã đóng góp!");
                document.getElementById('app-fb-title').value = '';
                document.getElementById('app-fb-content').value = '';
            }).catch(() => {
                closeAppFeedbackModal();
                showToast("⚠️ Gửi phản hồi thất bại, vui lòng kiểm tra kết nối mạng!");
            }).finally(() => {
                if (btn) { btn.disabled = false; btn.textContent = '📧 Gửi phản hồi'; }
            });
        }
// ========== [HẾT PHẦN 1] GHÉP TIẾP PHẦN 2 NGAY TẠI DÒNG TIẾP THEO ==========
        const MOCK_SESSION_ID = '__mock_exam__';
        const DEEP_SESSION_ID = '__deep_review__';

        function openBlockedModal() {
            const blocked = getBlockedQuestions();
            document.getElementById('modal-bl-count').textContent = blocked.length;
            const container = document.getElementById('blocked-list-container');
            
            if (blocked.length === 0) {
                container.innerHTML = '<p class="text-gray-500 italic text-center py-8">Chưa có câu hỏi nào bị chặn.</p>';
            } else {
                container.innerHTML = '';
                blocked.forEach((item, idx) => {
                    let imgsHtml = '';
                    if (item.images && item.images.length > 0) {
                        imgsHtml = '<div class="flex flex-wrap gap-2 my-2">';
                        item.images.forEach(img => {
                            imgsHtml += `<img src="${img}" onclick="openLightbox('${img}')" class="cursor-pointer hover:opacity-90" style="max-height: 120px; border-radius: 6px; border: 1px solid #ddd;" />`;
                        });
                        imgsHtml += '</div>';
                    }

                    let expImgsHtml = '';
                    if (item.explanationImages && item.explanationImages.length > 0) {
                        expImgsHtml = '<div class="flex flex-wrap gap-2 my-2">';
                        item.explanationImages.forEach(img => {
                            expImgsHtml += `<img src="${img}" onclick="openLightbox('${img}')" class="cursor-pointer hover:opacity-90" style="max-height: 100px; border-radius: 6px; border: 1px solid #ddd;" />`;
                        });
                        expImgsHtml += '</div>';
                    }

                    let optionsHtml = '<ul class="text-sm space-y-1.5 my-2 bg-white p-3 rounded-xl border">';
                    item.options.forEach(opt => {
                        const isCorrectOpt = opt.charAt(0).toUpperCase() === item.answerStr;
                        optionsHtml += `<li class="${isCorrectOpt ? 'font-bold text-green-600' : 'text-gray-700'}">${mathFmt(opt)}</li>`;
                    });
                    optionsHtml += '</ul>';

                    const div = document.createElement('div');
                    div.className = 'bg-rose-50/60 border border-rose-200 p-4 rounded-xl relative';
                    div.innerHTML = `
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-xs font-bold text-rose-800 bg-rose-100 px-2.5 py-1 rounded">Nguồn: ${item.quizName || 'Không rõ'}</span>
                            <button onclick="removeBlocked(${idx})" class="text-emerald-600 hover:text-emerald-800 text-sm font-bold flex items-center">🔓 Bỏ chặn</button>
                        </div>
                        <p class="font-bold text-gray-800 mb-1">Câu: ${mathFmt(getCleanQuestionText(item.question))}</p>
                        ${imgsHtml}
                        ${optionsHtml}
                        <p class="text-sm font-semibold text-green-700">Đáp án đúng: ${item.answerStr}</p>
                        ${item.explanation ? `<p class="text-xs text-gray-600 italic mt-1">Giải thích: ${formatExplanationWithLinks(item.explanation)}</p>` : ''}
                        ${expImgsHtml}
                    `;
                    container.appendChild(div);
                });
            }
            document.getElementById('blocked-modal').classList.remove('hidden');
        }

        function closeBlockedModal() {
            document.getElementById('blocked-modal').classList.add('hidden');
        }

        function removeBlocked(idx) {
            let blocked = getBlockedQuestions();
            blocked.splice(idx, 1);
            kv.setItem('quizAppBlockedQuestions', JSON.stringify(blocked));
            updateBlockedBadgeCount();
            openBlockedModal();
            updateBlockButtonState();
        }

        function openFolderModal() {
            const folders = getAllFolders();
            const quizzes = getRegularQuizzes();

            const container = document.getElementById('folder-modal-body');
            container.innerHTML = `
                <div class="space-y-3 bg-blue-50 p-3.5 rounded-xl border border-blue-100 mb-4">
                    <p class="text-xs font-bold text-blue-800">Thêm chủ đề mới hoặc chủ đề con:</p>
                    <div class="flex space-x-2">
                        <select id="parent-folder-select" class="p-2.5 border rounded-xl text-sm bg-white outline-none">
                            <option value="">-- Chủ đề gốc --</option>
                        </select>
                        <input type="text" id="new-folder-input" placeholder="Tên chủ đề..." class="flex-1 p-2.5 border rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none bg-white">
                        <button onclick="createNewSubFolder()" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2.5 rounded-xl text-sm transition-colors shadow-sm">➕ Tạo</button>
                    </div>
                </div>
                <div id="folder-tree-container" class="space-y-3"></div>
            `;

            const parentSelect = document.getElementById('parent-folder-select');
            folders.forEach(f => {
                const opt = document.createElement('option');
                opt.value = f;
                opt.textContent = f;
                parentSelect.appendChild(opt);
            });

            const itemsContainer = document.getElementById('folder-tree-container');
            
            folders.forEach(folder => {
                const folderQuizzes = quizzes.filter(q => (q.folder || "Chung") === folder);
                const depth = folder.split('/').length - 1;
                const indentClass = depth > 0 ? `ml-${Math.min(depth * 6, 12)} border-l-2 border-blue-200 pl-3` : '';

                let quizzesHtml = '';
                if (folderQuizzes.length === 0) {
                    quizzesHtml = '<p class="text-xs text-gray-400 italic py-1">Chưa có bộ đề nào.</p>';
                } else {
                    folderQuizzes.forEach(q => {
                        quizzesHtml += `
                            <div class="flex justify-between items-center bg-white p-2 rounded-lg border text-xs my-1 shadow-sm">
                                <span class="font-medium text-gray-700 truncate max-w-[280px]">${q.name}</span>
                                <button onclick="moveQuizToFolder(${q.id}, 'Chung')" class="text-red-500 hover:text-red-700 font-semibold px-2 py-1 bg-red-50 hover:bg-red-100 rounded transition-colors">🗑️ Gỡ ra</button>
                            </div>
                        `;
                    });
                }

                let availableQuizzes = quizzes.filter(q => (q.folder || "Chung") !== folder);
                let checkboxesHtml = '';
                if (availableQuizzes.length > 0) {
                    checkboxesHtml = `
                        <div class="border-t pt-2 mt-2 space-y-1.5">
                            <p class="text-xs font-bold text-gray-600 mb-1">Thêm bộ đề vào chủ đề này (có thể chọn nhiều):</p>
                            <div class="max-h-36 overflow-y-auto pr-1 space-y-1 bg-white p-2.5 rounded-xl border">
                    `;
                    availableQuizzes.forEach(q => {
                        checkboxesHtml += `
                            <label class="flex items-center space-x-2 text-xs p-1 hover:bg-gray-50 rounded cursor-pointer">
                                <input type="checkbox" value="${q.id}" class="folder-add-cb-${folder.replace(/[^a-zA-Z0-9]/g, '_')} w-3.5 h-3.5 text-blue-600 rounded">
                                <span class="truncate text-gray-700 font-medium">${q.name} <span class="text-gray-400">(hiện ở: ${q.folder || 'Chung'})</span></span>
                            </label>
                        `;
                    });
                    checkboxesHtml += `
                            </div>
                            <button onclick="addSelectedQuizzesToFolder('${folder}')" class="mt-1.5 w-full bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold py-2 px-3 rounded-xl transition-colors shadow-sm flex items-center justify-center">
                                ➕ Thêm các đề đã chọn vào chủ đề
                            </button>
                        </div>
                    `;
                }

                const div = document.createElement('div');
                div.className = `bg-gray-50 border p-3.5 rounded-xl space-y-2.5 ${indentClass}`;
                div.innerHTML = `
                    <div class="flex justify-between items-center">
                        <div>
                            <span class="font-bold text-gray-800 text-sm">📁 ${folder}</span>
                            <span class="text-xs text-gray-500 ml-2">(${folderQuizzes.length} bộ đề)</span>
                        </div>
                        <div class="flex space-x-1.5">
                            <button onclick="renameFolderPrompt('${folder}')" class="bg-amber-100 hover:bg-amber-200 text-amber-800 text-xs font-bold px-2.5 py-1.5 rounded-xl transition-colors">✏️ Đổi tên</button>
                            ${folder !== 'Chung' ? `<button onclick="deleteFolderPrompt('${folder}')" class="bg-red-100 hover:bg-red-200 text-red-700 text-xs font-bold px-2.5 py-1.5 rounded-xl transition-colors">🗑️ Xóa</button>` : ''}
                        </div>
                    </div>
                    
                    <div class="border-t pt-2 mt-2">
                        <p class="text-xs font-bold text-gray-600 mb-1">Bộ đề trong chủ đề:</p>
                        <div class="max-h-32 overflow-y-auto pr-1 space-y-1">${quizzesHtml}</div>
                    </div>

                    ${checkboxesHtml}
                `;
                itemsContainer.appendChild(div);
            });

            document.getElementById('folder-modal').classList.remove('hidden');
        }

        function closeFolderModal() {
            document.getElementById('folder-modal').classList.add('hidden');
        }

        function createNewSubFolder() {
            const parent = document.getElementById('parent-folder-select').value;
            const input = document.getElementById('new-folder-input');
            const name = input.value.trim().replace(/\s*\/\s*/g, '_');
            if (!name) {
                showToast("Vui lòng nhập tên chủ đề!");
                return;
            }
            const fullPath = parent ? parent + '/' + name : name;
            let custom = getCustomFolders();
            if (!custom.includes(fullPath)) {
                custom.push(fullPath);
                saveCustomFolders(custom);
            }
            input.value = '';
            openFolderModal();
            renderSavedQuizzes();
        }

        function moveQuizToFolder(quizId, targetFolder) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === quizId);
            if (quiz) {
                quiz.folder = targetFolder;
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                openFolderModal();
                renderSavedQuizzes();
            }
        }

        function addSelectedQuizzesToFolder(folderName) {
            const safeClass = folderName.replace(/[^a-zA-Z0-9]/g, '_');
            const checkboxes = document.querySelectorAll(`.folder-add-cb-${safeClass}:checked`);
            if (checkboxes.length === 0) {
                showToast("Vui lòng chọn ít nhất một bộ đề để thêm!");
                return;
            }
            const quizzes = getSavedQuizzes();
            let count = 0;
            checkboxes.forEach(cb => {
                const quizId = parseInt(cb.value);
                const quiz = quizzes.find(q => q.id === quizId);
                if (quiz) {
                    quiz.folder = folderName;
                    count++;
                }
            });
            if (count > 0) {
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                showToast(`Đã thêm thành công ${count} bộ đề vào chủ đề "${folderName}"!`);
                openFolderModal();
                renderSavedQuizzes();
            }
        }

        function renameFolderPrompt(oldName) {
            const newName = prompt(`Nhập tên mới cho chủ đề "${oldName}":`, oldName.split('/').pop());
            if (newName && newName.trim() !== "") {
                const cleanName = newName.trim().replace(/\s*\/\s*/g, '_');
                const parts = oldName.split('/');
                parts[parts.length - 1] = cleanName;
                const newPath = parts.join('/');

                const quizzes = getSavedQuizzes();
                quizzes.forEach(q => {
                    if (q.folder === oldName || q.folder.startsWith(oldName + '/')) {
                        q.folder = q.folder.replace(oldName, newPath);
                    }
                });
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));

                let custom = getCustomFolders();
                custom = custom.map(f => f === oldName || f.startsWith(oldName + '/') ? f.replace(oldName, newPath) : f);
                if (!custom.includes(newPath)) custom.push(newPath);
                saveCustomFolders(custom);

                if (currentFolderFilter === oldName || currentFolderFilter.startsWith(oldName + '/')) {
                    currentFolderFilter = currentFolderFilter.replace(oldName, newPath);
                }
                openFolderModal();
                renderSavedQuizzes();
            }
        }

        function deleteFolderPrompt(folderName) {
            if (confirm(`Bạn có chắc chắn muốn xóa chủ đề "${folderName}"? Các bộ đề bên trong sẽ được chuyển về "Chung".`)) {
                const quizzes = getSavedQuizzes();
                quizzes.forEach(q => {
                    if (q.folder === folderName || q.folder.startsWith(folderName + '/')) {
                        q.folder = "Chung";
                    }
                });
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                
                let custom = getCustomFolders();
                custom = custom.filter(f => f !== folderName && !f.startsWith(folderName + '/'));
                saveCustomFolders(custom);

                if (currentFolderFilter === folderName || currentFolderFilter.startsWith(folderName + '/')) {
                    currentFolderFilter = "ALL";
                }
                openFolderModal();
                renderSavedQuizzes();
            }
        }

        function startBookmarkedQuiz() {
            const bookmarks = getBookmarkedQuestions();
            let qList = filterBlockedQuestions(bookmarks);
            if (qList.length === 0) {
                showToast("Chưa có câu hỏi hợp lệ nào được lưu hoặc các câu đã lưu đều đã bị chặn/ẩn!");
                return;
            }
            questions = shuffleArray(qList.map(item => ({
                question: getCleanQuestionText(item.question),
                options: item.options,
                answerStr: item.answerStr,
                explanation: item.explanation,
                images: item.images || [],
                explanationImages: item.explanationImages || [],
                isStarred: item.isStarred || false,
                isHidden: false,
                __srcQuizName: item.quizName || '',
                __srcTopicLabel: ''
            })));
            currentQuizName = "Ôn tập câu đã lưu (" + qList.length + " câu)";
            currentQuizId = null;
            closeBookmarkedModal();
            initQuiz();
        }

        function updateQuestionText(qIndex, val) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                quiz.questions[qIndex].question = getCleanQuestionText(val);
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            }
        }

        function updateQuestionOption(qIndex, optIndex, val) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                quiz.questions[qIndex].options[optIndex] = val;
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            }
        }

        function updateQuestionAnswer(qIndex, val) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                quiz.questions[qIndex].answerStr = val.toUpperCase();
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            }
        }

        function updateQuestionExplanation(qIndex, val) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                quiz.questions[qIndex].explanation = val;
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            }
        }

        function toggleQuestionStar(qIndex) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                quiz.questions[qIndex].isStarred = !quiz.questions[qIndex].isStarred;
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                renderEditQuestions();
                showToast(quiz.questions[qIndex].isStarred ? "⭐ Đã đánh dấu sao câu hỏi!" : "Đã bỏ dấu sao câu hỏi!");
            }
        }

        function toggleQuestionHide(qIndex) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                quiz.questions[qIndex].isHidden = !quiz.questions[qIndex].isHidden;
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                renderEditQuestions();
                showToast(quiz.questions[qIndex].isHidden ? "👁️‍🗨️ Đã ẩn câu hỏi (sẽ không xuất hiện khi làm bài)" : "👁️ Đã hiện câu hỏi trở lại!");
            }
        }

        function initEditTopicSelect() {
            const sel = document.getElementById('edit-quiz-topic-select');
            if (!sel) return;
            sel.innerHTML = '<option value="">-- Chọn chủ đề nhanh --</option>';
            for (let n = 1; n <= TOPIC_COUNT; n++) {
                const opt = document.createElement('option');
                opt.value = (n === 37) ? "Thi Thử" : topicName(n);
                opt.textContent = (n === 37) ? "🎯 Thi Thử" : `📁 ${topicFullName(n)}`;
                sel.appendChild(opt);
            }
            const optOther = document.createElement('option');
            optOther.value = "Chung";
            optOther.textContent = "📦 Chung / Chưa phân loại";
            sel.appendChild(optOther);
        }

        function syncEditTopicSelect(folderVal) {
            const sel = document.getElementById('edit-quiz-topic-select');
            if (!sel) return;
            const clean = String(folderVal || '').trim();
            if (!clean) { sel.value = ""; return; }
            let found = false;
            for (let i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value.toLowerCase() === clean.toLowerCase()) {
                    sel.selectedIndex = i;
                    found = true;
                    break;
                }
            }
            if (!found) {
                const m = clean.normalize('NFC').match(/^chủ\s*đề\s*(\d+)/i);
                if (m) {
                    const num = parseInt(m[1], 10);
                    const targetVal = (num === 37) ? "Thi Thử" : topicName(num);
                    for (let i = 0; i < sel.options.length; i++) {
                        if (sel.options[i].value.toLowerCase() === targetVal.toLowerCase()) {
                            sel.selectedIndex = i;
                            found = true;
                            break;
                        }
                    }
                }
            }
            if (!found) sel.value = "";
        }

        function onEditTopicSelectChange(val) {
            if (!val) return;
            const folderInput = document.getElementById('edit-quiz-folder-input');
            if (folderInput) folderInput.value = val;
            updateCurrentEditFolder(val);
            showToast(`Đã chuyển bộ đề sang: ${val}`);
        }

        function updateCurrentEditFolder(newFolder) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                const cleanFolder = newFolder.trim().replace(/\s*\/\s*/g, '/') || "Chung";
                quiz.folder = cleanFolder;
                const isExamFolder = cleanFolder.toLowerCase() === 'thi thử' || /^chủ\s*đề\s*37(?:\/|$)/i.test(cleanFolder);
                quiz.isExam = isExamFolder;
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                syncEditTopicSelect(cleanFolder);
            }
        }

        function updateCurrentEditName(newName) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                quiz.name = newName.trim() || "Bộ đề không tên";
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            }
        }

        function deleteQuestion(qIndex) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                if (quiz.questions.length <= 1) {
                    showToast("Bộ đề phải có ít nhất 1 câu hỏi!");
                    return;
                }
                quiz.questions.splice(qIndex, 1);
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                renderEditQuestions();
                showToast("Đã xóa câu hỏi!");
            }
        }

        function copyQuestionCard(qIndex) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (!quiz) return;
            const q = quiz.questions[qIndex];
            let text = `Câu ${qIndex + 1}: ${q.question}\n`;
            if (q.options) {
                q.options.forEach(opt => text += `${opt}\n`);
            }
            text += `Đáp án: ${q.answerStr || ''}\n`;
            if (q.explanation) {
                text += `Giải thích: ${q.explanation}\n`;
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    showToast(`Đã sao chép Câu ${qIndex + 1} vào bộ nhớ tạm!`);
                }).catch(() => {
                    fallbackCopyText(text);
                });
            } else {
                fallbackCopyText(text);
            }
        }

        function fallbackCopyText(text) {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand('copy');
                showToast("Đã sao chép nội dung câu hỏi vào bộ nhớ tạm!");
            } catch (err) {
                showToast("Không thể sao chép tự động.");
            }
            document.body.removeChild(textarea);
        }

        function openAddQuestionModal(index) {
            activeAddQuestionIndex = index;
            document.getElementById('quick-paste-textarea').value = '';
            document.getElementById('add-question-modal').classList.remove('hidden');
            setTimeout(() => {
                const ta = document.getElementById('quick-paste-textarea');
                if (ta) {
                    ta.focus();
                    try {
                        navigator.clipboard.readText().then(clipText => {
                            if (clipText) {
                                ta.value = clipText;
                                showToast("Đã tự động dán nội dung từ Clipboard!");
                            }
                        }).catch(err => {});
                    } catch(e) {}
                }
            }, 100);
        }

        function closeAddQuestionModal() {
            document.getElementById('add-question-modal').classList.add('hidden');
        }

        async function autoPasteQuickModal() {
            const ta = document.getElementById('quick-paste-textarea');
            ta.focus();
            try {
                const text = await navigator.clipboard.readText();
                if (text) {
                    ta.value = text;
                    showToast("Đã dán nội dung từ Clipboard thành công!");
                } else {
                    showToast("Clipboard đang trống!");
                }
            } catch (err) {
                showToast("Hãy nhấn Ctrl+V để dán nội dung vào ô bên dưới!");
            }
        }

        function addBlankQuestionAction() {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                const newQ = {
                    question: "Nội dung câu hỏi mới...",
                    options: ["A. Đáp án A", "B. Đáp án B", "C. Đáp án C", "D. Đáp án D"],
                    answerStr: "A",
                    explanation: "",
                    images: [],
                    explanationImages: [],
                    isStarred: false,
                    isHidden: false
                };
                if (activeAddQuestionIndex === null) {
                    quiz.questions.push(newQ);
                } else {
                    quiz.questions.splice(activeAddQuestionIndex, 0, newQ);
                }
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                closeAddQuestionModal();
                renderEditQuestions();
            }
        }

        function submitQuickPasteQuestion() {
            const text = document.getElementById('quick-paste-textarea').value.trim();
            if (!text) {
                showToast("Vui lòng nhập hoặc dán nội dung câu hỏi!");
                return;
            }

            const parsed = parseTextToQuestions(text);
            let newQList = [];
            if (parsed.length > 0) {
                newQList = parsed;
            } else {
                newQList = [{
                    question: text,
                    options: ["A. Đáp án A", "B. Đáp án B", "C. Đáp án C", "D. Đáp án D"],
                    answerStr: "A",
                    explanation: "",
                    images: [],
                    explanationImages: [],
                    isStarred: false,
                    isHidden: false
                }];
            }

            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz) {
                if (activeAddQuestionIndex === null) {
                    quiz.questions = quiz.questions.concat(newQList);
                } else {
                    quiz.questions.splice(activeAddQuestionIndex, 0, ...newQList);
                }
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                closeAddQuestionModal();
                renderEditQuestions();
            }
        }

        function resumeSpecialQuiz(sessionId) {
            const session = getActiveSession(sessionId);
            if (!session || !session.questions || session.questions.length === 0) {
                showToast("Không tìm thấy tiến trình đã lưu!");
                return;
            }
            questions = session.questions;
            questionStates = session.questionStates;
            currentIndex = session.currentIndex || 0;
            timeElapsed = session.timeElapsed || 0;
            currentQuizName = session.currentQuizName || (sessionId === MOCK_SESSION_ID ? "Ôn tập nhanh" : "Ôn tập chuyên sâu");
            currentQuizId = sessionId;

            closeMockExamModal();
            closeDeepModal();

            document.getElementById('home-screen').classList.add('hidden');
            document.getElementById('edit-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            document.getElementById('total-q-num').textContent = questions.length;
            document.getElementById('current-quiz-title').textContent = currentQuizName;

            startTimer();
            loadQuestion();
            showToast("Đã khôi phục tiến độ làm bài!");
        }

        function clearSpecialSession(sessionId) {
            kv.removeItem(`quizAppActiveSession_${sessionId}`);
            showToast("Đã xóa tiến trình dở dang!");
        }

        let mockSelectedTopics = new Set();

        // Loại bỏ chủ đề 37 (Thi Thử) khỏi Ôn tập nhanh, chỉ lấy chủ đề 1 đến 36
        function getMockTopicData() {
            const quizzes = getRegularQuizzes();
            const data = [];
            for (let n = 1; n <= 36; n++) {
                const qs = quizzes.filter(q => getQuizTopic(q) === n);
                let total = 0;
                qs.forEach(q => { total += filterBlockedQuestions(q.questions).length; });
                data.push({ n, quizCount: qs.length, total });
            }
            return data;
        }

        function openMockExamModal() {
            const quizzes = getRegularQuizzes();
            if (quizzes.length === 0) {
                showToast("Chưa có bộ đề nào được lưu để ôn tập!");
                return;
            }

            const banner = document.getElementById('mock-resume-banner');
            const session = getActiveSession(MOCK_SESSION_ID);
            if (banner) {
                if (session && session.questions && session.questions.length > 0 && session.currentIndex < session.questions.length) {
                    banner.className = 'bg-amber-50 border border-amber-300 rounded-2xl p-3.5 flex items-center justify-between gap-3 shadow-sm mb-3';
                    banner.innerHTML = `
                        <div class="min-w-0">
                            <p class="font-bold text-amber-900 text-xs sm:text-sm flex items-center"><span class="mr-1.5">⏳</span> Bạn có bài ôn tập nhanh làm dở</p>
                            <p class="text-xs text-amber-800 mt-0.5 truncate">Câu ${session.currentIndex + 1}/${session.questions.length} • Đã làm: ${formatTime(session.timeElapsed)}</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button" onclick="resumeSpecialQuiz('${MOCK_SESSION_ID}')" class="bg-amber-500 hover:bg-amber-600 text-white font-bold py-1.5 px-3 rounded-xl text-xs shadow-sm transition-colors">▶️ Tiếp tục</button>
                            <button type="button" onclick="clearSpecialSession('${MOCK_SESSION_ID}'); openMockExamModal();" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-1.5 px-2.5 rounded-xl text-xs transition-colors">Bỏ qua</button>
                        </div>
                    `;
                    banner.classList.remove('hidden');
                } else {
                    banner.classList.add('hidden');
                    banner.innerHTML = '';
                }
            }

            const data = getMockTopicData();
            mockSelectedTopics = new Set();
            document.getElementById('mock-num-questions').value = 10;
            renderMockTopicGrid();
            updateMockTotalAvailable();
            document.getElementById('mock-exam-modal').classList.remove('hidden');
        }

        function closeMockExamModal() {
            document.getElementById('mock-exam-modal').classList.add('hidden');
        }

        function renderMockTopicGrid() {
            const data = getMockTopicData();
            const grid = document.getElementById('mock-topic-grid');
            grid.innerHTML = '';
            data.forEach(d => {
                const hasQ = d.total > 0;
                const selected = mockSelectedTopics.has(d.n);
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.title = topicFullName(d.n) + ` (${d.total} câu)`;
                btn.disabled = !hasQ;
                btn.onclick = () => toggleMockTopic(d.n);
                let btnClass = 'relative rounded-lg border p-0.5 flex items-center justify-center aspect-square transition-colors ' +
                    (!hasQ ? 'bg-gray-100 border-gray-200 cursor-not-allowed' :
                     selected ? 'bg-amber-100 border-amber-500 ring-2 ring-amber-400 shadow-sm' :
                     'bg-white border-gray-300 hover:bg-amber-50');
                btn.className = btnClass;
                btn.innerHTML = `<img src="${TOPIC_ICONS[d.n - 1] || 'images/img_037.webp'}" alt="${topicFullName(d.n)}" draggable="false" onerror="this.style.opacity=0.15" class="w-full h-full object-contain ${hasQ ? '' : 'opacity-30 grayscale'}">
                    ${selected ? '<span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-amber-500 text-white rounded-full text-[9px] leading-[14px] text-center font-bold">✓</span>' : ''}`;
                grid.appendChild(btn);
            });
        }

        function toggleMockTopic(n) {
            if (mockSelectedTopics.has(n)) mockSelectedTopics.delete(n);
            else mockSelectedTopics.add(n);
            renderMockTopicGrid();
            updateMockTotalAvailable();
        }

        function mockTopicSelectAll(select) {
            const data = getMockTopicData();
            mockSelectedTopics = select ? new Set(data.filter(d => d.total > 0).map(d => d.n)) : new Set();
            renderMockTopicGrid();
            updateMockTotalAvailable();
        }

        function mockQuickPick() {
            const data = getMockTopicData().filter(d => d.total > 0);
            if (data.length === 0) {
                showToast("Không có chủ đề nào có câu hỏi để chọn nhanh!");
                return;
            }
            const k = Math.min(5, data.length);
            const picked = shuffleArray(data).slice(0, k);
            mockSelectedTopics = new Set(picked.map(d => d.n));
            renderMockTopicGrid();
            updateMockTotalAvailable();

            const totalAvail = picked.reduce((s, d) => s + d.total, 0);
            const options = [10, 15, 20, 25, 30, 35, 40, 45, 50].filter(x => x <= totalAvail);
            const numQ = options.length > 0 ? options[Math.floor(Math.random() * options.length)] : Math.max(1, totalAvail);
            document.getElementById('mock-num-questions').value = numQ;
            showToast(`Đã chọn nhanh ${k} chủ đề, ${numQ} câu`);
        }

        function setMockNumQuestions(n) {
            document.getElementById('mock-num-questions').value = n;
        }

        function updateMockTotalAvailable() {
            const data = getMockTopicData();
            let total = 0;
            data.forEach(d => { if (mockSelectedTopics.has(d.n)) total += d.total; });
            document.getElementById('mock-total-available-text').innerHTML = `Tổng số câu có sẵn (sau khi lọc các câu bị ẩn/chặn): <b>${total}</b> câu`;

            const numInput = document.getElementById('mock-num-questions');
            if (parseInt(numInput.value) > total && total > 0) {
                numInput.value = total;
            }
        }

        function startMockExam() {
            if (mockSelectedTopics.size === 0) {
                showToast("Vui lòng chọn ít nhất một chủ đề để ôn tập!");
                return;
            }

            const quizzes = getSavedQuizzes();
            let pool = [];
            quizzes.forEach(quiz => {
                const topicNum = getQuizTopic(quiz);
                if (mockSelectedTopics.has(topicNum)) {
                    const topicLabel = topicFullName(topicNum);
                    quiz.questions.forEach(q => { q.__srcQuizName = quiz.name; q.__srcTopicLabel = topicLabel; });
                    pool = pool.concat(quiz.questions);
                }
            });

            pool = filterBlockedQuestions(pool);
            if (pool.length === 0) {
                showToast("Tất cả câu hỏi từ các chủ đề đã chọn đều đã bị chặn hoặc bị ẩn!");
                return;
            }

            const numQ = parseInt(document.getElementById('mock-num-questions').value);
            if (isNaN(numQ) || numQ <= 0) {
                showToast("Số lượng câu hỏi không hợp lệ!");
                return;
            }

            if (numQ > pool.length) {
                showToast(`Số lượng câu hỏi yêu cầu (${numQ}) vượt quá tổng số câu có sẵn (${pool.length})!`);
                return;
            }

            clearActiveSession(MOCK_SESSION_ID);
            questions = shuffleArray(pool).slice(0, numQ);
            currentQuizName = `Ôn tập nhanh (${numQ} câu từ ${mockSelectedTopics.size} chủ đề)`;
            currentQuizId = MOCK_SESSION_ID; 
            
            closeMockExamModal();
            initQuiz();
        }

        let examSelectedId = null;
        let editingIsExam = false;

        function getSavedExamSets() {
            return getSavedQuizzes().filter(q => q.isExam || getQuizTopic(q) === 37);
        }

        function getRegularQuizzes() {
            return getSavedQuizzes();
        }

        function openExamModal() {
            const sets = getSavedExamSets();
            examSelectedId = sets.length > 0 ? sets[0].id : null;
            renderExamList();
            document.getElementById('exam-modal').classList.remove('hidden');
        }

        function closeExamModal() {
            document.getElementById('exam-modal').classList.add('hidden');
        }

        function selectExamSet(id) {
            examSelectedId = id;
            renderExamList();
        }

        function renderExamList() {
            const sets = getSavedExamSets();
            const list = document.getElementById('exam-list');
            list.innerHTML = '';

            if (sets.length === 0) {
                list.innerHTML = `<p class="text-xs text-gray-400 italic bg-gray-50 p-4 rounded-xl border border-gray-200 text-center">Chưa có đề thi nào.<span class="dev-only"> Bấm "➕ Tạo đề mới" hoặc "📂 Nhập JSON" ở trên để thêm đề thi.</span></p>`;
                return;
            }

            sets.forEach(s => {
                const availCount = filterBlockedQuestions(s.questions || []).length;
                const selected = s.id === examSelectedId;
                const session = getActiveSession(s.id);
                const hasSession = session && session.currentIndex > 0 && session.currentIndex < (session.questions ? session.questions.length : 0);

                let bestText = '';
                if (s.bestResult && s.bestResult.total > 0) {
                    const pct = Math.round((s.bestResult.score / s.bestResult.total) * 100);
                    const color = pct >= 80 ? 'text-emerald-700 bg-emerald-100' : (pct >= 50 ? 'text-amber-700 bg-amber-100' : 'text-rose-700 bg-rose-100');
                    bestText = `<span class="text-[11px] font-bold ${color} px-2.5 py-0.5 rounded-full inline-block mt-1">🏆 Kỷ lục: ${s.bestResult.score}/${s.bestResult.total} câu (${pct}%) • ${s.bestResult.date}</span>`;
                }

                const item = document.createElement('div');
                item.className = 'p-3 rounded-xl border transition-colors ' +
                    (selected ? 'bg-indigo-50 border-indigo-500 ring-2 ring-indigo-300' : 'bg-white border-gray-200 hover:bg-gray-50');
                item.innerHTML = `
                    <button type="button" onclick="selectExamSet(${s.id})" class="w-full text-left flex items-center justify-between">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <p class="font-bold text-gray-800 truncate">${escTopic(s.name)}</p>
                                ${hasSession ? '<span class="text-[10px] font-bold text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full">⏳ Đang làm dở</span>' : ''}
                            </div>
                            <p class="text-xs text-gray-500 mt-0.5">${availCount} câu hỏi${hasSession ? ` • Đang ở câu ${session.currentIndex + 1}/${session.questions.length}` : ''}</p>
                            ${bestText}
                        </div>
                        ${selected ? '<span class="text-indigo-600 font-bold text-lg ml-2 shrink-0">✓</span>' : ''}
                    </button>
                    <div class="dev-only flex items-center gap-2 flex-wrap justify-end mt-2 pt-2 border-t border-dashed">
                        <button onclick="editExamSet(${s.id})" class="text-purple-600 hover:text-purple-800 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-xl font-bold text-xs shadow-sm">✏️ Edit</button>
                        <button onclick="deleteExamSet(${s.id})" class="text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-xl font-bold text-xs shadow-sm">🗑️ Xóa</button>
                        <button onclick="selectExamSet(${s.id}); startExam(false)" class="text-indigo-600 hover:text-indigo-800 bg-indigo-100 hover:bg-indigo-200 px-4 py-1.5 rounded-xl font-bold text-xs shadow-sm">▶️ Thi mới</button>
                    </div>
                `;
                list.appendChild(item);
            });

            const mainStartBtn = document.getElementById('btn-start-exam-main');
            if (mainStartBtn && examSelectedId) {
                const curSession = getActiveSession(examSelectedId);
                if (curSession && curSession.currentIndex > 0 && curSession.currentIndex < curSession.questions.length) {
                    mainStartBtn.textContent = `▶️ Tiếp tục thi (Câu ${curSession.currentIndex + 1})`;
                    mainStartBtn.onclick = () => startExam(true);
                } else {
                    mainStartBtn.textContent = `🚀 Bắt đầu thi`;
                    mainStartBtn.onclick = () => startExam(false);
                }
            }
        }

        // Thi thử: Giữ nguyên thứ tự câu hỏi (không xáo câu, chỉ xáo đáp án)
        function startExam(resume = false) {
            const sets = getSavedExamSets();
            const set = sets.find(s => s.id === examSelectedId);
            if (!set) {
                showToast("Vui lòng chọn một đề thi!");
                return;
            }

            currentQuizId = set.id;
            currentQuizName = `Thi thử: ${set.name}`;

            if (resume) {
                const session = getActiveSession(set.id);
                if (session && session.questions && session.questions.length > 0) {
                    questions = session.questions;
                    questionStates = session.questionStates;
                    currentIndex = session.currentIndex;
                    timeElapsed = session.timeElapsed;
                    currentQuizName = session.currentQuizName || currentQuizName;

                    closeExamModal();
                    document.getElementById('home-screen').classList.add('hidden');
                    document.getElementById('edit-screen').classList.add('hidden');
                    document.getElementById('result-screen').classList.add('hidden');
                    document.getElementById('quiz-screen').classList.remove('hidden');
                    document.getElementById('total-q-num').textContent = questions.length;
                    document.getElementById('current-quiz-title').textContent = currentQuizName;

                    startTimer();
                    loadQuestion();
                    showToast("Đã khôi phục tiến độ bài thi thử!");
                    return;
                }
            }

            const pool = filterBlockedQuestions(set.questions || []);
            if (pool.length === 0) {
                showToast("Đề thi này không còn câu hỏi khả dụng (đã bị chặn/ẩn hết)!");
                return;
            }

            clearActiveSession(set.id);
            questions = shuffleArray(pool);
            closeExamModal();
            initQuiz();
        }

        function openExamCreateModal() {
            document.getElementById('exam-create-error').classList.add('hidden');
            document.getElementById('exam-create-name').value = '';
            document.getElementById('exam-create-manual').value = '';
            document.getElementById('exam-create-file').value = '';
            document.getElementById('exam-create-modal').classList.remove('hidden');
        }

        function closeExamCreateModal() {
            document.getElementById('exam-create-modal').classList.add('hidden');
        }

        document.getElementById('exam-create-file').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (!file) return;

            const nameInput = document.getElementById('exam-create-name');
            if (!nameInput.value) {
                nameInput.value = file.name.replace(/\.[^/.]+$/, "");
            }

            const reader = new FileReader();
            if (file.name.endsWith('.docx')) {
                reader.onload = function(event) {
                    mammoth.extractRawText({arrayBuffer: event.target.result})
                        .then(result => { document.getElementById('exam-create-manual').value = result.value; })
                        .catch(err => { showToast("Lỗi đọc file Word: " + err.message); });
                };
                reader.readAsArrayBuffer(file);
            } else if (/\.(txt|md|markdown)$/i.test(file.name)) {
                reader.onload = function(event) {
                    document.getElementById('exam-create-manual').value = quizFileText(file.name, event.target.result);
                };
                reader.readAsText(file);
            }
        });

        function processExamAndSave() {
            const errorMsg = document.getElementById('exam-create-error');
            errorMsg.classList.add('hidden');
            errorMsg.textContent = '';

            const text = document.getElementById('exam-create-manual').value.trim();
            if (!text) {
                errorMsg.textContent = "Vui lòng tải file hoặc dán nội dung đề thi vào ô văn bản!";
                errorMsg.classList.remove('hidden');
                return;
            }

            const parsed = parseTextToQuestions(text);
            if (parsed.length === 0) {
                errorMsg.textContent = "Không nhận diện được câu hỏi nào. Vui lòng kiểm tra lại định dạng soạn đề!";
                errorMsg.classList.remove('hidden');
                return;
            }

            const name = document.getElementById('exam-create-name').value.trim();
            const quizzes = getSavedQuizzes();
            const newExam = {
                id: Date.now() + Math.floor(Math.random() * 10000),
                name: name || `Đề thi ngày ${new Date().toLocaleDateString('vi-VN')}`,
                folder: topicName(37),
                isExam: true,
                questions: parsed,
                date: new Date().toLocaleDateString('vi-VN')
            };
            quizzes.unshift(newExam);
            kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));

            closeExamCreateModal();
            examSelectedId = newExam.id;
            renderExamList();
            renderSavedQuizzes();
            showToast(`Đã lưu đề thi với ${parsed.length} câu hỏi vào Thi Thử!`);
        }

        function editExamSet(id) {
            closeExamModal();
            editingIsExam = true;
            openEditScreen(id);
        }

        function deleteExamSet(id) {
            if (!confirm("Bạn có chắc chắn muốn xóa đề thi này?")) return;
            let quizzes = getSavedQuizzes();
            quizzes = quizzes.filter(q => q.id !== id);
            kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            kv.removeItem(`quizAppActiveSession_${id}`);
            if (examSelectedId === id) examSelectedId = null;
            renderExamList();
            renderSavedQuizzes();
            showToast("Đã xóa đề thi!");
        }

        function triggerExamJsonImport() {
            document.getElementById('exam-json-input').click();
        }

        function importExamJsonFiles(e) {
            const fileArray = Array.from(e.target.files || []);
            const totalFiles = fileArray.length;
            if (totalFiles === 0) return;
            e.target.value = '';

            let quizzes = getSavedQuizzes();
            let successCount = 0;
            let processed = 0;

            function finishIfDone() {
                processed++;
                if (processed < totalFiles) return;
                if (successCount > 0) {
                    kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                    renderExamList();
                    renderSavedQuizzes();
                    showToast(`Đã nhập thành công ${successCount} đề thi từ ${totalFiles} file!`);
                } else {
                    showToast(`Không nhập được đề thi nào từ ${totalFiles} file. Kiểm tra lại định dạng JSON!`);
                }
            }

            fileArray.forEach(file => {
                const reader = new FileReader();
                reader.onload = function(event) {
                    try {
                        const parsed = JSON.parse(event.target.result);
                        const eArray = parsed && parsed.exams ? parsed.exams : (parsed && parsed.quizzes ? parsed.quizzes : (Array.isArray(parsed) ? parsed : null));
                        if (Array.isArray(eArray)) {
                            eArray.forEach(item => {
                                if (item && item.name && item.questions) {
                                    item.id = Date.now() + Math.floor(Math.random() * 10000);
                                    item.isExam = true;
                                    item.folder = topicName(37);
                                    quizzes.unshift(item);
                                    successCount++;
                                }
                            });
                        } else if (parsed && typeof parsed === 'object' && parsed.name && parsed.questions) {
                            parsed.id = Date.now() + Math.floor(Math.random() * 10000);
                            parsed.isExam = true;
                            parsed.folder = topicName(37);
                            quizzes.unshift(parsed);
                            successCount++;
                        }
                    } catch (err) {
                        console.error("Lỗi đọc file JSON đề thi:", err);
                    }
                    finishIfDone();
                };
                reader.onerror = finishIfDone;
                reader.readAsText(file);
            });
        }

        function resizeBase64Image(base64Str, maxCm = 7) {
            return new Promise((resolve) => {
                const img = new Image();
                img.onload = function() {
                    const maxHeightPx = maxCm * 37.8;
                    let w = img.width;
                    let h = img.height;
                    
                    if (h > maxHeightPx) {
                        w = Math.round((maxHeightPx / h) * w);
                        h = Math.round(maxHeightPx);
                    }
                    
                    const canvas = document.createElement('canvas');
                    canvas.width = w;
                    canvas.height = h;
                    const ctx = canvas.getContext('2d');
                    ctx.drawImage(img, 0, 0, w, h);
                    resolve(canvas.toDataURL('image/jpeg', 0.9));
                };
                img.onerror = () => resolve(base64Str);
                img.src = base64Str;
            });
        }

        async function exportQuizToWord(id) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === id);
            if (!quiz) return;

            const validQuestions = filterBlockedQuestions(quiz.questions);

            let htmlContent = `
                <html xmlns:o='urn:schemas-microsoft-com:office:office' xmlns:w='urn:schemas-microsoft-com:office:word' xmlns='http://www.w3.org/TR/REC-html40'>
                <head>
                    <meta charset="utf-8">
                    <title>${quiz.name}</title>
                    <style>
                        p.MsoNormal, li.MsoNormal, div.MsoNormal { font-family: Arial, sans-serif; font-size: 13pt; line-height: 120%; text-align: justify; }
                        body { font-family: Arial, sans-serif; font-size: 13pt; line-height: 120%; color: #000; text-align: justify; }
                        p, div, li { font-family: Arial, sans-serif; line-height: 120%; text-align: justify; }
                        h1 { font-family: Arial, sans-serif; text-align: center; color: #003366; line-height: 120%; }
                        .question { font-weight: bold; margin-top: 15px; margin-bottom: 5px; text-align: justify; }
                        .option { margin-left: 20px; margin-bottom: 3px; text-align: justify; }
                        .correct-answer { font-weight: bold; color: #008000; margin-top: 5px; margin-bottom: 2px; text-align: left; }
                        .explanation { font-style: italic; color: #555; margin-left: 0px; margin-bottom: 10px; text-align: justify; }
                        img { display: block; margin: 5px auto; }
                    </style>
                </head>
                <body>
                    <h1>BỘ ĐỀ: ${quiz.name.toUpperCase()}</h1>
                    <p><i>Phân chủ đề: ${quiz.folder || 'Chung'} - Ngày tạo: ${quiz.date} - Tổng số câu (không tính câu ẩn/chặn): ${validQuestions.length}</i></p>
                    <hr/>
            `;

            for (let idx = 0; idx < validQuestions.length; idx++) {
                const q = validQuestions[idx];
                htmlContent += `<div class="question">Câu ${idx + 1}: ${getCleanQuestionText(q.question).replace(/\n/g, '<br/>')}</div>`;
                
                if (q.images && q.images.length > 0) {
                    for (const img of q.images) {
                        const resizedImg = await resizeBase64Image(img, 7);
                        htmlContent += `<div style="text-align: center;"><img src="${resizedImg}" /></div>`;
                    }
                }

                q.options.forEach(opt => {
                    htmlContent += `<div class="option">${opt}</div>`;
                });
                htmlContent += `<div class="correct-answer">Đáp án đúng: ${q.answerStr}</div>`;
                if (q.explanation) {
                    htmlContent += `<div class="explanation">Giải thích: ${String(q.explanation).replace(/\n/g, '<br/>')}</div>`;
                }
                if (q.explanationImages && q.explanationImages.length > 0) {
                    for (const img of q.explanationImages) {
                        const resizedImg = await resizeBase64Image(img, 6);
                        htmlContent += `<div style="text-align: center;"><img src="${resizedImg}" /></div>`;
                    }
                }
                htmlContent += `<br/>`;
            }

            htmlContent += `</body></html>`;

            const blob = new Blob(['\ufeff' + htmlContent], { type: 'application/msword' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `${quiz.name.replace(/[^a-zA-Z0-9à-ỹÀ-Ỹ]/g, '_')}_export.doc`;
            a.click();
            URL.revokeObjectURL(url);
        }

        function exportQuizToJson(id) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === id);
            if (!quiz) return;

            const data = JSON.stringify(quiz, null, 2);
            const blob = new Blob([data], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            const safeName = quiz.name.replace(/[\/\\?%*:|"<>]/g, '_');
            a.download = `${safeName}.json`;
            a.click();
            URL.revokeObjectURL(url);
        }

        function editCurrentQuiz() {
            if (!currentQuizId || currentQuizId === MOCK_SESSION_ID || currentQuizId === DEEP_SESSION_ID) {
                showToast("Bài ôn tập tổng hợp từ nhiều nguồn, không thể chỉnh sửa trực tiếp!");
                return;
            }
            clearInterval(timerInterval);
            document.getElementById('quiz-screen').classList.add('hidden');
            
            isEditingFromQuiz = true;
            returnQuizIndex = currentIndex;

            const sortSelect = document.getElementById('edit-sort-select');
            if (sortSelect) sortSelect.value = 'original';
            const filterSelect = document.getElementById('edit-filter-select');
            if (filterSelect) filterSelect.value = 'all';

            const currentQ = questions[currentIndex];
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === currentQuizId);
            let targetOriginalIndex = currentIndex;
            if (quiz && currentQ) {
                const foundIdx = quiz.questions.findIndex(item => getCleanQuestionText(item.question) === getCleanQuestionText(currentQ.question));
                if (foundIdx > -1) targetOriginalIndex = foundIdx;
            }

            returnOrigIndex = (quiz && currentQ) ? targetOriginalIndex : null;
            openEditScreen(currentQuizId, targetOriginalIndex);
        }

        function returnToQuizFromEdit() {
            endImportSession();
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === currentQuizId);
            if (quiz) {
                const edited = filterBlockedQuestions(quiz.questions);
                if (edited.length > 0 && questions.length > 0) {
                    const byText = new Map();
                    edited.forEach(e => byText.set(getCleanQuestionText(e.question), e));
                    const curOrig = (returnOrigIndex != null) ? quiz.questions[returnOrigIndex] : null;
                    questions = questions.map((old, i) => {
                        const fresh = (i === returnQuizIndex && curOrig) ? curOrig : byText.get(getCleanQuestionText(old.question));
                        return fresh ? applyOptionOrder(fresh, old) : old;
                    });
                    if (returnQuizIndex >= questions.length) {
                        returnQuizIndex = questions.length - 1;
                    }
                    currentIndex = returnQuizIndex;
                }
            }
            isEditingFromQuiz = false;
            document.getElementById('edit-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            startTimer();
            loadQuestion();
        }

        function toggleFlagCurrent() {
            questionStates[currentIndex].isFlagged = !questionStates[currentIndex].isFlagged;
            updateFlagButtonState();
        }

        function updateFlagButtonState() {
            const st = questionStates[currentIndex];
            const btn = document.getElementById('flag-btn');
            const icon = document.getElementById('flag-icon');
            const text = document.getElementById('flag-text');

            if (st.isFlagged) {
                icon.textContent = "🚩";
                text.textContent = "Bỏ cờ";
                btn.className = "eq-btn bg-amber-500 hover:bg-amber-600 text-white border border-amber-600 font-bold px-1 rounded-xl transition-colors text-xs sm:text-sm shadow-sm flex items-center justify-center truncate";
            } else {
                icon.textContent = "🚩";
                text.textContent = "Đánh cờ";
                btn.className = "eq-btn bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-300 font-bold px-1 rounded-xl transition-colors text-xs sm:text-sm shadow-sm flex items-center justify-center truncate";
            }
        }

        function highlightSelectedText() {
            const selection = window.getSelection();
            if (!selection.rangeCount || selection.isCollapsed) {
                showToast("Vui lòng bôi đen đoạn văn bản cần highlight!");
                return;
            }
            const range = selection.getRangeAt(0);
            const qTextEl = document.getElementById('question-text');
            const optionsContainer = document.getElementById('options-container');

            let targetEl = null;
            if (qTextEl.contains(range.commonAncestorContainer)) {
                targetEl = qTextEl;
            } else if (optionsContainer.contains(range.commonAncestorContainer)) {
                targetEl = range.commonAncestorContainer.nodeType === 3 ? range.commonAncestorContainer.parentElement.closest('button') : range.commonAncestorContainer.closest('button');
            }

            if (!targetEl) {
                showToast("Vui lòng chọn văn bản bên trong câu hỏi hoặc các đáp án!");
                return;
            }

            try {
                const span = document.createElement('mark');
                span.className = 'bg-yellow-200 text-yellow-900 rounded px-1 font-inherit';
                const contents = range.extractContents();
                span.appendChild(contents);
                range.insertNode(span);
                selection.removeAllRanges();

                if (targetEl === qTextEl) {
                    questionStates[currentIndex].customQuestionHtml = qTextEl.innerHTML;
                } else {
                    questionStates[currentIndex].customOptionsHtml = optionsContainer.innerHTML;
                }
                showToast("Đã highlight phần văn bản được chọn!");
            } catch (err) {
                showToast("Không thể highlight vùng chọn này. Hãy bôi đen gọn trong một dòng.");
            }
        }

        function clearHighlightCurrent() {
            questionStates[currentIndex].customQuestionHtml = null;
            questionStates[currentIndex].customOptionsHtml = null;
            loadQuestion();
            showToast("Đã xóa highlight câu này!");
        }

        function openQuestionNavigatorModal() {
            const grid = document.getElementById('navigator-grid');
            grid.innerHTML = '';
            
            questionStates.forEach((st, idx) => {
                const btn = document.createElement('button');
                let bgClass = 'bg-gray-100 text-gray-700 border-gray-300 hover:bg-gray-200';
                
                if (st.status === 'correct') {
                    bgClass = 'bg-green-500 text-white border-green-600 hover:bg-green-600';
                } else if (st.status === 'incorrect') {
                    bgClass = 'bg-red-500 text-white border-red-600 hover:bg-red-600';
                } else if (st.status === 'skipped') {
                    bgClass = 'bg-amber-200 text-amber-900 border-amber-300 hover:bg-amber-300';
                }

                if (idx === currentIndex) {
                    bgClass += ' ring-2 ring-blue-400 font-extrabold';
                }

                let flagBadge = st.isFlagged ? '<span class="absolute -top-1 -right-1 text-xs bg-amber-500 text-white rounded-full px-1 shadow">🚩</span>' : '';
                let hlBadge = (st.customQuestionHtml || st.customOptionsHtml) ? '<span class="absolute -bottom-1 -left-1 text-xs bg-yellow-400 text-yellow-900 rounded-full px-1 shadow">🖍️</span>' : '';

                btn.className = `relative p-3 rounded-xl border font-bold text-sm flex flex-col items-center justify-center transition-all ${bgClass}`;
                btn.innerHTML = `<span>${idx + 1}</span>${flagBadge}${hlBadge}`;
                btn.onclick = () => {
                    currentIndex = idx;
                    closeQuestionNavigatorModal();
                    loadQuestion();
                };
                grid.appendChild(btn);
            });

            document.getElementById('navigator-modal').classList.remove('hidden');
        }

        function closeQuestionNavigatorModal() {
            document.getElementById('navigator-modal').classList.add('hidden');
        }

        function openViewQuizModal(id) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === id);
            if (!quiz) return;

            const validQuestions = filterBlockedQuestions(quiz.questions);

            document.getElementById('view-modal-title').innerHTML = `
                <span>📖 ${quiz.name} (${validQuestions.length} câu)</span>
                <div class="flex space-x-2">
                    <button onclick="exportQuizToJson(${quiz.id})" class="dev-only bg-amber-600 hover:bg-amber-700 text-white font-semibold py-1.5 px-3 rounded-xl text-xs transition-colors shadow-sm inline-flex items-center">
                        📤 Xuất JSON
                    </button>
                    <button onclick="exportQuizToWord(${quiz.id})" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-1.5 px-3 rounded-xl text-xs transition-colors shadow-sm inline-flex items-center">
                        📥 Xuất Word
                    </button>
                </div>
            `;

            const container = document.getElementById('view-quiz-list-container');
            container.innerHTML = '';

            validQuestions.forEach((q, idx) => {
                let imgsHtml = '';
                if (q.images && q.images.length > 0) {
                    imgsHtml = '<div class="flex flex-wrap gap-2.5 my-2">' + buildImageThumbsHtml(q.images, 120) + '</div>';
                }

                let expImgsHtml = '';
                if (q.explanationImages && q.explanationImages.length > 0) {
                    expImgsHtml = '<div class="flex flex-wrap gap-2 my-2">' + buildImageThumbsHtml(q.explanationImages, 100) + '</div>';
                }

                let optionsHtml = '<ul class="text-sm space-y-1.5 my-2 bg-white p-3 rounded-xl border border-gray-200">';
                q.options.forEach(opt => {
                    optionsHtml += `<li class="text-gray-700 p-1 text-justify break-words">${mathFmt(opt)}</li>`;
                });
                optionsHtml += '</ul>';

                const div = document.createElement('div');
                div.className = 'bg-gray-50 border border-gray-200 p-4 rounded-xl';
                div.innerHTML = `
                    <p class="font-bold text-gray-800 mb-1.5 text-justify break-words">Câu ${idx + 1}: ${mathFmt(getCleanQuestionText(q.question))}</p>
                    ${imgsHtml}
                    ${optionsHtml}
                    <p class="text-sm font-semibold text-green-700 mt-2">Đáp án đúng: <span class="bg-green-100 px-2 py-0.5 rounded">${q.answerStr}</span></p>
                    ${q.explanation ? `<p class="text-xs text-gray-600 italic mt-1.5 bg-blue-50 p-2.5 rounded-xl border border-blue-100 text-justify break-words">Giải thích: ${formatExplanationWithLinks(q.explanation)}</p>` : ''}
                    ${expImgsHtml}
                `;
                container.appendChild(div);
            });

            document.getElementById('view-quiz-modal').classList.remove('hidden');
        }

        function closeViewQuizModal() {
            document.getElementById('view-quiz-modal').classList.add('hidden');
        }

        function getBookmarkedQuestions() {
            const saved = kv.getItem('quizAppBookmarked');
            return saved ? JSON.parse(saved) : [];
        }

        function updateBookmarkBadgeCount() {
            const list = getBookmarkedQuestions();
            const badge = document.getElementById('total-bookmarked-count');
            if (badge) badge.textContent = list.length;
        }

        function toggleBookmarkCurrent() {
            const q = questions[currentIndex];
            let bookmarks = getBookmarkedQuestions();
            const existingIndex = bookmarks.findIndex(item => getCleanQuestionText(item.question) === getCleanQuestionText(q.question));
            
            if (existingIndex > -1) {
                bookmarks.splice(existingIndex, 1);
                showToast("Đã bỏ lưu câu hỏi này!");
            } else {
                bookmarks.push({
                    question: getCleanQuestionText(q.question),
                    options: q.options,
                    answerStr: q.answerStr,
                    explanation: q.explanation,
                    images: q.images || [],
                    explanationImages: q.explanationImages || [],
                    quizName: currentQuizName,
                    isStarred: q.isStarred || false
                });
                showToast("Đã lưu câu hỏi vào danh sách ôn tập!");
            }
            
            kv.setItem('quizAppBookmarked', JSON.stringify(bookmarks));
            updateBookmarkBadgeCount();
            updateBookmarkButtonState();
        }

        function updateBookmarkButtonState() {
            if (!questions[currentIndex]) return;
            const q = questions[currentIndex];
            const bookmarks = getBookmarkedQuestions();
            const isBookmarked = bookmarks.some(item => getCleanQuestionText(item.question) === getCleanQuestionText(q.question));
            
            const icon = document.getElementById('bookmark-icon');
            const text = document.getElementById('bookmark-text');
            const btn = document.getElementById('bookmark-quiz-btn');

            if (isBookmarked) {
                icon.textContent = "⭐";
                text.textContent = "Đã lưu";
                btn.className = "text-amber-700 bg-amber-100 hover:bg-amber-200 py-1.5 px-3.5 rounded-full font-bold text-sm transition-colors border border-amber-400 flex items-center shadow-sm";
            } else {
                icon.textContent = "🔖";
                text.textContent = "Lưu câu";
                btn.className = "text-amber-700 bg-amber-50 hover:bg-amber-100 py-1.5 px-3.5 rounded-full font-bold text-sm transition-colors border border-amber-300 flex items-center shadow-sm";
            }
        }

        function openBookmarkedModal() {
            const bookmarks = getBookmarkedQuestions();
            document.getElementById('modal-bm-count').textContent = bookmarks.length;
            const container = document.getElementById('bookmarked-list-container');
            
            if (bookmarks.length === 0) {
                container.innerHTML = '<p class="text-gray-500 italic text-center py-8">Chưa có câu hỏi nào được lưu.</p>';
            } else {
                container.innerHTML = '';
                bookmarks.forEach((item, idx) => {
                    let imgsHtml = '';
                    if (item.images && item.images.length > 0) {
                        imgsHtml = '<div class="flex flex-wrap gap-2.5 my-2">';
                        item.images.forEach(img => {
                            imgsHtml += `<img src="${img}" onclick="openLightbox('${img}')" class="cursor-pointer hover:opacity-90" style="max-height: 120px; border-radius: 6px; border: 1px solid #ddd;" />`;
                        });
                        imgsHtml += '</div>';
                    }

                    let expImgsHtml = '';
                    if (item.explanationImages && item.explanationImages.length > 0) {
                        expImgsHtml = '<div class="flex flex-wrap gap-2 my-2">';
                        item.explanationImages.forEach(img => {
                            expImgsHtml += `<img src="${img}" onclick="openLightbox('${img}')" class="cursor-pointer hover:opacity-90" style="max-height: 100px; border-radius: 6px; border: 1px solid #ddd;" />`;
                        });
                        expImgsHtml += '</div>';
                    }

                    let optionsHtml = '<ul class="text-sm space-y-1.5 my-2 bg-white p-3 rounded-xl border">';
                    item.options.forEach(opt => {
                        const isCorrectOpt = opt.charAt(0).toUpperCase() === item.answerStr;
                        optionsHtml += `<li class="${isCorrectOpt ? 'font-bold text-green-600' : 'text-gray-700'}">${mathFmt(opt)}</li>`;
                    });
                    optionsHtml += '</ul>';

                    const div = document.createElement('div');
                    div.className = 'bg-amber-50/60 border border-amber-200 p-4 rounded-xl relative';
                    div.innerHTML = `
                        <div class="flex justify-between items-start mb-2">
                            <span class="text-xs font-bold text-amber-800 bg-amber-100 px-2.5 py-1 rounded">Đề: ${item.quizName || 'Không rõ'}</span>
                            <button onclick="removeBookmark(${idx})" class="text-red-500 hover:text-red-700 text-sm font-bold">🗑️ Xóa</button>
                        </div>
                        <p class="font-bold text-gray-800 mb-1">Câu: ${mathFmt(getCleanQuestionText(item.question))}</p>
                        ${imgsHtml}
                        ${optionsHtml}
                        <p class="text-sm font-semibold text-green-700">Đáp án đúng: ${item.answerStr}</p>
                        ${item.explanation ? `<p class="text-xs text-gray-600 italic mt-1">Giải thích: ${formatExplanationWithLinks(item.explanation)}</p>` : ''}
                        ${expImgsHtml}
                    `;
                    container.appendChild(div);
                });
            }
            document.getElementById('bookmarked-modal').classList.remove('hidden');
        }

        function closeBookmarkedModal() {
            document.getElementById('bookmarked-modal').classList.add('hidden');
        }

        function removeBookmark(idx) {
            let bookmarks = getBookmarkedQuestions();
            bookmarks.splice(idx, 1);
            kv.setItem('quizAppBookmarked', JSON.stringify(bookmarks));
            updateBookmarkBadgeCount();
            openBookmarkedModal();
            updateBookmarkButtonState();
        }

        function readQuizFileText(file) {
            return new Promise((resolve, reject) => {
                const reader = new FileReader();
                reader.onerror = () => reject(new Error('Không đọc được file'));
                if (/\.docx$/i.test(file.name)) {
                    reader.onload = ev => mammoth.extractRawText({ arrayBuffer: ev.target.result })
                        .then(r => resolve(r.value)).catch(err => reject(new Error('Lỗi đọc file Word: ' + err.message)));
                    reader.readAsArrayBuffer(file);
                } else if (/\.(txt|md|markdown)$/i.test(file.name)) {
                    reader.onload = ev => resolve(quizFileText(file.name, ev.target.result));
                    reader.readAsText(file);
                } else {
                    reject(new Error('Chỉ hỗ trợ .docx, .txt, .md'));
                }
            });
        }

        // Màn hình chính: chọn file -> tự phân tích, lưu và mở thẳng chế độ chỉnh sửa đề
        document.getElementById('file-input').addEventListener('change', async function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const nameInput = document.getElementById('quiz-name');
            if (!nameInput.value) nameInput.value = file.name.replace(/\.[^/.]+$/, "");
            try {
                document.getElementById('manual-input').value = await readQuizFileText(file);
            } catch (err) {
                showToast(err.message);
                return;
            }
            processAndStart();
        });

        // Màn hình chỉnh sửa: nhập thêm câu hỏi từ file vào bộ đề đang mở
        function triggerEditImportFile() {
            document.getElementById('edit-import-file').click();
        }

        async function importFileIntoEdit(e) {
            const files = Array.from(e.target.files || []);
            e.target.value = '';
            if (!files.length) return;
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (!quiz) return;
            if (importUndo) endImportSession();
            stripImportMarks(quizzes);
            const token = 'imp' + Date.now();
            const firstNew = quiz.questions.length;
            let total = 0;
            for (const file of files) {
                try {
                    const parsed = parseTextToQuestions(await readQuizFileText(file));
                    if (parsed.length === 0) { showToast(`Không nhận diện được câu hỏi nào trong "${file.name}"`); continue; }
                    parsed.forEach(q => { q._imp = token; });
                    quiz.questions = quiz.questions.concat(parsed);
                    total += parsed.length;
                } catch (err) {
                    showToast(`${file.name}: ${err.message}`);
                }
            }
            if (total > 0) {
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                importUndo = { kind: 'append', id: editingQuizId, token: token, added: total };
                updateCancelImportButton();
                renderEditQuestions();
                showToast(`Đã thêm ${total} câu hỏi vào bộ đề!`);
                setTimeout(() => {
                    const card = document.querySelector(`[data-edit-q-index="${firstNew}"]`);
                    if (card) card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }, 150);
            }
        }

        /* ===== PHÂN TÍCH VĂN BẢN → CÂU HỎI =====
           - Câu hỏi & giải thích có thể nhiều dòng, có gạch đầu dòng (•, ◦, ○, -, *, +) hoặc danh sách 1. 2. 3.
           - Giải thích kéo dài đến khi gặp "Câu N" (có kèm các đáp án A, B ở phía sau) hoặc hết văn bản.
           - Dòng "A. ..." nằm trong phần giải thích được hiểu là nội dung giải thích, không phải đáp án. */
        function parseTextToQuestions(text) {
            text = mathToPlain(text);

            const BULLET_RE = /^(?:[◦○●•▪▫■□►▸‣⁃∙·⦁◆◇]\s*|[-–—*+]\s+)/;
            const QS_RE  = /^(?:câu(?:\s*hỏi)?|bài|question)\s*\d+\s*[:.\-)]?\s*/i;
            const NUM_RE = /^[1-9]\d*[.)]\s+\S/;
            const OPT_RE = /^([A-Da-d])(?:[.)]|-(?=\s))\s*/;
            const ANS_RE = /^(?:(?:đáp\s*án|đáp\s*số|answer|ans|key|câu\s*trả\s*lời)(?:\s*đúng)?(?:\s*là)?|đúng|chọn|(?:đ|đa|đ\/a)(?=\s*[:：=]))\s*[:：\-–=.]?\s*\(?([A-Da-d])\)?(?![\p{L}\p{N}])/iu;
            const EXP_RE = /^(?:(?:giải\s*thích(?:\s*chi\s*tiết)?|lời\s*giải(?:\s*chi\s*tiết)?|giải\s*chi\s*tiết|explanation)(?=[\s:：\-–]|$)|(?:hướng\s*dẫn(?:\s*giải)?|giải\s*đáp|giải)(?=\s*(?:[:：]|$)))\s*[:：\-–]?\s*/i;
            const LIST_RE = /^(?:\d{1,2}[.)]|[A-Za-z][.)]|[ivxIVX]{1,4}\))\s+/;

            // 1) Chuẩn hóa từng dòng
            const items = String(text).replace(/\r\n?/g, '\n').split('\n').map(raw => {
                let t = raw.replace(/[\u00A0\u200B\uFEFF]/g, ' ').replace(/\*\*/g, '').trim();
                if (!t) return { blank: true };
                let bullet = false;
                const bm = t.match(BULLET_RE);
                if (bm) {
                    bullet = true;
                    t = t.slice(bm[0].length).trim();
                    if (!t) return { blank: true };
                }
                return {
                    blank: false, bullet: bullet, text: t,
                    qs: t.match(QS_RE), num: NUM_RE.test(t),
                    opt: t.match(OPT_RE), ans: t.match(ANS_RE), exp: t.match(EXP_RE)
                };
            });

            // 2) Nhìn trước: dòng thứ i có thực sự là đầu một câu hỏi mới không?
            //    (phía sau nó phải có đáp án A, "Đáp án:" hoặc "Giải thích:" trước khi gặp câu khác)
            const bodyAhead = (i, weak, limit) => {
                let seen = 0;
                for (let j = i + 1; j < items.length && seen < limit; j++) {
                    const n = items[j];
                    if (n.blank) continue;
                    seen++;
                    if (n.qs) return false;
                    if (weak && n.num) return false;
                    if (n.opt) return /^a$/i.test(n.opt[1]);
                    if (n.ans || n.exp) return true;
                }
                return false;
            };

            const questions = [];
            let cur = null, field = null, brk = false;

            const flush = () => {
                if (cur && cur.answerStr) {
                    cur.question = cur.question.trim();
                    cur.explanation = cur.explanation.trim();
                    questions.push(cur);
                }
            };
            const newQ = (txt) => {
                flush();
                cur = { question: txt || '', images: [], explanationImages: [], options: [], answerStr: null, explanation: '', isStarred: false, isHidden: false };
                field = 'question';
                brk = false;
            };
            const addText = (prop, txt, bullet) => {
                const t = (bullet ? '• ' : '') + txt;
                const prev = cur[prop];
                if (!prev) {
                    cur[prop] = t;
                } else {
                    const nl = brk || bullet || LIST_RE.test(txt) || (/[.!?…:;]$/.test(prev) && /^\p{Lu}/u.test(txt));
                    cur[prop] = prev + (nl ? '\n' : ' ') + t;
                }
                brk = false;
            };
            const stripQPrefix = (it) => (it.qs ? it.text.slice(it.qs[0].length) : it.text.replace(/^[1-9]\d*[.)]\s*/, '')).trim();

            for (let i = 0; i < items.length; i++) {
                const it = items[i];
                if (it.blank) { brk = true; continue; }

                // Chưa có câu nào: chờ dòng mở đầu
                if (!cur) {
                    if (it.qs || (!it.opt && !it.ans && !it.exp)) newQ(stripQPrefix(it));
                    continue;
                }

                // Có phải câu hỏi mới?
                let isNew = false;
                if (field === 'question') {
                    isNew = !!it.qs; // đang ở phần đề: dòng 1. 2. hoặc gạch đầu dòng chỉ là ý nhỏ của đề
                } else if (it.qs || it.num) {
                    isNew = bodyAhead(i, !it.qs, 30);
                } else if (!it.opt && !it.ans && !it.exp) {
                    isNew = bodyAhead(i, true, field === 'explanation' ? 1 : 4);
                }
                if (isNew) { newQ(stripQPrefix(it)); continue; }

                const inExp = field === 'explanation';

                // Đáp án A/B/C/D (trong phần giải thích thì đó là nội dung giải thích)
                if (it.opt && !inExp) {
                    cur.options.push(it.text);
                    field = 'option';
                    brk = false;
                    continue;
                }

                // Dòng "Đáp án: X"
                let ansLetter = null, ansRest = '';
                if (it.ans && (!inExp || !cur.answerStr)) {
                    ansLetter = it.ans[1].toUpperCase();
                    ansRest = it.text.slice(it.ans[0].length);
                } else if (!inExp && cur.options.length > 0 && it.text.length <= 80 && /đáp\s*án|đáp\s*số|đúng/i.test(it.text)) {
                    const lm = it.text.match(/(?:^|[^\p{L}\p{N}])([A-D])(?![\p{L}\p{N}])/u);
                    if (lm) ansLetter = lm[1];
                }
                if (ansLetter) {
                    cur.answerStr = ansLetter;
                    brk = false;
                    if (!inExp) field = 'answer';
                    // "Đáp án: B. Giải thích: ..." trên cùng một dòng
                    const em = ansRest.match(/(?:giải\s*thích|lời\s*giải|hướng\s*dẫn(?:\s*giải)?)\s*[:：]\s*/i);
                    if (em) {
                        cur.explanation = ansRest.slice(em.index + em[0].length).trim();
                        field = 'explanation';
                    }
                    continue;
                }

                // Dòng "Giải thích: ..."
                if (it.exp && (field !== 'question' || /[:：]/.test(it.exp[0]) || it.text.length === it.exp[0].trim().length)) {
                    const rest = it.text.slice(it.exp[0].length).trim();
                    if (cur.explanation) { if (rest) addText('explanation', rest, it.bullet); }
                    else cur.explanation = rest;
                    field = 'explanation';
                    brk = false;
                    continue;
                }

                // Các dòng còn lại: nối vào phần đang đọc
                if (field === 'question') {
                    addText('question', it.text, it.bullet);
                } else if (field === 'option') {
                    cur.options[cur.options.length - 1] += ' ' + it.text; // đáp án bị xuống dòng
                    brk = false;
                } else {
                    field = 'explanation'; // gồm cả trường hợp giải thích không có nhãn "Giải thích:"
                    addText('explanation', it.text, it.bullet);
                }
            }
            flush();
            return questions;
        }

        function processAndStart() {
            const errorMsg = document.getElementById('error-msg');
            errorMsg.classList.add('hidden');
            errorMsg.textContent = '';

            const text = document.getElementById('manual-input').value.trim();
            if (!text) {
                errorMsg.textContent = "Vui lòng tải file hoặc dán nội dung câu hỏi vào ô văn bản!";
                errorMsg.classList.remove('hidden');
                return;
            }

            const parsed = parseTextToQuestions(text);
            if (parsed.length === 0) {
                errorMsg.textContent = "Không nhận diện được câu hỏi nào. Vui lòng kiểm tra lại định dạng soạn đề!";
                errorMsg.classList.remove('hidden');
                return;
            }

            const name = document.getElementById('quiz-name').value.trim();
            const newId = saveQuizToStorage(name, parsed);

            document.getElementById('manual-input').value = '';
            document.getElementById('quiz-name').value = '';
            document.getElementById('quiz-folder').value = '';
            document.getElementById('file-input').value = '';

            renderSavedQuizzes();
            showToast(`Đã lưu bộ đề với ${parsed.length} câu hỏi!`);
            importUndo = { kind: 'new', id: newId };
            openEditScreen(newId);
        }

        function getSavedQuizzes() {
            const saved = kv.getItem('quizAppSavedQuizzes');
            return saved ? JSON.parse(saved) : [];
        }

        function saveQuizToStorage(name, qList) {
            const quizzes = getSavedQuizzes();
            let folderInput = document.getElementById('quiz-folder').value.trim().replace(/\s*\/\s*/g, '/') || "Chung";

            const newQuiz = {
                id: Date.now(),
                name: name || `Bộ đề ngày ${new Date().toLocaleDateString('vi-VN')}`,
                folder: folderInput,
                questions: qList,
                date: new Date().toLocaleDateString('vi-VN')
            };
            quizzes.unshift(newQuiz);
            kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            return newQuiz.id;
        }

        function deleteQuiz(id) {
            let quizzes = getSavedQuizzes();
            quizzes = quizzes.filter(q => q.id !== id);
            kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            kv.removeItem(`quizAppActiveSession_${id}`);
            renderSavedQuizzes();
            showToast("Đã xóa bộ đề!");
        }

        function saveQuizResult(score, total) {
            if (!currentQuizId || typeof currentQuizId === 'string') return;
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === currentQuizId);
            if (!quiz) return;
            const newRatio = total > 0 ? score / total : 0;
            const oldRatio = quiz.bestResult && quiz.bestResult.total > 0 ? quiz.bestResult.score / quiz.bestResult.total : -1;
            if (newRatio > oldRatio) {
                quiz.bestResult = {
                    score: score,
                    total: total,
                    date: new Date().toLocaleDateString('vi-VN')
                };
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            }
        }

        function exportJsonFile() {
            const quizzes = getSavedQuizzes();
            const coverImage = kv.getItem('quizAppCoverImage') || '';
            const backupData = { quizzes, coverImage };
            const data = JSON.stringify(backupData, null, 2);

            downloadTextFile(data, 'import-manifest.json', 'application/json');
            showToast("Đã xuất file import-manifest.json");
        }

        function downloadTextFile(content, fileName, mime) {
            const blob = new Blob([content], { type: mime });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        }

        function triggerImportMultipleJson() {
            document.getElementById('import-multiple-json-input').click();
        }

        function importJsonFile(e) {
            const file = e.target.files && e.target.files[0];
            if (!file) return;
            e.target.value = '';

            const reader = new FileReader();
            reader.onload = function(event) {
                try {
                    const parsed = JSON.parse(event.target.result);
                    let quizzes = getSavedQuizzes();
                    let successCount = 0;

                    if (parsed && parsed.coverImage) {
                        kv.setItem('quizAppCoverImage', parsed.coverImage);
                    }

                    const qArray = parsed && parsed.quizzes ? parsed.quizzes : (Array.isArray(parsed) ? parsed : null);
                    if (Array.isArray(qArray)) {
                        qArray.forEach(item => {
                            if (item && item.name && item.questions) {
                                item.id = Date.now() + Math.floor(Math.random() * 10000);
                                if (!item.folder) item.folder = "Chung";
                                quizzes.unshift(item);
                                successCount++;
                            }
                        });
                    } else if (parsed && typeof parsed === 'object' && parsed.name && parsed.questions) {
                        parsed.id = Date.now() + Math.floor(Math.random() * 10000);
                        if (!parsed.folder) parsed.folder = "Chung";
                        quizzes.unshift(parsed);
                        successCount++;
                    }

                    if (successCount > 0) {
                        kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                        loadCoverImage();
                        renderSavedQuizzes();
                        openStorageModal();
                        showToast(`Đã nhập thành công ${successCount} bộ đề!`);
                    } else {
                        showToast("File JSON không đúng định dạng bộ đề!");
                    }
                } catch (err) {
                    console.error("Lỗi đọc file JSON:", err);
                    showToast("File JSON bị lỗi, không đọc được!");
                }
            };
            reader.readAsText(file);
        }

        function importMultipleJsonFiles(e) {
            const fileArray = Array.from(e.target.files || []);
            const totalFiles = fileArray.length;
            if (totalFiles === 0) return;
            e.target.value = '';

            let quizzes = getSavedQuizzes();
            let successCount = 0;
            let processed = 0;

            function finishIfDone() {
                processed++;
                if (processed < totalFiles) return;
                if (successCount > 0) {
                    kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                    loadCoverImage();
                    renderSavedQuizzes();
                    openStorageModal();
                    showToast(`Đã nhập thành công ${successCount} bộ đề từ ${totalFiles} file!`);
                } else {
                    showToast(`Không nhập được bộ đề nào từ ${totalFiles} file. Kiểm tra lại định dạng JSON!`);
                }
            }

            fileArray.forEach(file => {
                const reader = new FileReader();
                reader.onload = function(event) {
                    try {
                        const parsed = JSON.parse(event.target.result);
                        if (parsed && parsed.coverImage) {
                            kv.setItem('quizAppCoverImage', parsed.coverImage);
                        }
                        const qArray = parsed && parsed.quizzes ? parsed.quizzes : (Array.isArray(parsed) ? parsed : null);
                        if (Array.isArray(qArray)) {
                            qArray.forEach(item => {
                                if (item && item.name && item.questions) {
                                    item.id = Date.now() + Math.floor(Math.random() * 10000);
                                    if (!item.folder) item.folder = "Chung";
                                    quizzes.unshift(item);
                                    successCount++;
                                }
                            });
                        } else if (parsed && typeof parsed === 'object' && parsed.name && parsed.questions) {
                            parsed.id = Date.now() + Math.floor(Math.random() * 10000);
                            if (!parsed.folder) parsed.folder = "Chung";
                            quizzes.unshift(parsed);
                            successCount++;
                        }
                    } catch (err) {
                        console.error("Lỗi đọc file JSON:", file.name, err);
                    }
                    finishIfDone();
                };
                reader.onerror = function() {
                    console.error("Không đọc được file:", file.name);
                    finishIfDone();
                };
                reader.readAsText(file);
            });
        }

        function autoResizeMany(cards) {
            const tas = [];
            cards.forEach(c => c.querySelectorAll('textarea').forEach(t => tas.push(t)));
            tas.forEach(t => { t.style.height = 'auto'; });
            const hs = tas.map(t => t.scrollHeight + 4);
            tas.forEach((t, i) => { t.style.height = hs[i] + 'px'; });
        }

        function autoResize(textarea) {
            textarea.style.height = 'auto';
            textarea.style.height = (textarea.scrollHeight + 4) + 'px';
        }

        function openEditScreen(id, targetIndex = null) {
            editingQuizId = id;
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === id);
            if (!quiz) return;

            initEditTopicSelect();

            const nameInput = document.getElementById('edit-quiz-name-input');
            if (nameInput) nameInput.value = quiz.name;
            const folderInput = document.getElementById('edit-quiz-folder-input');
            const folderVal = quiz.folder || (quiz.isExam ? "Thi Thử" : "Chung");
            if (folderInput) folderInput.value = folderVal;
            syncEditTopicSelect(folderVal);
            
            if (importUndo && importUndo.id !== id) importUndo = null;
            document.getElementById('home-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('edit-screen').classList.remove('hidden');

            updateEditHeaderButtons();
            renderEditQuestions(targetIndex === null || targetIndex === undefined);

            if (targetIndex !== null && targetIndex !== undefined) {
                setTimeout(() => {
                    const targetCard = document.querySelector(`[data-edit-q-index="${targetIndex}"]`);
                    if (targetCard) {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        targetCard.classList.add('ring-4', 'ring-indigo-600', 'transition-all');
                        setTimeout(() => {
                            targetCard.classList.remove('ring-4', 'ring-indigo-600');
                        }, 2500);
                    }
                }, 150);
            }
        }

        // Phiên nhập file: {kind:'new'|'append', id, token, added}
        let importUndo = null;

        function updateCancelImportButton() {
            const btn = document.getElementById('cancel-import-btn');
            if (!btn) return;
            if (!importUndo) { btn.classList.add('hidden'); return; }
            btn.textContent = importUndo.kind === 'new' ? '↩️ Huỷ nhập & về trang chủ' : `↩️ Huỷ nhập file vừa rồi (+${importUndo.added})`;
            btn.classList.remove('hidden');
        }

        function stripImportMarks(quizzes) {
            let changed = false;
            quizzes.forEach(qz => (qz.questions || []).forEach(q => { if (q && q._imp !== undefined) { delete q._imp; changed = true; } }));
            return changed;
        }

        function endImportSession() {
            if (importUndo && importUndo.kind === 'append') {
                const quizzes = getSavedQuizzes();
                if (stripImportMarks(quizzes)) kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            }
            importUndo = null;
            updateCancelImportButton();
        }

        function cancelImportAndBack() {
            if (!importUndo) return;
            const u = importUndo;
            if (!confirm(u.kind === 'new' ? 'Huỷ nhập và xoá bộ đề vừa tạo?' : `Huỷ nhập ${u.added} câu hỏi vừa thêm?`)) return;
            let quizzes = getSavedQuizzes();
            if (u.kind === 'new') {
                quizzes = quizzes.filter(q => q.id !== u.id);
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                kv.removeItem(`quizAppActiveSession_${u.id}`);
                importUndo = null;
                isEditingFromQuiz = false;
                editRenderToken++;
                document.getElementById('edit-screen').classList.add('hidden');
                document.getElementById('home-screen').classList.remove('hidden');
                renderSavedQuizzes();
                showToast('Đã huỷ nhập, quay lại trang chủ.');
            } else {
                const quiz = quizzes.find(q => q.id === u.id);
                if (quiz) {
                    quiz.questions = quiz.questions.filter(q => q._imp !== u.token);
                    stripImportMarks(quizzes);
                    kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                }
                importUndo = null;
                renderEditQuestions();
                updateCancelImportButton();
                showToast('Đã huỷ phần vừa nhập.');
            }
        }

        function updateEditHeaderButtons() {
            updateCancelImportButton();
            const btn = document.getElementById('return-to-quiz-btn');
            if (btn) {
                if (isEditingFromQuiz) {
                    btn.classList.remove('hidden');
                    btn.classList.add('flex');
                } else {
                    btn.classList.add('hidden');
                    btn.classList.remove('flex');
                }
            }
        }

        let editRenderToken = 0;
        function renderEditQuestions(progressive) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (!quiz) return;

            const container = document.getElementById('edit-questions-container');
            
            const layoutVal = document.getElementById('edit-layout-select') ? document.getElementById('edit-layout-select').value : 'list';
            if (layoutVal === 'grid-3') {
                container.className = 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start';
            } else {
                container.className = 'space-y-6';
            }

            container.innerHTML = '';

            let list = quiz.questions.map((q, originalIdx) => ({ q, originalIdx }));

            const filterVal = document.getElementById('edit-filter-select') ? document.getElementById('edit-filter-select').value : 'all';
            if (filterVal === 'starred') {
                list = list.filter(item => item.q.isStarred);
            } else if (filterVal === 'hidden') {
                list = list.filter(item => item.q.isHidden);
            } else if (filterVal === 'visible') {
                list = list.filter(item => !item.q.isHidden);
            }

            const sortVal = document.getElementById('edit-sort-select') ? document.getElementById('edit-sort-select').value : 'original';
            if (sortVal === 'newest') {
                list.sort((a, b) => b.originalIdx - a.originalIdx);
            } else if (sortVal === 'oldest') {
                list.sort((a, b) => a.originalIdx - b.originalIdx);
            } else if (sortVal === 'name_az') {
                list.sort((a, b) => getCleanQuestionText(a.q.question).localeCompare(getCleanQuestionText(b.q.question)));
            } else if (sortVal === 'name_za') {
                list.sort((a, b) => getCleanQuestionText(b.q.question).localeCompare(getCleanQuestionText(a.q.question)));
            }

            if (list.length === 0) {
                container.innerHTML = '<p class="col-span-full text-gray-500 italic text-center py-8">Không có câu hỏi nào thỏa mãn bộ lọc.</p>';
                return;
            }

            const renderOne = (itemObj) => {
                const q = itemObj.q;
                const index = itemObj.originalIdx;

                if (!q.images) q.images = [];
                if (!q.explanationImages) q.explanationImages = [];
                if (q.isStarred === undefined) q.isStarred = false;
                if (q.isHidden === undefined) q.isHidden = false;

                let imagesHtml = '';
                if (q.images.length > 0) {
                    imagesHtml = '<div class="flex flex-wrap gap-2 mb-2">';
                    q.images.forEach((imgSrc, imgIdx) => {
                        imagesHtml += `
                            <div class="relative inline-block border rounded-xl bg-white p-1 shadow-sm">
                                <img src="${imgSrc}" onclick="openLightbox('${imgSrc}')" class="cursor-pointer hover:opacity-90" style="height: 65px; width: 65px; object-fit: contain;" />
                                <button onclick="removeQuestionImage(${index}, ${imgIdx})" title="Xóa ảnh này" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center font-bold hover:bg-red-700 shadow">✕</button>
                            </div>
                        `;
                    });
                    imagesHtml += '</div>';
                }

                let uploadControl = '';
                if (q.images.length < 5) {
                    uploadControl = `
                        <div class="flex flex-wrap gap-2 items-center">
                            <label class="inline-block bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 font-semibold py-1.5 px-2.5 rounded-xl text-xs cursor-pointer shadow-sm transition-colors">
                                📷 Thêm ảnh (${q.images.length}/5)
                                <input type="file" accept="image/*" class="hidden" onchange="attachImageToQuestion(${index}, this)">
                            </label>
                            <button type="button" onclick="pasteImageToQuestion(${index})" class="inline-block bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 font-semibold py-1.5 px-2.5 rounded-xl text-xs cursor-pointer shadow-sm transition-colors">
                                📋 Dán ảnh
                            </button>
                        </div>
                    `;
                } else {
                    uploadControl = `<span class="text-xs text-red-500 font-semibold bg-red-50 py-1.5 px-3 rounded-xl border border-red-200">Đã đạt tối đa 5 ảnh</span>`;
                }

                let expImagesHtml = '';
                if (q.explanationImages.length > 0) {
                    expImagesHtml = '<div class="flex flex-wrap gap-2 mb-2">';
                    q.explanationImages.forEach((imgSrc, imgIdx) => {
                        expImagesHtml += `
                            <div class="relative inline-block border rounded-xl bg-white p-1 shadow-sm">
                                <img src="${imgSrc}" onclick="openLightbox('${imgSrc}')" class="cursor-pointer hover:opacity-90" style="height: 65px; width: 65px; object-fit: contain;" />
                                <button onclick="removeExplanationImage(${index}, ${imgIdx})" title="Xóa ảnh này" class="absolute -top-2 -right-2 bg-red-500 text-white rounded-full w-5 h-5 text-xs flex items-center justify-center font-bold hover:bg-red-700 shadow">✕</button>
                            </div>
                        `;
                    });
                    expImagesHtml += '</div>';
                }

                let expUploadControl = '';
                if (q.explanationImages.length < 5) {
                    expUploadControl = `
                        <div class="flex flex-wrap gap-2 items-center">
                            <label class="inline-block bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 font-semibold py-1.5 px-2.5 rounded-xl text-xs cursor-pointer shadow-sm transition-colors">
                                🖼️ Thêm ảnh (${q.explanationImages.length}/5)
                                <input type="file" accept="image/*" class="hidden" onchange="attachImageToExplanation(${index}, this)">
                            </label>
                            <button type="button" onclick="pasteImageToExplanation(${index})" class="inline-block bg-white border border-gray-300 hover:bg-gray-100 text-gray-700 font-semibold py-1.5 px-2.5 rounded-xl text-xs cursor-pointer shadow-sm transition-colors">
                                📋 Dán ảnh
                            </button>
                        </div>
                    `;
                } else {
                    expUploadControl = `<span class="text-xs text-red-500 font-semibold bg-red-50 py-1.5 px-3 rounded-xl border border-red-200">Đã đạt tối đa 5 ảnh</span>`;
                }

                let optionsInputsHtml = '';
                q.options.forEach((opt, optIdx) => {
                    const isOptEmpty = !opt.replace(/^[A-D][\.\)]\s*/, '').trim();
                    optionsInputsHtml += `
                        <div class="flex items-center space-x-2">
                            <textarea rows="1" class="w-full p-2.5 border rounded-xl text-sm focus:ring-2 focus:ring-blue-500 outline-none bg-white resize-none overflow-hidden leading-normal ${isOptEmpty ? 'input-empty-warning' : ''}" oninput="this.classList.toggle('input-empty-warning', !this.value.replace(/^[A-D][\\.\\)]\\s*/, '').trim()); updateQuestionOption(${index}, ${optIdx}, this.value); autoResize(this);">${opt}</textarea>
                        </div>
                    `;
                });

                const cardEl = document.createElement('div');
                cardEl.setAttribute('data-edit-q-index', index);
                let cardBorderClass = q.isHidden ? 'border-4 border-dashed border-gray-400 bg-gray-50 opacity-75' : (q.isStarred ? 'border-4 border-amber-400 shadow-xl bg-amber-50/25' : 'border-4 border-indigo-600 shadow-2xl bg-white');
                
                const isQTextEmpty = !getCleanQuestionText(q.question).trim();
                const isAnsEmpty = !(q.answerStr || '').trim();
                const isExpEmpty = !(q.explanation || '').trim();

                cardEl.className = `${cardBorderClass} p-6 rounded-2xl space-y-4 relative transition-all`;
                cardEl.innerHTML = `
                    <div class="flex justify-between items-center mb-1 pb-2 border-b-2 border-indigo-200 flex-wrap gap-2">
                        <div class="flex items-center space-x-2">
                            <label class="block text-sm font-black text-indigo-800 uppercase">Câu ${index + 1}</label>
                            ${q.isHidden ? '<span class="text-xs bg-gray-200 text-gray-700 font-bold px-2 py-0.5 rounded-full">👁️‍🗨️ ĐÃ ẨN</span>' : ''}
                            ${q.isStarred ? '<span class="text-xs bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded-full">⭐ SAO</span>' : ''}
                        </div>
                        <div class="flex space-x-2 flex-wrap gap-y-1">
                            <button onclick="toggleQuestionStar(${index})" class="${q.isStarred ? 'bg-amber-500 text-white border-amber-600' : 'bg-amber-50 hover:bg-amber-100 text-amber-700 border-amber-200'} border font-bold px-3 py-1.5 rounded-xl text-xs transition-colors flex items-center shadow-sm">
                                ${q.isStarred ? '⭐ Bỏ sao' : '⭐ Đánh dấu sao'}
                            </button>
                            <button onclick="toggleQuestionHide(${index})" class="${q.isHidden ? 'bg-gray-700 text-white' : 'bg-gray-100 hover:bg-gray-200 text-gray-700'} border font-bold px-3 py-1.5 rounded-xl text-xs transition-colors flex items-center shadow-sm">
                                ${q.isHidden ? '👁️ Hiện câu' : '👁️‍🗨️ Ẩn câu'}
                            </button>
                            <button onclick="copyQuestionCard(${index})" class="bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200 font-bold px-3 py-1.5 rounded-xl text-xs transition-colors flex items-center shadow-sm">
                                📋 Sao chép câu
                            </button>
                            <button onclick="deleteQuestion(${index})" class="bg-red-50 hover:bg-red-100 text-red-600 border border-red-200 font-bold px-3 py-1.5 rounded-xl text-xs transition-colors flex items-center shadow-sm">
                                🗑️ Xóa câu hỏi
                            </button>
                        </div>
                    </div>

                    <div>
                        <textarea rows="1" class="w-full p-3.5 border-2 border-indigo-400 rounded-xl text-sm font-bold text-gray-800 focus:ring-2 focus:ring-indigo-500 outline-none bg-gray-50/50 resize-none overflow-hidden leading-normal ${isQTextEmpty ? 'input-empty-warning' : ''}" oninput="this.classList.toggle('input-empty-warning', !this.value.trim()); updateQuestionText(${index}, this.value); autoResize(this);">${getCleanQuestionText(q.question)}</textarea>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Các đáp án</label>
                        <div class="space-y-2">${optionsInputsHtml}</div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Đáp án đúng (A/B/C/D)</label>
                            <input type="text" maxlength="1" value="${q.answerStr || ''}" class="w-full p-2.5 border rounded-xl text-sm uppercase font-bold text-green-700 bg-green-50 focus:ring-2 focus:ring-blue-500 outline-none ${isAnsEmpty ? 'input-empty-warning' : ''}" oninput="this.classList.toggle('input-empty-warning', !this.value.trim()); updateQuestionAnswer(${index}, this.value)">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1">Giải thích (Hỗ trợ Text & Hyperlink URL)</label>
                            <textarea rows="1" class="w-full p-2.5 border rounded-xl text-sm italic text-gray-700 bg-white focus:ring-2 focus:ring-blue-500 outline-none resize-none overflow-hidden leading-normal ${isExpEmpty ? 'input-empty-warning' : ''}" placeholder="Nhập giải thích hoặc dán Link URL https://..." oninput="this.classList.toggle('input-empty-warning', !this.value.trim()); updateQuestionExplanation(${index}, this.value); autoResize(this);">${q.explanation || ''}</textarea>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-3 border-t border-gray-200">
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1.5">Ảnh minh họa câu hỏi</label>
                            ${imagesHtml}
                            <div>${uploadControl}</div>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-gray-500 uppercase mb-1.5">Ảnh giải thích</label>
                            ${expImagesHtml}
                            <div>${expUploadControl}</div>
                        </div>
                    </div>
                `;
                container.appendChild(cardEl);
                return cardEl;
            };

            const finish = () => {
            const bottomAddDiv = document.createElement('div');
            bottomAddDiv.className = 'col-span-full flex justify-center mt-6 pt-4 border-t border-gray-200';
            bottomAddDiv.innerHTML = `
                <button onclick="openAddQuestionModal(null)" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-2xl text-base shadow-md transition-colors flex items-center">
                    ➕ Thêm câu hỏi tiếp theo
                </button>
            `;
            container.appendChild(bottomAddDiv);
            };

            // Tránh đơ trình duyệt: đo/đặt chiều cao textarea theo lô (2 lần reflow/lô thay vì mỗi ô một lần),
            // và với bộ đề lớn thì dựng dần từng đợt.
            const token = ++editRenderToken;
            if (progressive === true && list.length > 20) {
                let i = 0;
                const step = () => {
                    if (token !== editRenderToken) return;
                    const els = [];
                    const end = Math.min(i + 12, list.length);
                    for (; i < end; i++) els.push(renderOne(list[i]));
                    autoResizeMany(els);
                    if (i < list.length) setTimeout(step, 0); else finish();
                };
                step();
            } else {
                const els = list.map(renderOne);
                finish();
                requestAnimationFrame(() => { if (token === editRenderToken) autoResizeMany(els); });
            }
        }

        /* ===== NÚT ⬇️: NHẢY TỚI CÂU CÓ PHẦN BỊ BỎ TRỐNG ===== */
        let lastEmptyJumpCard = null;
        function jumpToNextEmptyQuestion() {
            const container = document.getElementById('edit-questions-container');
            if (!container) return;
            const cards = Array.from(container.querySelectorAll('[data-edit-q-index]'))
                .filter(c => c.querySelector('.input-empty-warning'));
            if (cards.length === 0) {
                lastEmptyJumpCard = null;
                showToast('✅ Không có câu nào bị bỏ trống!');
                return;
            }
            // Mốc tìm kiếm: mép trên khung nhìn; nếu đang xem câu vừa nhảy tới thì tìm tiếp bên dưới câu đó
            let refY = 80;
            if (lastEmptyJumpCard && lastEmptyJumpCard.isConnected) {
                const r = lastEmptyJumpCard.getBoundingClientRect();
                if (r.bottom > 0 && r.top < window.innerHeight) refY = Math.max(refY, r.bottom);
            }
            let target = cards.find(c => c.getBoundingClientRect().top >= refY - 2);
            let wrapped = false;
            if (!target) { target = cards[0]; wrapped = true; }
            lastEmptyJumpCard = target;

            const emptyEls = Array.from(target.querySelectorAll('.input-empty-warning'));
            const labels = [];
            emptyEls.forEach(el => {
                let name = 'câu hỏi';
                if (el.tagName === 'INPUT') name = 'đáp án đúng';
                else if (/giải thích/i.test(el.placeholder || '')) name = 'giải thích';
                else if (el.parentElement && el.parentElement.parentElement && el.parentElement.parentElement.classList.contains('space-y-2')) name = 'nội dung đáp án';
                if (labels.indexOf(name) < 0) labels.push(name);
            });

            emptyEls[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
            emptyEls.forEach(el => {
                el.classList.remove('empty-jump-pulse');
                void el.offsetWidth;
                el.classList.add('empty-jump-pulse');
                setTimeout(() => el.classList.remove('empty-jump-pulse'), 2400);
            });

            const pos = cards.indexOf(target) + 1;
            const qNo = Number(target.getAttribute('data-edit-q-index')) + 1;
            showToast(`${wrapped ? '↩️ Về câu trống đầu tiên · ' : ''}Câu ${qNo}: thiếu ${labels.join(', ')} (${pos}/${cards.length} câu trống)`);
        }

        function attachImageToQuestion(qIndex, inputElement) {
            const file = inputElement.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(event) {
                const base64Img = event.target.result;
                const quizzes = getSavedQuizzes();
                const quiz = quizzes.find(q => q.id === editingQuizId);
                if (quiz) {
                    if (!quiz.questions[qIndex].images) quiz.questions[qIndex].images = [];
                    if (quiz.questions[qIndex].images.length < 5) {
                        quiz.questions[qIndex].images.push(base64Img);
                        kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                        renderEditQuestions();
                    } else {
                        showToast("Chỉ được gắn tối đa 5 ảnh cho mỗi câu hỏi!");
                    }
                }
            };
            reader.readAsDataURL(file);
        }

        async function pasteImageToQuestion(qIndex) {
            try {
                const clipboardItems = await navigator.clipboard.read();
                for (const clipboardItem of clipboardItems) {
                    for (const type of clipboardItem.types) {
                        if (type.startsWith('image/')) {
                            const blob = await clipboardItem.getType(type);
                            const reader = new FileReader();
                            reader.onload = function(event) {
                                const base64Img = event.target.result;
                                const quizzes = getSavedQuizzes();
                                const quiz = quizzes.find(q => q.id === editingQuizId);
                                if (quiz) {
                                    if (!quiz.questions[qIndex].images) quiz.questions[qIndex].images = [];
                                    if (quiz.questions[qIndex].images.length < 5) {
                                        quiz.questions[qIndex].images.push(base64Img);
                                        kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                                        renderEditQuestions();
                                        showToast("Đã dán ảnh từ clipboard thành công!");
                                    } else {
                                        showToast("Chỉ được gắn tối đa 5 ảnh cho mỗi câu hỏi!");
                                    }
                                }
                            };
                            reader.readAsDataURL(blob);
                            return;
                        }
                    }
                }
                showToast("Không tìm thấy ảnh trong clipboard!");
            } catch (err) {
                showToast("Hãy sao chép ảnh vào clipboard rồi bấm dán lại!");
            }
        }

        function removeQuestionImage(qIndex, imgIdx) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz && quiz.questions[qIndex].images) {
                quiz.questions[qIndex].images.splice(imgIdx, 1);
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                renderEditQuestions();
            }
        }

        function attachImageToExplanation(qIndex, inputElement) {
            const file = inputElement.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(event) {
                const base64Img = event.target.result;
                const quizzes = getSavedQuizzes();
                const quiz = quizzes.find(q => q.id === editingQuizId);
                if (quiz) {
                    if (!quiz.questions[qIndex].explanationImages) quiz.questions[qIndex].explanationImages = [];
                    if (quiz.questions[qIndex].explanationImages.length < 5) {
                        quiz.questions[qIndex].explanationImages.push(base64Img);
                        kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                        renderEditQuestions();
                    } else {
                        showToast("Chỉ được gắn tối đa 5 ảnh giải thích cho mỗi câu!");
                    }
                }
            };
            reader.readAsDataURL(file);
        }

        async function pasteImageToExplanation(qIndex) {
            try {
                const clipboardItems = await navigator.clipboard.read();
                for (const clipboardItem of clipboardItems) {
                    for (const type of clipboardItem.types) {
                        if (type.startsWith('image/')) {
                            const blob = await clipboardItem.getType(type);
                            const reader = new FileReader();
                            reader.onload = function(event) {
                                const base64Img = event.target.result;
                                const quizzes = getSavedQuizzes();
                                const quiz = quizzes.find(q => q.id === editingQuizId);
                                if (quiz) {
                                    if (!quiz.questions[qIndex].explanationImages) quiz.questions[qIndex].explanationImages = [];
                                    if (quiz.questions[qIndex].explanationImages.length < 5) {
                                        quiz.questions[qIndex].explanationImages.push(base64Img);
                                        kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                                        renderEditQuestions();
                                        showToast("Đã dán ảnh giải thích từ clipboard!");
                                    } else {
                                        showToast("Chỉ được gắn tối đa 5 ảnh giải thích cho mỗi câu!");
                                    }
                                }
                            };
                            reader.readAsDataURL(blob);
                            return;
                        }
                    }
                }
                showToast("Không tìm thấy ảnh trong clipboard!");
            } catch (err) {
                showToast("Hãy sao chép ảnh vào clipboard rồi bấm dán lại!");
            }
        }

        function removeExplanationImage(qIndex, imgIdx) {
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === editingQuizId);
            if (quiz && quiz.questions[qIndex].explanationImages) {
                quiz.questions[qIndex].explanationImages.splice(imgIdx, 1);
                kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                renderEditQuestions();
            }
        }

        function closeEditScreen() {
            endImportSession();
            editRenderToken++;
            isEditingFromQuiz = false;
            document.getElementById('edit-screen').classList.add('hidden');
            document.getElementById('home-screen').classList.remove('hidden');
            renderSavedQuizzes();
            if (editingIsExam) {
                editingIsExam = false;
                openExamModal();
            }
        }

        const DIFF_LEVELS = ['easy', 'medium', 'hard'];
        const DIFF_LABEL = { easy: 'Dễ', medium: 'Vừa', hard: 'Khó' };
        const DIFF_STYLE = {
            easy:   { off: 'bg-green-50 text-green-700 border-green-300 hover:bg-green-100',  on: 'bg-green-500 text-white border-green-500' },
            medium: { off: 'bg-amber-50 text-amber-700 border-amber-300 hover:bg-amber-100',  on: 'bg-amber-400 text-white border-amber-400' },
            hard:   { off: 'bg-red-50 text-red-700 border-red-300 hover:bg-red-100',          on: 'bg-red-500 text-white border-red-500' }
        };

        function getDifficultyMap() {
            try { return JSON.parse(kv.getItem('quizAppQuestionDifficulty') || '{}') || {}; } catch (e) { return {}; }
        }
        function getQuestionDifficulty(q, map) {
            map = map || getDifficultyMap();
            const d = map[getCleanQuestionText(q.question)] || q.difficulty;
            return DIFF_LEVELS.includes(d) ? d : '';
        }

        function setCurrentDifficulty(level) {
            const q = questions[currentIndex];
            if (!q) return;
            const key = getCleanQuestionText(q.question);
            const newLevel = getQuestionDifficulty(q) === level ? '' : level;

            const map = getDifficultyMap();
            if (newLevel) map[key] = newLevel; else delete map[key];
            kv.setItem('quizAppQuestionDifficulty', JSON.stringify(map));

            const quizzes = getSavedQuizzes();
            let changed = false;
            quizzes.forEach(qz => (qz.questions || []).forEach(x => {
                if (getCleanQuestionText(x.question) !== key) return;
                if (newLevel) { if (x.difficulty !== newLevel) { x.difficulty = newLevel; changed = true; } }
                else if (x.difficulty) { delete x.difficulty; changed = true; }
            }));
            if (changed) kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));

            if (newLevel) q.difficulty = newLevel; else delete q.difficulty;
            updateDifficultyButtonState();
            showToast(newLevel ? `Đã gắn thẻ: ${DIFF_LABEL[newLevel]}` : 'Đã bỏ thẻ độ khó');
        }

        function updateDifficultyButtonState() {
            const q = questions[currentIndex];
            const cur = q ? getQuestionDifficulty(q) : '';
            document.querySelectorAll('#difficulty-group button').forEach(btn => {
                const lv = btn.dataset.level;
                btn.className = 'eq-btn flex-1 rounded-xl border font-bold text-xs sm:text-sm transition-colors flex items-center justify-center ' +
                    (cur === lv ? DIFF_STYLE[lv].on : DIFF_STYLE[lv].off);
            });
        }

        function openDeepModal() {
            const quizzes = getRegularQuizzes();
            if (quizzes.length === 0) {
                showToast("Chưa có bộ đề nào được lưu để ôn tập!");
                return;
            }

            const banner = document.getElementById('deep-resume-banner');
            const session = getActiveSession(DEEP_SESSION_ID);
            if (banner) {
                if (session && session.questions && session.questions.length > 0 && session.currentIndex < session.questions.length) {
                    banner.className = 'bg-teal-50 border border-teal-300 rounded-2xl p-3.5 flex items-center justify-between gap-3 shadow-sm mb-3';
                    banner.innerHTML = `
                        <div class="min-w-0">
                            <p class="font-bold text-teal-900 text-xs sm:text-sm flex items-center"><span class="mr-1.5">⏳</span> Bạn có bài ôn tập chuyên sâu làm dở</p>
                            <p class="text-xs text-teal-800 mt-0.5 truncate">Câu ${session.currentIndex + 1}/${session.questions.length} • Đã làm: ${formatTime(session.timeElapsed)}</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button" onclick="resumeSpecialQuiz('${DEEP_SESSION_ID}')" class="bg-teal-600 hover:bg-teal-700 text-white font-bold py-1.5 px-3 rounded-xl text-xs shadow-sm transition-colors">▶️ Tiếp tục</button>
                            <button type="button" onclick="clearSpecialSession('${DEEP_SESSION_ID}'); openDeepModal();" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold py-1.5 px-2.5 rounded-xl text-xs transition-colors">Bỏ qua</button>
                        </div>
                    `;
                    banner.classList.remove('hidden');
                } else {
                    banner.classList.add('hidden');
                    banner.innerHTML = '';
                }
            }

            const groups = {};
            quizzes.forEach(q => { 
                const t = getQuizTopic(q); 
                if (t > 0) {
                    (groups[t] = groups[t] || []).push(q);
                }
            });
            const order = Object.keys(groups).map(Number).sort((a, b) => a - b);

            const tree = document.getElementById('deep-tree');
            tree.innerHTML = '';
            order.forEach(t => {
                const list = groups[t];
                const wrap = document.createElement('div');
                wrap.className = 'bg-white border rounded-xl p-2';
                wrap.innerHTML = `
                    <label class="flex items-center gap-2 font-bold text-gray-800 cursor-pointer">
                        <input type="checkbox" class="deep-topic-cb w-4 h-4 accent-teal-600" data-topic="${t}" checked onchange="toggleDeepTopic(${t}, this.checked)">
                        ${topicFullName(t)} <span class="text-xs font-normal text-gray-500">(${list.length} bộ đề)</span>
                    </label>
                    <div class="mt-1.5 ml-6 space-y-1">
                        ${list.map(q => `
                        <label class="flex items-center gap-2 cursor-pointer hover:bg-teal-50 rounded px-1 py-0.5">
                            <input type="checkbox" class="deep-quiz-cb w-3.5 h-3.5 accent-teal-600" value="${q.id}" data-topic="${t}" checked onchange="syncDeepTopics()">
                            <span class="text-gray-700">${escTopic(q.name)}</span>
                            <span class="text-xs text-gray-400">(${q.questions.length} câu)</span>
                        </label>`).join('')}
                    </div>`;
                tree.appendChild(wrap);
            });
            document.getElementById('deep-modal').classList.remove('hidden');
            updateDeepSummary();
        }

        function closeDeepModal() {
            document.getElementById('deep-modal').classList.add('hidden');
        }

        function toggleDeepTopic(t, checked) {
            document.querySelectorAll(`.deep-quiz-cb[data-topic="${t}"]`).forEach(cb => cb.checked = checked);
            syncDeepTopics();
        }

        function syncDeepTopics() {
            document.querySelectorAll('.deep-topic-cb').forEach(tcb => {
                const kids = Array.from(document.querySelectorAll(`.deep-quiz-cb[data-topic="${tcb.dataset.topic}"]`));
                const n = kids.filter(k => k.checked).length;
                tcb.checked = n === kids.length && n > 0;
                tcb.indeterminate = n > 0 && n < kids.length;
            });
            updateDeepSummary();
        }

        function deepSelectAll(select) {
            document.querySelectorAll('.deep-quiz-cb').forEach(cb => cb.checked = select);
            syncDeepTopics();
        }

        function deepSelectRandom() {
            const cbs = Array.from(document.querySelectorAll('.deep-quiz-cb'));
            if (cbs.length === 0) return;
            const k = 1 + Math.floor(Math.random() * cbs.length);
            const pick = new Set(shuffleArray(cbs.map(c => c.value)).slice(0, k));
            cbs.forEach(cb => cb.checked = pick.has(cb.value));
            syncDeepTopics();
            showToast(`Đã chọn ngẫu nhiên ${k} bộ đề`);
        }

        function getDeepPool() {
            const ids = new Set(Array.from(document.querySelectorAll('.deep-quiz-cb:checked')).map(c => c.value));
            const map = getDifficultyMap();
            const seen = new Set();
            const pool = { easy: [], medium: [], hard: [], none: [] };
            getSavedQuizzes().filter(qz => ids.has(String(qz.id))).forEach(qz => {
                const topicLabel = topicFullName(getQuizTopic(qz));
                filterBlockedQuestions(qz.questions).forEach(q => {
                    const key = getCleanQuestionText(q.question);
                    if (seen.has(key)) return;
                    seen.add(key);
                    q.__srcQuizName = qz.name;
                    q.__srcTopicLabel = topicLabel;
                    pool[getQuestionDifficulty(q, map) || 'none'].push(q);
                });
            });
            return pool;
        }

        function getDeepPercents() {
            return DIFF_LEVELS.map(l => {
                const v = parseFloat(document.getElementById('deep-pct-' + l).value);
                return isNaN(v) || v < 0 ? 0 : v;
            });
        }

        function computeDeepPlan(pool, numQ, pct) {
            const sum = pct.reduce((a, b) => a + b, 0);
            const raw = pct.map(p => numQ * p / sum);
            const target = raw.map(Math.floor);
            let rem = numQ - target.reduce((a, b) => a + b, 0);
            raw.map((r, i) => [r - Math.floor(r), i]).sort((a, b) => b[0] - a[0]).slice(0, rem).forEach(x => target[x[1]]++);

            const take = { easy: 0, medium: 0, hard: 0, none: 0 };
            DIFF_LEVELS.forEach((l, i) => { take[l] = Math.min(target[i], pool[l].length); });
            let short = numQ - DIFF_LEVELS.reduce((a, l) => a + take[l], 0);
            const shortBase = short;
            [...DIFF_LEVELS, 'none'].forEach(l => {
                if (short <= 0) return;
                const add = Math.min(pool[l].length - take[l], short);
                take[l] += add;
                short -= add;
            });
            return { take, filled: shortBase, unfilled: short };
        }

        function updateDeepSummary() {
            const pool = getDeepPool();
            const total = DIFF_LEVELS.reduce((a, l) => a + pool[l].length, 0) + pool.none.length;
            document.getElementById('deep-avail').innerHTML =
                `Câu khả dụng: 🟢 Dễ <b>${pool.easy.length}</b> • 🟡 Vừa <b>${pool.medium.length}</b> • 🔴 Khó <b>${pool.hard.length}</b> • ⚪ Chưa gắn thẻ <b>${pool.none.length}</b>`;

            const pct = getDeepPercents();
            const sum = pct.reduce((a, b) => a + b, 0);
            const sumEl = document.getElementById('deep-pct-sum');
            sumEl.textContent = `Tổng: ${sum}%` + (sum === 100 ? ' ✓' : ' (phải bằng 100%)');
            sumEl.className = 'text-xs mt-1.5 font-semibold ' + (sum === 100 ? 'text-green-700' : 'text-red-600');

            const planEl = document.getElementById('deep-plan');
            const numQ = parseInt(document.getElementById('deep-num-questions').value);
            if (sum !== 100 || isNaN(numQ) || numQ <= 0) { planEl.textContent = ''; return; }
            if (numQ > total) { planEl.textContent = `Vượt quá số câu khả dụng (${total})`; return; }
            const plan = computeDeepPlan(pool, numQ, pct);
            const t = plan.take;
            planEl.textContent = `Dự kiến: Dễ ${t.easy} • Vừa ${t.medium} • Khó ${t.hard}` + (t.none ? ` • Chưa gắn thẻ ${t.none}` : '') +
                (plan.filled > 0 ? ` (đã bù ${plan.filled} câu do thiếu ở mức đã chọn)` : '');
        }

        function startDeepReview() {
            const ids = Array.from(document.querySelectorAll('.deep-quiz-cb:checked'));
            if (ids.length === 0) { showToast("Vui lòng chọn ít nhất một bộ đề!"); return; }
            const pct = getDeepPercents();
            const sum = pct.reduce((a, b) => a + b, 0);
            if (sum !== 100) { showToast(`Tổng tỉ lệ phải bằng 100% (hiện tại ${sum}%)`); return; }
            const numQ = parseInt(document.getElementById('deep-num-questions').value);
            if (isNaN(numQ) || numQ <= 0) { showToast("Số lượng câu hỏi không hợp lệ!"); return; }

            const pool = getDeepPool();
            const total = DIFF_LEVELS.reduce((a, l) => a + pool[l].length, 0) + pool.none.length;
            if (total === 0) { showToast("Các bộ đề đã chọn không có câu hỏi khả dụng!"); return; }
            if (numQ > total) { showToast(`Số câu yêu cầu (${numQ}) vượt quá số câu khả dụng (${total})!`); return; }

            const plan = computeDeepPlan(pool, numQ, pct);
            let picked = [];
            [...DIFF_LEVELS, 'none'].forEach(l => { picked = picked.concat(shuffleArray(pool[l]).slice(0, plan.take[l])); });

            const t = plan.take;
            clearActiveSession(DEEP_SESSION_ID);
            questions = shuffleArray(picked);
            currentQuizName = `Ôn tập chuyên sâu (${numQ} câu: Dễ ${t.easy} • Vừa ${t.medium} • Khó ${t.hard}${t.none ? ' • Khác ' + t.none : ''})`;
            currentQuizId = DEEP_SESSION_ID;
            closeDeepModal();
            initQuiz();
            if (plan.filled > 0) showToast(`Thiếu câu ở mức đã chọn nên đã bù ${plan.filled} câu từ mức khác/chưa gắn thẻ.`);
        }

        const TOPIC_COUNT = 37;
        const TOPIC_ICONS = [
            "images/img_002.webp", "images/img_003.webp", "images/img_004.webp", "images/img_005.webp",
            "images/img_006.webp", "images/img_007.webp", "images/img_008.webp", "images/img_009.webp",
            "images/img_010.webp", "images/img_011.webp", "images/img_012.webp", "images/img_013.webp",
            "images/img_014.webp", "images/img_015.webp", "images/img_016.webp", "images/img_017.webp",
            "images/img_018.webp", "images/img_019.webp", "images/img_020.webp", "images/img_021.webp",
            "images/img_022.webp", "images/img_023.webp", "images/img_024.webp", "images/img_025.webp",
            "images/img_026.webp", "images/img_027.webp", "images/img_028.webp", "images/img_029.webp",
            "images/img_030.webp", "images/img_031.webp", "images/img_032.webp", "images/img_033.webp",
            "images/img_034.webp", "images/img_035.webp", "images/img_036.webp", "images/img_037.webp",
            "images/img_038.webp"
        ];

        let currentTopic = null;
        let topicNumTouched = false;

        function topicName(n) { 
            if (n === 37) return "Thi Thử";
            return `Chủ đề ${n}`; 
        }

        const TOPIC_FULL_NAMES = [
            "Đau do răng và mô nâng đỡ răng",
            "Đau do các cấu trúc lân cận (xoang hàm, tuyến nước bọt, bao gồm đau sau thủ thuật/phẫu thuật)",
            "Đau mạn tính do cơ/thần kinh/mạch máu/tâm thể",
            "Đau khớp thái dương hàm",
            "Nhiễm trùng trong miệng (răng, nha chu, niêm mạc miệng, xương hàm)",
            "Nhiễm trùng ngoài mặt (xương hàm, phần mềm vùng mặt, tuyến nước bọt)",
            "Sâu răng và biến chứng (bệnh lý tuỷ, bệnh lý quanh chóp)",
            "Tổn thương của răng không do sâu răng (nứt, mẻ, mòn răng, đổi màu; thiểu sản men ngà)",
            "Bệnh nha chu (viêm lợi/nướu, viêm nha chu, và các biểu hiện bệnh lý khác của mô nha chu)",
            "Tình trạng bất thường mô nha chu",
            "Tổn thương niêm mạc miệng (lành tính, có tiềm năng ác tính và ác tính)",
            "Bất thường niêm mạc miệng do di truyền, bẩm sinh và tăng trưởng (bất thường phanh/thắng và các bất thường niêm mạc miệng khác)",
            "Chấn thương răng",
            "Chấn thương hàm mặt",
            "Nang vùng miệng và hàm mặt (nang do răng và không do răng)",
            "U vùng miệng và hàm mặt (u do răng, u xương, u phần mềm lành tính hoặc ác tính)",
            "Bất thường mọc răng (răng ngầm, răng mọc kẹt và biến chứng, răng mọc chậm, răng mọc sai vị trí)",
            "Bất thường phát triển răng (số lượng, hình thái, cấu trúc)",
            "Bất thường phát triển hàm mặt và khe hở môi vòm miệng",
            "Lệch lạc khớp cắn",
            "Mất răng (kèm bảo tồn xương ổ, giữ khoảng mất răng)",
            "Phục hồi răng mất (cố định, tháo lắp)",
            "Nhổ răng (răng sữa, răng vĩnh viễn)",
            "Hôi miệng, khô miệng và giới hạn vận động hàm (khít hàm)",
            "Hành vi ảnh hưởng đến chăm sóc răng miệng",
            "Vệ sinh răng miệng",
            "Thói quen xấu (mút tay, đẩy lưỡi, thở miệng, cắn môi) ảnh hưởng răng miệng",
            "Dự phòng bệnh răng miệng (giáo dục sức khoẻ răng miệng; dự phòng bệnh lý răng miệng cho cá nhân và cộng đồng)",
            "Chăm sóc răng miệng cho nhóm có tình trạng đặc biệt (người có bệnh nền, người cao tuổi, người khuyết tật)",
            "Điều trị răng hàm mặt toàn diện",
            "Cấp cứu Răng Hàm Mặt (cấp cứu nha khoa và y khoa trong thực hành Răng Hàm Mặt)",
            "Tổ chức hành nghề (quản lý phòng khám; kiểm soát nhiễm khuẩn; quản lý rủi ro và an toàn người bệnh)",
            "Giao tiếp (với người bệnh, người nhà người bệnh và đồng nghiệp) trong hành nghề Răng Hàm Mặt",
            "Tính chuyên nghiệp và các giá trị cốt lõi (đạo đức hành nghề Răng Hàm Mặt; văn bản pháp luật; bảo mật y khoa)",
            "Tư duy phản biện",
            "Thực hành nha khoa thực chứng",
            "Thi Thử"
        ];

        function topicFullName(n) {
            if (n === 37) return "Thi Thử";
            const extra = TOPIC_FULL_NAMES[n - 1];
            return extra ? `${topicName(n)}: ${extra}` : topicName(n);
        }

        function escTopic(s) {
            return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }

        function getQuizTopic(q) {
            if (!q) return 0;
            if (q.isExam || (q.folder && q.folder.trim().toLowerCase() === 'thi thử')) return 37;
            const m = String(q.folder || '').normalize('NFC').trim().match(/^chủ\s*đề\s*(\d+)\s*(?:\/|$)/i);
            const n = m ? parseInt(m[1], 10) : 0;
            return (n >= 1 && n <= TOPIC_COUNT) ? n : 0;
        }

        function renderTopicGrid() {
            const quizzes = getRegularQuizzes();
            const counts = new Array(TOPIC_COUNT + 1).fill(0);
            let other = 0;
            quizzes.forEach(q => { const t = getQuizTopic(q); if (t) counts[t]++; else other++; });

            const grid = document.getElementById('topic-grid');
            grid.innerHTML = '';
            for (let n = 1; n <= TOPIC_COUNT; n++) {
                const c = counts[n];
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.title = topicFullName(n);
                btn.onclick = () => openTopicModal(n);
                let btnClass = 'flex flex-col items-center justify-center gap-1 sm:gap-2 rounded-xl border p-1.5 sm:p-3 transition-all hover:-translate-y-0.5 hover:shadow-md ' +
                    (c > 0 ? 'bg-blue-50 border-blue-300 hover:bg-blue-100' : 'bg-gray-50 border-gray-200 hover:bg-gray-100');
                if (n === 37) btnClass += ' dev-only';
                btn.className = btnClass;
                btn.innerHTML = `
                    <img src="${TOPIC_ICONS[n - 1] || 'images/img_037.webp'}" alt="${topicFullName(n)}" draggable="false" onerror="this.style.opacity=0.15" class="w-9 h-9 sm:w-20 sm:h-20 object-contain shrink-0 ${c > 0 ? '' : 'opacity-60'}">
                    <span class="flex flex-col items-center text-center min-w-0">
                        <span class="font-bold text-[11px] sm:text-lg leading-tight ${c > 0 ? 'text-blue-800' : 'text-gray-500'}">${n === 37 ? 'Thi Thử' : 'Chủ đề ' + n}</span>
                        <span class="text-[9px] sm:text-sm mt-0.5 ${c > 0 ? 'text-blue-600' : 'text-gray-400'}">(${c} bộ đề)</span>
                    </span>`;
                grid.appendChild(btn);
            }

            const unc = document.getElementById('topic-uncat');
            if (other > 0) {
                unc.classList.remove('hidden');
                unc.innerHTML = `<button type="button" onclick="openTopicModal(0)" class="text-sm bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold py-2 px-4 rounded-xl border border-gray-300">📦 Bộ đề chưa phân chủ đề (${other})</button>`;
            } else {
                unc.classList.add('hidden');
                unc.innerHTML = '';
            }

            const dataList = document.getElementById('folder-suggestions');
            if (dataList) {
                dataList.innerHTML = '';
                for (let n = 1; n <= TOPIC_COUNT; n++) {
                    const opt = document.createElement('option');
                    opt.value = (n === 37) ? "Thi Thử" : topicName(n);
                    dataList.appendChild(opt);
                }
            }
        }

        function openTopicModal(n) {
            currentTopic = n;
            topicNumTouched = false;
            document.getElementById('topic-num-questions').value = '';
            document.getElementById('topic-modal').classList.remove('hidden');
            renderTopicModal(true);
        }

        function closeTopicModal() {
            currentTopic = null;
            document.getElementById('topic-modal').classList.add('hidden');
        }

        function renderTopicModal(fresh = false) {
            if (currentTopic === null) return;
            const keep = new Set(Array.from(document.querySelectorAll('.topic-cb:checked')).map(c => c.value));
            const quizzes = getRegularQuizzes();
            const list = quizzes.filter(q => getQuizTopic(q) === currentTopic);

            document.getElementById('topic-modal-title').textContent = currentTopic ? `📂 ${topicFullName(currentTopic)}` : '📦 Bộ đề chưa phân chủ đề';
            document.getElementById('topic-modal-sub').textContent = `${list.length} bộ đề`;
            document.getElementById('topic-add-json-btn').classList.toggle('hidden', !currentTopic);
            document.getElementById('topic-review-panel').classList.toggle('hidden', list.length === 0);

            const sortBy = document.getElementById('topic-sort-select').value;
            list.sort((a, b) => {
                if (sortBy === 'newest') return b.id - a.id;
                if (sortBy === 'oldest') return a.id - b.id;
                if (sortBy === 'name_az') return a.name.localeCompare(b.name);
                if (sortBy === 'name_za') return b.name.localeCompare(a.name);
                if (sortBy === 'questions_desc') return b.questions.length - a.questions.length;
                return 0;
            });

            const container = document.getElementById('topic-quiz-list');
            if (list.length === 0) {
                container.innerHTML = `<p class="text-gray-500 italic bg-gray-50 p-4 rounded-xl border border-gray-200 text-sm">Chưa có bộ đề nào trong ${currentTopic ? topicName(currentTopic) : 'mục này'}.<span class="dev-only"> Bấm "➕ Thêm đề JSON" để thêm.</span></p>`;
                return;
            }

            const moveOptions = Array.from({ length: TOPIC_COUNT }, (_, i) => {
                const num = i + 1;
                return `<option value="${num}">${num === 37 ? 'Thi Thử' : topicName(num)}</option>`;
            }).join('');

            container.innerHTML = '';
            list.forEach(quiz => {
                const validCount = filterBlockedQuestions(quiz.questions).length;
                const activeSession = getActiveSession(quiz.id);
                const hasSession = activeSession && activeSession.currentIndex > 0;
                const checked = fresh ? false : keep.has(String(quiz.id));
                const pct = quiz.bestResult && quiz.bestResult.total > 0 ? (quiz.bestResult.score / quiz.bestResult.total) * 100 : 0;
                const colorClass = pct > 80 ? 'text-green-800 bg-green-100' : (pct >= 50 ? 'text-yellow-800 bg-yellow-100' : 'text-red-800 bg-red-100');

                const item = document.createElement('div');
                item.className = 'flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-gray-50 border border-gray-200 p-3 sm:p-4 rounded-2xl hover:bg-blue-50 transition-colors';
                item.innerHTML = `
                    <label class="flex items-start gap-3 flex-1 min-w-0 cursor-pointer">
                        <input type="checkbox" class="topic-cb mt-1.5 w-4 h-4 accent-amber-500 shrink-0" value="${quiz.id}" ${checked ? 'checked' : ''} onchange="updateTopicReviewSummary()">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2 flex-wrap mb-1">
                                <span class="text-xs text-gray-500">Thêm vào: ${escTopic(quiz.date)}</span>
                                ${hasSession ? '<span class="text-xs font-bold text-amber-800 bg-amber-100 px-2.5 py-0.5 rounded-full">⏳ Đang làm dở</span>' : ''}
                                ${quiz.bestResult ? `<span class="text-xs font-bold ${colorClass} px-2.5 py-0.5 rounded-full">Hoàn thành ${quiz.bestResult.score}/${quiz.bestResult.total}</span>` : ''}
                            </div>
                            <h4 class="font-bold text-gray-900 text-base leading-snug">${escTopic(quiz.name)}</h4>
                            <p class="text-sm text-gray-600">${validCount}/${quiz.questions.length} câu hỏi khả dụng</p>
                        </div>
                    </label>
                    <div class="flex items-center gap-2 flex-wrap justify-end">
                        <button onclick="openViewQuizModal(${quiz.id})" class="text-teal-600 hover:text-teal-800 bg-teal-50 hover:bg-teal-100 px-3 py-1.5 rounded-xl font-bold text-sm shadow-sm">👁️ Xem trước</button>
                        <select onchange="moveQuizToTopic(${quiz.id}, this.value)" class="dev-only text-sm bg-white border border-gray-300 rounded-xl py-1.5 px-2 outline-none cursor-pointer" title="Chuyển sang chủ đề khác">
                            <option value="">↪ Chuyển…</option>${moveOptions}
                        </select>
                        <button onclick="exportQuizToJson(${quiz.id})" class="dev-only text-amber-600 hover:text-amber-800 bg-amber-50 hover:bg-amber-100 px-3 py-1.5 rounded-xl font-bold text-sm shadow-sm">📤 JSON</button>
                        <button onclick="closeTopicModal(); openEditScreen(${quiz.id})" class="dev-only text-purple-600 hover:text-purple-800 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-xl font-bold text-sm shadow-sm">✏️ Edit</button>
                        <button onclick="deleteQuiz(${quiz.id})" class="dev-only text-red-500 hover:text-red-700 bg-red-50 hover:bg-red-100 px-3 py-1.5 rounded-xl font-bold text-sm shadow-sm">🗑️ Xóa</button>
                        <button onclick="closeTopicModal(); startSavedQuiz(${quiz.id}, true, ${hasSession})" class="text-blue-600 hover:text-blue-800 bg-blue-100 hover:bg-blue-200 px-4 py-1.5 rounded-xl font-bold text-sm shadow-sm">${hasSession ? `▶️ Tiếp tục (Câu ${activeSession.currentIndex + 1})` : '▶️ Làm bài'}</button>
                    </div>`;
                container.appendChild(item);
            });
            updateTopicReviewSummary();
        }

        function updateTopicReviewSummary() {
            const quizzes = getSavedQuizzes();
            const cbs = Array.from(document.querySelectorAll('.topic-cb:checked'));
            let total = 0;
            cbs.forEach(cb => {
                const q = quizzes.find(x => String(x.id) === cb.value);
                if (q) total += filterBlockedQuestions(q.questions).length;
            });
            document.getElementById('topic-review-summary').innerHTML = `Đã chọn <b>${cbs.length}</b> bộ đề • <b>${total}</b> câu khả dụng`;
            const num = document.getElementById('topic-num-questions');
            num.max = total || '';
            const v = parseInt(num.value);
            if (total > 0 && (!topicNumTouched || isNaN(v) || v > total)) {
                num.value = total;
            } else if (total === 0) {
                num.value = '';
            }
        }

        function topicSelectAll(select) {
            document.querySelectorAll('.topic-cb').forEach(cb => cb.checked = select);
            topicNumTouched = false;
            updateTopicReviewSummary();
        }

        function topicSelectRandom() {
            const cbs = Array.from(document.querySelectorAll('.topic-cb'));
            if (cbs.length === 0) return;
            const k = 1 + Math.floor(Math.random() * cbs.length);
            const pick = new Set(shuffleArray(cbs.map(c => c.value)).slice(0, k));
            cbs.forEach(cb => cb.checked = pick.has(cb.value));
            topicNumTouched = false;
            updateTopicReviewSummary();
            showToast(`Đã chọn ngẫu nhiên ${k} bộ đề`);
        }

        function startTopicReview() {
            const ids = Array.from(document.querySelectorAll('.topic-cb:checked')).map(c => c.value);
            if (ids.length === 0) {
                showToast("Vui lòng chọn ít nhất một bộ đề để ôn tập!");
                return;
            }
            const quizzes = getSavedQuizzes();
            let pool = [];
            const topicLabelForTag = currentTopic ? topicFullName(currentTopic) : 'Chưa phân chủ đề';
            ids.forEach(id => {
                const quizObj = quizzes.find(x => String(x.id) === id);
                if (quizObj) {
                    quizObj.questions.forEach(q => { q.__srcQuizName = quizObj.name; q.__srcTopicLabel = topicLabelForTag; });
                    pool = pool.concat(quizObj.questions);
                }
            });
            pool = filterBlockedQuestions(pool);
            if (pool.length === 0) {
                showToast("Tất cả câu hỏi từ các đề đã chọn đều đã bị chặn hoặc bị ẩn!");
                return;
            }
            const numQ = parseInt(document.getElementById('topic-num-questions').value);
            if (isNaN(numQ) || numQ <= 0) {
                showToast("Số lượng câu hỏi không hợp lệ!");
                return;
            }
            if (numQ > pool.length) {
                showToast(`Số câu yêu cầu (${numQ}) vượt quá số câu khả dụng (${pool.length})!`);
                return;
            }
            const label = currentTopic ? topicName(currentTopic) : 'Chưa phân chủ đề';
            questions = shuffleArray(pool).slice(0, numQ);
            currentQuizName = `Ôn tập ${label} (${numQ} câu từ ${ids.length} bộ đề)`;
            currentQuizId = null;
            closeTopicModal();
            initQuiz();
        }

        function moveQuizToTopic(id, n) {
            n = parseInt(n);
            if (!n) return;
            const quizzes = getSavedQuizzes();
            const quiz = quizzes.find(q => q.id === id);
            if (!quiz) return;
            quiz.folder = (n === 37) ? "Thi Thử" : topicName(n);
            quiz.isExam = (n === 37);
            kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
            renderSavedQuizzes();
            showToast(`Đã chuyển vào ${quiz.folder}!`);
        }

        function triggerTopicJsonImport() {
            document.getElementById('import-topic-json-input').click();
        }

        function importTopicJsonFiles(e) {
            const topic = currentTopic;
            const files = Array.from(e.target.files || []);
            e.target.value = '';
            if (files.length === 0 || !topic) return;

            const quizzes = getSavedQuizzes();
            let ok = 0, done = 0, seq = 0;
            const finish = () => {
                if (++done < files.length) return;
                if (ok > 0) {
                    kv.setItem('quizAppSavedQuizzes', JSON.stringify(quizzes));
                    renderSavedQuizzes();
                    showToast(`Đã thêm ${ok} bộ đề vào ${topicName(topic)}!`);
                } else {
                    showToast("Không thêm được bộ đề nào. Kiểm tra lại định dạng JSON!");
                }
            };
            files.forEach(file => {
                const reader = new FileReader();
                reader.onload = ev => {
                    try {
                        const parsed = JSON.parse(ev.target.result);
                        const arr = parsed && parsed.quizzes ? parsed.quizzes
                            : (Array.isArray(parsed) ? parsed
                            : (parsed && parsed.name && parsed.questions ? [parsed] : null));
                        if (Array.isArray(arr)) {
                            arr.forEach(item => {
                                if (item && item.name && Array.isArray(item.questions)) {
                                    item.id = Date.now() + (seq++);
                                    item.folder = (topic === 37) ? "Thi Thử" : topicName(topic);
                                    if (topic === 37) item.isExam = true;
                                    if (!item.date) item.date = new Date().toLocaleDateString('vi-VN');
                                    quizzes.unshift(item);
                                    ok++;
                                }
                            });
                        }
                    } catch (err) {
                        console.error("Lỗi đọc file JSON:", file.name, err);
                    }
                    finish();
                };
                reader.onerror = finish;
                reader.readAsText(file);
            });
        }

        function renderSavedQuizzes() {
            updateBookmarkBadgeCount();
            updateBlockedBadgeCount();
            renderTopicGrid();
            if (currentTopic !== null) renderTopicModal();
        }

        function openStorageModal() {
            const allQuizzes = getSavedQuizzes();
            const quizzes = getRegularQuizzes();
            const examSets = getSavedExamSets();
            const coverImage = kv.getItem('quizAppCoverImage') || '';
            const rawData = JSON.stringify({ quizzes: allQuizzes, coverImage }, null, 2);
            document.getElementById('storage-textarea').value = rawData;

            const exportListContainer = document.getElementById('storage-quiz-export-list');
            if (quizzes.length === 0) {
                exportListContainer.innerHTML = '<p class="text-xs text-gray-500 italic">Chưa có bộ đề nào.</p>';
            } else {
                exportListContainer.innerHTML = '';
                quizzes.forEach(quiz => {
                    const div = document.createElement('div');
                    div.className = 'flex justify-between items-center bg-white p-2.5 rounded-xl border text-sm shadow-sm';
                    div.innerHTML = `
                        <div class="truncate flex-1 pr-2">
                            <span class="font-bold text-gray-800">${quiz.name}</span>
                            <span class="text-xs text-gray-500 ml-1.5">(${quiz.questions.length} câu - [${quiz.folder || 'Chung'}])</span>
                        </div>
                        <div class="flex items-center gap-1.5 shrink-0">
                            <button onclick="exportQuizToJson(${quiz.id})" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-3 py-1.5 rounded-xl text-xs transition-colors shadow-sm whitespace-nowrap">
                                📤 Xuất JSON
                            </button>
                            <button onclick="deleteQuiz(${quiz.id}); openStorageModal()" class="bg-red-100 hover:bg-red-200 text-red-700 font-semibold px-3 py-1.5 rounded-xl text-xs transition-colors shadow-sm whitespace-nowrap" title="Xóa bộ đề này">
                                🗑️ Xóa
                            </button>
                        </div>
                    `;
                    exportListContainer.appendChild(div);
                });
            }

            const examExportContainer = document.getElementById('storage-exam-export-list');
            if (examExportContainer) {
                if (examSets.length === 0) {
                    examExportContainer.innerHTML = '<p class="text-xs text-gray-500 italic">Chưa có đề thi nào.</p>';
                } else {
                    examExportContainer.innerHTML = '';
                    examSets.forEach(exam => {
                        const div = document.createElement('div');
                        div.className = 'flex justify-between items-center bg-white p-2.5 rounded-xl border text-sm shadow-sm';
                        div.innerHTML = `
                            <div class="truncate flex-1 pr-2">
                                <span class="font-bold text-gray-800">${exam.name}</span>
                                <span class="text-xs text-gray-500 ml-1.5">(${exam.questions.length} câu)</span>
                            </div>
                            <div class="flex items-center gap-1.5 shrink-0">
                                <button onclick="exportQuizToJson(${exam.id})" class="bg-amber-600 hover:bg-amber-700 text-white font-semibold px-3 py-1.5 rounded-xl text-xs transition-colors shadow-sm whitespace-nowrap">
                                    📤 Xuất JSON
                                </button>
                                <button onclick="deleteExamSet(${exam.id}); openStorageModal()" class="bg-red-100 hover:bg-red-200 text-red-700 font-semibold px-3 py-1.5 rounded-xl text-xs transition-colors shadow-sm whitespace-nowrap">
                                    🗑️ Xóa
                                </button>
                            </div>
                        `;
                        examExportContainer.appendChild(div);
                    });
                }
            }

            document.getElementById('storage-modal').classList.remove('hidden');
        }

        function closeStorageModal() {
            document.getElementById('storage-modal').classList.add('hidden');
        }

        function copyStorageData() {
            const textarea = document.getElementById('storage-textarea');
            textarea.select();
            navigator.clipboard.writeText(textarea.value);
            showToast("Đã sao chép dữ liệu JSON lưu trữ vào bộ nhớ tạm!");
        }

        function shuffleArray(array) {
            let arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        function shuffleQuestionOptions(q) {
            if (!q.options || q.options.length === 0) return q;
            const parsedOptions = q.options.map(opt => {
                const match = opt.match(/^[A-D][\.\)]\s*(.*)$/);
                const content = match ? match[1] : opt.replace(/^[A-D][\.\)]\s*/, '');
                const optLetter = opt.charAt(0).toUpperCase();
                const isCorrect = (optLetter === q.answerStr);
                return { content, isCorrect };
            });
            const shuffled = shuffleArray(parsedOptions);
            const letters = ['A', 'B', 'C', 'D'];
            let newAnswerStr = 'A';
            const newOptions = shuffled.map((item, idx) => {
                const letter = letters[idx] || String.fromCharCode(65 + idx);
                if (item.isCorrect) {
                    newAnswerStr = letter;
                }
                return `${letter}. ${item.content}`;
            });
            return {
                ...q,
                options: newOptions,
                answerStr: newAnswerStr
            };
        }

        function applyOptionOrder(fresh, old) {
            if (!fresh.options || !old.options) return fresh;
            const strip = o => o.replace(/^[A-D][\.\)]\s*/, '').trim();
            const fc = fresh.options.map(strip);
            const oc = old.options.map(strip);
            const sameSet = fc.length === oc.length && [...fc].sort().join('\u0001') === [...oc].sort().join('\u0001');
            if (!sameSet) return shuffleQuestionOptions(fresh);
            const correctOpt = fresh.options.find(o => o.charAt(0).toUpperCase() === fresh.answerStr);
            const correctIdx = correctOpt ? oc.indexOf(strip(correctOpt)) : -1;
            return {
                ...fresh,
                options: oc.map((c, i) => `${String.fromCharCode(65 + i)}. ${c}`),
                answerStr: correctIdx > -1 ? String.fromCharCode(65 + correctIdx) : old.answerStr
            };
        }

        function getActiveSession(quizId) {
            const saved = kv.getItem(`quizAppActiveSession_${quizId}`);
            return saved ? JSON.parse(saved) : null;
        }

        function saveActiveSession() {
            if (!currentQuizId) return;
            const sessionData = {
                questions,
                questionStates,
                currentIndex,
                timeElapsed,
                currentQuizName
            };
            kv.setItem(`quizAppActiveSession_${currentQuizId}`, JSON.stringify(sessionData));
        }

        function clearActiveSession(id) {
            const targetId = id || currentQuizId;
            if (targetId) {
                kv.removeItem(`quizAppActiveSession_${targetId}`);
            }
        }

        function startSavedQuiz(id, shuffle = true, resume = false) {
            const quizzes = getSavedQuizzes();
            const selectedQuiz = quizzes.find(q => q.id === id);
            if (!selectedQuiz) return;

            currentQuizId = selectedQuiz.id;

            if (resume) {
                const session = getActiveSession(id);
                if (session) {
                    questions = session.questions;
                    questionStates = session.questionStates;
                    currentIndex = session.currentIndex;
                    timeElapsed = session.timeElapsed;
                    currentQuizName = session.currentQuizName;
                    
                    document.getElementById('home-screen').classList.add('hidden');
                    document.getElementById('edit-screen').classList.add('hidden');
                    document.getElementById('result-screen').classList.add('hidden');
                    document.getElementById('quiz-screen').classList.remove('hidden');
                    document.getElementById('total-q-num').textContent = questions.length;
                    document.getElementById('current-quiz-title').textContent = currentQuizName;
                    
                    startTimer();
                    loadQuestion();
                    showToast("Đã khôi phục tiến độ làm bài!");
                    return;
                }
            }

            let qList = filterBlockedQuestions(selectedQuiz.questions);
            if (qList.length === 0) {
                showToast("Tất cả câu hỏi trong bộ đề này đều đã bị chặn hoặc bị ẩn!");
                return;
            }

            if (shuffle) {
                qList = shuffleArray(qList);
            }
            questions = qList;
            currentQuizName = selectedQuiz.name;
            
            clearActiveSession(selectedQuiz.id);
            initQuiz();
        }

        function restartCurrentQuiz() {
            if (confirm("Bạn có muốn làm lại từ đầu? Mọi tiến độ hiện tại sẽ được đặt lại.")) {
                if (currentQuizId) kv.removeItem(`quizAppActiveSession_${currentQuizId}`);
                if (currentQuizId === MOCK_SESSION_ID || currentQuizId === DEEP_SESSION_ID) {
                    timeElapsed = 0;
                    currentIndex = 0;
                    initQuiz();
                    showToast("Đã làm lại bài từ đầu!");
                    return;
                }
                const quizzes = getSavedQuizzes();
                const selectedQuiz = quizzes.find(q => q.id === currentQuizId);
                if (selectedQuiz) {
                    let qList = filterBlockedQuestions(selectedQuiz.questions);
                    questions = shuffleArray(qList);
                }
                initQuiz();
                showToast("Đã làm lại bài từ đầu!");
            }
        }

        function initQuiz() {
            currentIndex = 0;
            timeElapsed = 0;
            lightboxDrawingsMap = {};
            
            questions = questions.map(q => shuffleQuestionOptions(q));

            questionStates = questions.map(() => ({
                status: 'unanswered',
                isFlagged: false,
                customQuestionHtml: null,
                customOptionsHtml: null,
                selected: null
            }));
            
            document.getElementById('home-screen').classList.add('hidden');
            document.getElementById('edit-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            document.getElementById('total-q-num').textContent = questions.length;
            document.getElementById('current-quiz-title').textContent = currentQuizName;
            
            saveActiveSession();
            startTimer();
            loadQuestion();
        }

        function confirmBackToHome() {
            saveActiveSession();
            returnToHome();
        }

        function returnToHome() {
            clearInterval(timerInterval);
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('edit-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.add('hidden');
            document.getElementById('home-screen').classList.remove('hidden');
            renderSavedQuizzes();
        }

        function formatTime(seconds) {
            const m = Math.floor(seconds / 60).toString().padStart(2, '0');
            const s = (seconds % 60).toString().padStart(2, '0');
            return `${m}:${s}`;
        }

        function startTimer() {
            clearInterval(timerInterval);
            timerInterval = setInterval(() => {
                timeElapsed++;
                document.getElementById('timer').textContent = formatTime(timeElapsed);
                saveActiveSession();
            }, 1000);
        }

        function fitQuizPanels() {
            const panel = document.getElementById('question-panel-wrapper');
            const card = document.getElementById('quiz-screen');
            if (!panel || !card || card.classList.contains('hidden')) return;
            if (window.innerWidth < 1024) {
                document.documentElement.style.removeProperty('--quiz-panel-h');
                return;
            }
            const container = card.parentElement;
            const cs = getComputedStyle(card);
            const cc = getComputedStyle(container);
            const below = parseFloat(cs.paddingBottom) + parseFloat(cs.marginBottom) + parseFloat(cc.paddingBottom);
            const gap = 0;
            const top = panel.getBoundingClientRect().top;
            const h = window.innerHeight - top - below - gap;
            document.documentElement.style.setProperty('--quiz-panel-h', Math.max(220, Math.round(h)) + 'px');
        }
        window.addEventListener('resize', fitQuizPanels);
        window.addEventListener('orientationchange', fitQuizPanels);

        function loadQuestion() {
            const q = questions[currentIndex];
            requestAnimationFrame(fitQuizPanels);
            const st = questionStates[currentIndex];

            document.getElementById('current-q-num').textContent = currentIndex + 1;
            
            const progress = (currentIndex / questions.length) * 100;
            document.getElementById('progress-bar').style.width = `${progress}%`;

            const qTextEl = document.getElementById('question-text');
            if (st.customQuestionHtml) {
                qTextEl.innerHTML = st.customQuestionHtml;
            } else {
                qTextEl.innerHTML = mathFmt(getCleanQuestionText(q.question));
            }

            updateBookmarkButtonState();
            updateBlockButtonState();
            updateFlagButtonState();
            updateDifficultyButtonState();
            
            const imgContainer = document.getElementById('question-image-container');
            if (q.images && q.images.length > 0) {
                let imgsHtml = '<div class="flex flex-wrap justify-center gap-3">';
                q.images.forEach(imgSrc => {
                    imgsHtml += `<img src="${imgSrc}" onclick="openLightbox('${imgSrc}')" class="cursor-pointer hover:opacity-95 transition-opacity" style="max-height: 280px; max-width: 100%; border-radius: 8px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1); object-fit: contain;" />`;
                });
                imgsHtml += '</div>';
                imgContainer.innerHTML = imgsHtml;
                imgContainer.classList.remove('hidden');
            } else {
                imgContainer.innerHTML = "";
                imgContainer.classList.add('hidden');
            }

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';
            
            const feedbackBox = document.getElementById('feedback-box');
            const feedbackExpImgContainer = document.getElementById('feedback-explanation-images');
            const unansweredActions = document.getElementById('unanswered-actions');
            const answeredActions = document.getElementById('answered-actions');

            if (st.status === 'correct' || st.status === 'incorrect') {
                unansweredActions.classList.add('hidden');
                answeredActions.classList.remove('hidden');

                if (st.customOptionsHtml) {
                    optionsContainer.innerHTML = st.customOptionsHtml;
                    optionsContainer.querySelectorAll('button').forEach(btn => btn.disabled = true);
                } else {
                    q.options.forEach((optText) => {
                        const optLetter = optText.charAt(0).toUpperCase();
                        const btn = document.createElement('button');
                        let btnClass = 'option-btn w-full text-left p-4 border border-gray-300 rounded-xl bg-white opacity-70 cursor-not-allowed font-medium text-sm sm:text-base break-words';
                        if (optLetter === q.answerStr) {
                            btnClass = 'option-btn w-full text-left p-4 border rounded-xl correct font-medium text-sm sm:text-base break-words';
                        } else if (optLetter === st.selected && st.status === 'incorrect') {
                            btnClass = 'option-btn w-full text-left p-4 border rounded-xl incorrect font-medium text-sm sm:text-base break-words';
                        }
                        btn.className = btnClass;
                        btn.disabled = true;
                        btn.innerHTML = mathFmt(optText);
                        optionsContainer.appendChild(btn);
                    });
                }

                feedbackBox.classList.remove('hidden', 'bg-green-100', 'border-green-500', 'text-green-800', 'bg-red-100', 'border-red-500', 'text-red-800');
                if (st.status === 'correct') {
                    feedbackBox.classList.add('bg-green-100', 'border-green-500', 'text-green-800');
                    document.getElementById('feedback-title').textContent = "✅ Chính xác!";
                } else {
                    feedbackBox.classList.add('bg-red-100', 'border-red-500', 'text-red-800');
                    document.getElementById('feedback-title').textContent = "❌ Chưa chính xác!";
                }
                document.getElementById('feedback-correct-ans').textContent = `Đáp án đúng là: ${q.answerStr}`;
                
                const expEl = document.getElementById('feedback-explanation');
                if (q.explanation) {
                    expEl.innerHTML = `Giải thích: ${formatExplanationWithLinks(q.explanation)}`;
                    expEl.classList.remove('hidden');
                } else {
                    expEl.innerHTML = '';
                    expEl.classList.add('hidden');
                }

                if (q.explanationImages && q.explanationImages.length > 0) {
                    feedbackExpImgContainer.innerHTML = buildImageThumbsHtml(q.explanationImages, 140, 'hover:opacity-95 transition-opacity');
                    feedbackExpImgContainer.classList.remove('hidden');
                } else {
                    feedbackExpImgContainer.innerHTML = '';
                    feedbackExpImgContainer.classList.add('hidden');
                }

            } else {
                unansweredActions.classList.remove('hidden');
                answeredActions.classList.add('hidden');
                feedbackBox.classList.add('hidden');

                if (st.customOptionsHtml) {
                    optionsContainer.innerHTML = st.customOptionsHtml;
                    const optBtns = optionsContainer.querySelectorAll('button');
                    optBtns.forEach((btn, optIdx) => {
                        const optText = q.options[optIdx];
                        if (optText) {
                            const optLetter = optText.charAt(0).toUpperCase();
                            btn.onclick = () => selectOption(btn, optLetter, q.answerStr, q.explanation, q.explanationImages);
                        }
                    });
                } else {
                    q.options.forEach((optText) => {
                        const optLetter = optText.charAt(0).toUpperCase();
                        const btn = document.createElement('button');
                        btn.className = 'option-btn w-full text-left p-4 border border-gray-300 rounded-xl bg-white hover:bg-gray-50 text-gray-700 font-medium text-sm sm:text-base break-words';
                        btn.innerHTML = mathFmt(optText);
                        btn.onclick = () => selectOption(btn, optLetter, q.answerStr, q.explanation, q.explanationImages);
                        optionsContainer.appendChild(btn);
                    });
                }
            }
            saveActiveSession();
        }

        function skipQuestion() {
            questionStates[currentIndex].status = 'skipped';
            questionStates[currentIndex].selected = 'Đã bỏ qua';

            currentIndex++;
            if (currentIndex < questions.length) {
                loadQuestion();
            } else {
                showResult();
            }
        }

        function prevQuestion() {
            if (currentIndex > 0) {
                currentIndex--;
                loadQuestion();
            } else {
                showToast("Đây là câu hỏi đầu tiên!");
            }
        }

        function selectOption(selectedBtn, selectedLetter, correctLetter, explanation, explanationImages) {
            document.getElementById('unanswered-actions').classList.add('hidden');
            document.getElementById('answered-actions').classList.remove('hidden');

            const buttons = document.querySelectorAll('.option-btn');
            buttons.forEach(btn => {
                btn.disabled = true;
                btn.classList.add('opacity-70', 'cursor-not-allowed');
                const btnLetter = btn.textContent.charAt(0).toUpperCase();
                if (btnLetter === correctLetter) {
                    btn.classList.remove('opacity-70');
                    btn.classList.add('correct');
                }
            });

            const isCorrect = (selectedLetter === correctLetter);
            if (!isCorrect) {
                selectedBtn.classList.remove('opacity-70');
                selectedBtn.classList.add('incorrect');
            }

            questionStates[currentIndex].status = isCorrect ? 'correct' : 'incorrect';
            questionStates[currentIndex].selected = selectedLetter;

            const feedbackBox = document.getElementById('feedback-box');
            const feedbackExpImgContainer = document.getElementById('feedback-explanation-images');
            feedbackBox.classList.remove('hidden', 'bg-green-100', 'border-green-500', 'text-green-800', 'bg-red-100', 'border-red-500', 'text-red-800');
            
            if (isCorrect) {
                feedbackBox.classList.add('bg-green-100', 'border-green-500', 'text-green-800');
                document.getElementById('feedback-title').textContent = "✅ Chính xác!";
            } else {
                feedbackBox.classList.add('bg-red-100', 'border-red-500', 'text-red-800');
                document.getElementById('feedback-title').textContent = "❌ Chưa chính xác!";
            }
            
            document.getElementById('feedback-correct-ans').textContent = `Đáp án đúng là: ${correctLetter}`;
            
            const expEl = document.getElementById('feedback-explanation');
            if (explanation) {
                expEl.innerHTML = `Giải thích: ${formatExplanationWithLinks(explanation)}`;
                expEl.classList.remove('hidden');
            } else {
                expEl.innerHTML = '';
                expEl.classList.add('hidden');
            }

            if (explanationImages && explanationImages.length > 0) {
                feedbackExpImgContainer.innerHTML = buildImageThumbsHtml(explanationImages, 140, 'hover:opacity-95 transition-opacity');
                feedbackExpImgContainer.classList.remove('hidden');
            } else {
                feedbackExpImgContainer.innerHTML = '';
                feedbackExpImgContainer.classList.add('hidden');
            }
            saveActiveSession();
        }

        function nextQuestion() {
            currentIndex++;
            if (currentIndex < questions.length) {
                loadQuestion();
            } else {
                showResult();
            }
        }

        function showResult() {
            clearInterval(timerInterval);
            clearActiveSession();
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');
            
            let finalScore = 0;
            questionStates.forEach(st => {
                if (st.status === 'correct') finalScore++;
            });

            saveQuizResult(finalScore, questions.length);

            document.getElementById('final-time').textContent = formatTime(timeElapsed);
            document.getElementById('score-display').textContent = `${finalScore}/${questions.length}`;

            const reviewContainer = document.getElementById('review-container');
            reviewContainer.innerHTML = '';
            
            questions.forEach((q, idx) => {
                const st = questionStates[idx];
                const isCorrect = st.status === 'correct';
                const item = document.createElement('div');
                item.className = `p-4 rounded-xl border text-sm ${isCorrect ? 'bg-green-50 border-green-200' : 'bg-red-50 border-red-200'}`;
                
                let expImgsHtml = '';
                if (q.explanationImages && q.explanationImages.length > 0) {
                    expImgsHtml = '<div class="flex flex-wrap gap-2 mt-2">' + buildImageThumbsHtml(q.explanationImages, 90, 'hover:opacity-95 transition-opacity') + '</div>';
                }

                let hlText = (st.customQuestionHtml || st.customOptionsHtml) ? ' | 🖍️ Đã Highlight' : '';

                item.innerHTML = `
                    <p class="font-bold text-gray-800 mb-1.5 text-justify">${mathFmt(getCleanQuestionText(q.question))}</p>
                    <p class="${isCorrect ? 'text-green-700' : 'text-red-700'} mb-1">
                        Bạn chọn: <b>${st.selected || 'Chưa trả lời'}</b> 
                        ${!isCorrect ? `| Đáp án đúng: <b>${q.answerStr}</b>` : ''}
                        ${st.isFlagged ? ' | 🚩 Đã đánh cờ' : ''}
                        ${hlText}
                    </p>
                    ${q.explanation ? `<p class="text-xs text-gray-600 italic mt-1 text-justify">Giải thích: ${formatExplanationWithLinks(q.explanation)}</p>` : ''}
                    ${expImgsHtml}
                `;
                reviewContainer.appendChild(item);
            });
        }
    </script>
</body>
</html>
